---
/**
 * Light/dark theme toggle.
 *
 * The no-flash init script that sets `data-theme` before first paint lives in
 * Layout's <head>. This component is only the button + the click handler
 * that flips and persists the choice. Defaults to the `np:theme` key.
 */
interface Props {
  /** localStorage key for the persisted choice. */
  storageKey?: string;
  label?: string;
}
const { storageKey = "np:theme", label = "Bytt tema" } = Astro.props;

import Icon from "./Icon.astro";
---

<button
  type="button"
  class="theme-toggle np-icon-btn np-press"
  data-storage-key={storageKey}
  aria-label={label}
  aria-pressed="false"
  title={label}
>
  <Icon name="sun" size={19} class="icon icon-sun" />
  <Icon name="moon" size={19} class="icon icon-moon" />
</button>

<style>
  /* Box + neutral hover come from the shared .np-icon-btn primitive; the toggle
     only stacks the two glyphs in one grid cell. */
  .theme-toggle {
    display: grid;
  }
  /* The glyphs render from the <Icon> child, so their classes are outside this
     component's style scope — reach them with :global(). Both stack in one grid
     cell; show the icon for the theme you'd switch TO. */
  .theme-toggle :global(.icon) {
    grid-area: 1 / 1;
  }
  .theme-toggle :global(.icon-moon) {
    display: none;
  }
  :global(html:not([data-theme="dark"])) .theme-toggle :global(.icon-sun) {
    display: none;
  }
  :global(html:not([data-theme="dark"])) .theme-toggle :global(.icon-moon) {
    display: block;
  }
</style>

<script>
  import { onPage } from "../lib/pageLifecycle.ts";
  // Vanilla island: flip data-theme on <html> and persist the choice. The topbar
  // is re-rendered on each view-transition swap, so re-bind per page-load.
  onPage((signal) => {
    const toggles = [
      ...document.querySelectorAll<HTMLButtonElement>(".theme-toggle"),
    ];
    const root = document.documentElement;

    // Reflect the current theme on load, after every view-transition restore,
    // and on a live OS-theme flip — Layout's no-flash script owns the apply for
    // all three, so this only mirrors it onto the button's a11y state.
    const syncPressed = () => {
      const dark = root.getAttribute("data-theme") === "dark";
      toggles.forEach((btn) => btn.setAttribute("aria-pressed", String(dark)));
    };
    syncPressed();
    document.addEventListener("np:themechange", syncPressed, { signal });

    // Pending .theme-snap removal (a double-rAF handle). Shared across every
    // toggle so a rapid double-toggle re-arms one timer instead of stacking.
    let snapRaf = 0;

    toggles.forEach((btn) => {
      const key = btn.dataset.storageKey;
      btn.addEventListener(
        "click",
        () => {
          // The flip is deliberately INSTANT — no view transition, no eased
          // colours. Both animated forms were tried and reverted: a universal
          // per-element `transition: color` compounds one full ease per
          // inheritance hop in WebKit, and a same-document view transition
          // cannot present smoothly there either, because WebKit gates the
          // snapshot fade on the main thread that the flip's own full-tree
          // recalc is saturating.
          //
          // The swap carries no transition, but the resting controls DO hold
          // standing colour/background eases for their hover feel, so they
          // would ease alone ~120ms behind the already-snapped page. Suppress
          // them for exactly one frame: `.theme-snap` on <html> (a base.css
          // rule zeroes every transition while present) around the
          // setAttribute, dropped after the flip has painted (double rAF).
          // Cancel and re-arm the pending removal on a rapid double-toggle
          // rather than stacking timers.
          if (snapRaf) cancelAnimationFrame(snapRaf);
          root.classList.add("theme-snap");
          const next =
            root.getAttribute("data-theme") === "dark" ? "light" : "dark";
          root.setAttribute("data-theme", next);
          snapRaf = requestAnimationFrame(() => {
            snapRaf = requestAnimationFrame(() => {
              root.classList.remove("theme-snap");
              snapRaf = 0;
            });
          });
          try {
            if (key) localStorage.setItem(key, next);
          } catch {
            /* private mode / storage disabled — fall through, no persistence */
          }
          // Let any other listeners (including this component's own
          // syncPressed above) repaint with the new theme's CSS custom
          // properties, which already hold their final values.
          document.dispatchEvent(
            new CustomEvent("np:themechange", { detail: next }),
          );
        },
        { signal },
      );
    });
  });
</script>
