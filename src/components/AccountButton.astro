---
/**
 * The account's door, in the topbar, on every page.
 *
 * It reads the account NAME when there is a session and "Profil" when there is
 * not — the one thing a topbar can say about an account without saying
 * anything about a plan. Everything behind it (programme, kull, studieretning,
 * sign-in, devices, PIN) lives in the profile panel `account.ts` mounts.
 *
 * The label is written by client JS, because a session is client-only state
 * and this file is server-rendered once per build. It ships "Profil" as its
 * server text — the signed-out state, which every cold arrival is in — and a
 * PRE-PAINT inline script right under the button corrects it for a session
 * that already exists. Same instrument and the same reason as Layout's
 * no-flash theme init and the plan probe: something only localStorage knows,
 * needed before the first frame. Without it a signed-in student watched
 * "Profil" turn into their own name on every single page load, and the two
 * nav links beside it slid left as the button grew. `mountAccount` keeps the
 * label true for the rest of the visit, including across swaps.
 *
 * A bare control, not a paper button: it sits between two nav links and an
 * icon button, and a filled control there would be the loudest thing in the
 * bar — a door, not an action on the page. The mark disambiguates it from the
 * nav beside it, which matters once the label is a person's name rather than
 * a noun.
 *
 * **Below the site's mobile breakpoint it is the mark and nothing else**
 * (site.css, 480px). The name is not dropped, it MOVES: `aria-label` carries
 * "Profil · {navn}" at every width, written by the pre-paint script below and
 * kept true by `renderName` in `account.ts`, so the constraint costs a sighted
 * phone user a truncated word and costs a screen reader nothing. The mark stays
 * `user` at every width — the room behind this door is programme, kull,
 * studieretning and the session, which is who you are and not what the page is
 * set to; a cog would claim settings, and `settings-2` is already spoken for by
 * the plan's own control (DESIGN §9).
 */
import { SYNC_STORAGE_KEY } from "../lib/planner/syncClient.js";
import Icon from "./Icon.astro";

interface Props {
  /** `data/semesters.json`'s current id — the store's fallback semester. */
  defaultSemesterId: string;
}
const { defaultSemesterId } = Astro.props;

/** Imported rather than retyped, so the pre-paint read cannot drift from the
 *  key `syncClient.ts` writes. */
const SYNC_KEY = SYNC_STORAGE_KEY;
---

<button
  type="button"
  class="np-navlink site-account"
  id="site-account-btn"
  data-default-semester={defaultSemesterId}
  aria-haspopup="dialog"
  aria-label="Profil"
>
  <Icon name="user" size={16} class="site-account-mark" />
  <span class="site-account-name" id="site-account-name">Profil</span>
</button>
<script is:inline define:vars={{ SYNC_KEY }}>
  // Runs during parse, with the button one node above it and nothing painted
  // yet. Deliberately forgiving: every failure path leaves the server's
  // "Profil", which is the honest answer when we cannot tell.
  (function () {
    try {
      var raw = localStorage.getItem(SYNC_KEY);
      if (!raw) return;
      var navn = JSON.parse(raw).navn;
      if (typeof navn !== "string" || navn === "") return;
      var el = document.getElementById("site-account-name");
      if (el) el.textContent = navn;
      var btn = document.getElementById("site-account-btn");
      if (btn) btn.setAttribute("aria-label", "Profil for " + navn);
    } catch (e) {
      /* storage denied, or a session we cannot parse — stay on "Profil" */
    }
  })();
</script>

<script>
  import { mountAccount } from "./account.ts";
  import { onPage } from "../lib/pageLifecycle.ts";

  // Per page-load, never once per module: under ClientRouter this module is
  // evaluated the first time it is fetched and never again, so a top-level
  // mount would leave the button dead — and the panel's <dialog> orphaned —
  // after any in-site navigation.
  onPage((signal) => {
    const btn = document.getElementById("site-account-btn");
    if (!btn) return;
    mountAccount(signal, btn.dataset.defaultSemester ?? "");
  });
</script>
