---
/**
 * The Uke/Liste pair, for every surface that draws a week.
 *
 * SERVER-RENDERED, not built by `weekView.ts`. The tabs belong to the static
 * shell: building them in JS would pop a control into three pages a frame late,
 * on top of a frame that is already reserving its own height. `mountWeekView`
 * binds these two buttons rather than creating them.
 *
 * "Uke" is the timetable shape a student already knows from every other
 * calendar: days as columns, time down. The ids keep saying `kolonner` and
 * `tavle` because those are the values in localStorage and the names of the
 * modules that draw them.
 *
 * On `/planlegger/` this is THE ONE CONTROL THAT DOES NOT FOLD into the phone
 * menu. It is what a student throws while reading the week, so putting it a tap
 * deep would charge the most frequent gesture on the page for the benefit of
 * the least frequent.
 */
interface Props {
  /** Namespaces the two ids, so three surfaces can carry the pair at once. */
  idPrefix: string;
}
const { idPrefix } = Astro.props;
---

<div class="planner-view-tabs" role="group" aria-label="Velg hvordan uka vises">
  <span class="planner-view-thumb" aria-hidden="true"></span>
  <button
    type="button"
    class="planner-view-tab"
    id={`${idPrefix}-view-kolonner`}
    aria-pressed="true"
  >
    Uke
  </button>
  <button type="button" class="planner-view-tab" id={`${idPrefix}-view-tavle`} aria-pressed="false">
    Liste
  </button>
</div>
