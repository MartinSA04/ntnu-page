---
import { ClientRouter } from "astro:transitions";
import semestersData from "../../data/semesters.json";
import ThemeToggle from "../components/ThemeToggle.astro";
import { ACCENT, faviconDataUri } from "../lib/favicon.ts";
import groteskLatin from "../styles/fonts/schibsted-grotesk-latin.woff2?url";
import monoLatin from "../styles/fonts/spline-sans-mono-latin.woff2?url";
import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/primitives.css";
import "../styles/site.css";

/**
 * Site shell: sticky topbar (wordmark + nav + a persistent studieinfo chip
 * naming whose plan this is + theme toggle), a count-link back to the week
 * (non-empty plans only, on every page but the two that already show the
 * plan), a centered content column (reading measure by default, the
 * `--maxw` data column when `wide`), and a footer that carries the demoted
 * catalog link plus provenance. Ruteark's accent lives in tokens.css — no
 * inline accent vars here (see docs/SPEC.md "Design-system usage").
 */
interface Props {
  title: string;
  description: string;
  wide?: boolean;
}
const { title, description, wide = false } = Astro.props;

const THEME_KEY = "np:theme";

// Two destinations now (rework Task 11): the plan and the catalog search
// behind it. Kept as a list of sections (not a bare href prefix) so a future
// addition can't reintroduce the aria-current substring bug (`/emne/` is not
// a prefix of `/emner/`, which orphaned the highest-traffic page from its
// own nav).
const NAV = [
  { href: "/planlegger/", label: "Planlegger", sections: ["/planlegger/"] },
  { href: "/emner/", label: "Emner", sections: ["/emner/", "/emne/"] },
] as const;

const path = Astro.url.pathname;

function isCurrentSection(sections: readonly string[]): boolean {
  return sections.some((prefix) => path === prefix || path.startsWith(prefix));
}

const MONTH_ABBR = [
  "jan",
  "feb",
  "mar",
  "apr",
  "mai",
  "jun",
  "jul",
  "aug",
  "sep",
  "okt",
  "nov",
  "des",
];

/** `"2026-07-24T…"` → `"24. jul 2026"` (DR-8 provenance line, footer). */
function formatCrawlDate(iso: string): string {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return iso;
  const month = MONTH_ABBR[d.getUTCMonth()] ?? "";
  return `${d.getUTCDate()}. ${month} ${d.getUTCFullYear()}`;
}

const crawlDate = formatCrawlDate(semestersData.crawledAt);
---

<!doctype html>
<html lang="nb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={groteskLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoLatin} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={faviconDataUri(ACCENT)} />
    <script is:inline define:vars={{ THEME_KEY }}>
      // No-flash theme init — reads the stored choice, falls back to the OS
      // preference, and sets data-theme on <html> before first paint.
      (function () {
        function isDark() {
          try {
            const saved = localStorage.getItem(THEME_KEY);
            return saved
              ? saved === "dark"
              : matchMedia("(prefers-color-scheme: dark)").matches;
          } catch (e) {
            return false;
          }
        }
        function applyTheme() {
          if (isDark())
            document.documentElement.setAttribute("data-theme", "dark");
          else document.documentElement.removeAttribute("data-theme");
        }
        applyTheme();
        // ClientRouter's swapRootAttributes() removes EVERY attribute from
        // <html> and restores only the ones the server rendered — and
        // data-theme is set here on the client, so it is wiped on every
        // navigation and the page snaps back to light. This script does not
        // re-execute on a swap (head elements are re-appended, not re-run),
        // so re-apply from a listener on `document`, which survives swaps.
        // astro:after-swap fires before the new page paints: no flash.
        document.addEventListener("astro:after-swap", applyTheme);
        matchMedia("(prefers-color-scheme: dark)").addEventListener(
          "change",
          function () {
            try {
              if (localStorage.getItem(THEME_KEY)) return;
            } catch (e) {
              /* storage disabled — OS still wins */
            }
            applyTheme();
            document.dispatchEvent(
              new CustomEvent("np:themechange", {
                detail:
                  document.documentElement.getAttribute("data-theme") === "dark"
                    ? "dark"
                    : "light",
              }),
            );
          },
        );
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Hopp til innhold</a>
    <div class="site">
      <header class="site-topbar">
        <a class="site-brand" href="/">
          Semesterplan<span class="site-brand-suffix">NTNU</span>
        </a>
        <nav class="site-nav" aria-label="Hovednavigasjon">
          {
            NAV.map((item) => (
              <a
                class="np-navlink"
                href={item.href}
                aria-current={isCurrentSection(item.sections) ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <a
          class="np-btn studieinfo-chip"
          id="studieinfo-chip"
          href="/planlegger/?studieinfo"
        >
          Velg studieprogram
        </a>
        <ThemeToggle storageKey={THEME_KEY} />
      </header>
      <main id="main-content" class:list={["site-content", { wide }]}>
        <slot />
      </main>
      <footer class="site-footer">
        <a href="/emner/">Søk i emner</a>
        <span class="site-footer-sep">·</span>
        {`Data hentet ${crawlDate} fra NTNU`}
        <span class="site-footer-sep">·</span>
        uoffisiell
      </footer>
    </div>
    <script>
      // Leaf module, deliberately: importing the constant from studieinfo.ts
      // pulled the whole 11.9 KB dialog into every page's bundle (perf-4).
      import { OPEN_STUDIEINFO_EVENT } from "../components/planner/studieinfoEvent.ts";
      import { onPage } from "../lib/pageLifecycle.ts";
      import { semesterYear } from "../lib/planner/schedule.ts";
      import { createPlanStore } from "../lib/planner/store.ts";

      /** `"26h"` → `"Høst 2026"` (rework Task 11's Facts). `null` for a malformed id. */
      function semesterLabel(semesterId: string): string | null {
        const year = semesterYear(semesterId);
        if (year === null) return null;
        return /h$/i.test(semesterId.trim()) ? `Høst ${year}` : `Vår ${year}`;
      }

      /**
       * The persistent studieinfo chip — "who is this plan for", and the one
       * control that changes it. It renders once here, subscribes to the
       * store's change event, and every page gets it for free.
       *
       * It used to have a companion: a "N emner · X sp → ukeplanen" bar under
       * the topbar on every page but `/` and `/planlegger/`. It is gone. The
       * chip beside it already names the plan and already links to the week,
       * and `/emner/` and `/emne/[code]/` each carry their own "se ukeplanen →"
       * next to the course they just added — so the bar was a third route to
       * the same place, spending a full-width rule and a border on it.
       */
      onPage((signal) => {
        const chip = document.getElementById("studieinfo-chip") as HTMLAnchorElement | null;
        if (!chip) return;

        // On the planner itself the chip opens the same studieinfo dialog
        // `mountStudieinfo` already wires there — no navigation needed, so
        // the click is intercepted instead of following the href.
        if (location.pathname.startsWith("/planlegger/")) {
          chip.addEventListener(
            "click",
            (event) => {
              event.preventDefault();
              window.dispatchEvent(new CustomEvent(OPEN_STUDIEINFO_EVENT));
            },
            { signal },
          );
        }

        const store = createPlanStore("");

        // site.css caps the chip at 9rem below this width (the shared phone
        // breakpoint), and the three-fact label does not fit: it ellipsised
        // mid-fact to "MTDT · 2026 · H…", spending the tail on a semester the
        // planner's own context line already carries. The programme identity
        // is the fact only the chip states, so at phone width it gets the
        // whole box (mob-1).
        const narrow = matchMedia("(max-width: 480px)");

        function render(): void {
          const plan = store.loadPlan();
          if (!chip) return;
          const program = plan.program;
          // DESIGN §3 Data-Is-Mono: filled, the chip is data fragments joined
          // by middots with no verb — the same facts /planlegger/ sets in mono
          // ~110px below it. Empty, it is a verb phrase and stays grotesk
          // (ds-6).
          chip.classList.toggle("np-data", Boolean(program));
          if (!program) {
            chip.textContent = "Velg studieprogram";
            return;
          }
          const semester = semesterLabel(plan.semesterId) ?? plan.semesterId;
          chip.textContent = narrow.matches
            ? `${program.code} · ${program.cohort}`
            : `${program.code} · ${program.cohort} · ${semester}`;
        }

        render();
        const unsubscribe = store.onPlanChange(render);
        narrow.addEventListener("change", render, { signal });
        signal.addEventListener("abort", unsubscribe);
      });
    </script>
  </body>
</html>
