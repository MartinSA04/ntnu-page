---
import { ClientRouter } from "astro:transitions";
import semestersData from "../../data/semesters.json";
import ThemeToggle from "../components/ThemeToggle.astro";
import { ACCENT, faviconDataUri } from "../lib/favicon.ts";
import groteskLatin from "../styles/fonts/schibsted-grotesk-latin.woff2?url";
import monoLatin from "../styles/fonts/spline-sans-mono-latin.woff2?url";
import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/primitives.css";
import "../styles/site.css";

/**
 * Site shell: sticky topbar (wordmark + nav + a persistent studieinfo chip
 * naming whose plan this is + theme toggle), a count-link back to the week
 * (non-empty plans only, on every page but the two that already show the
 * plan), a centered content column (reading measure by default, the
 * `--maxw` data column when `wide`), and a footer that carries the demoted
 * catalog link plus provenance. Ruteark's accent lives in tokens.css — no
 * inline accent vars here (see docs/SPEC.md "Design-system usage").
 */
interface Props {
  title: string;
  description: string;
  wide?: boolean;
}
const { title, description, wide = false } = Astro.props;

const THEME_KEY = "np:theme";

// Two destinations now (rework Task 11): the plan and the catalog search
// behind it. Kept as a list of sections (not a bare href prefix) so a future
// addition can't reintroduce the aria-current substring bug (`/emne/` is not
// a prefix of `/emner/`, which orphaned the highest-traffic page from its
// own nav).
const NAV = [
  { href: "/planlegger/", label: "Planlegger", sections: ["/planlegger/"] },
  { href: "/emner/", label: "Emner", sections: ["/emner/", "/emne/"] },
] as const;

const path = Astro.url.pathname;

function isCurrentSection(sections: readonly string[]): boolean {
  return sections.some((prefix) => path === prefix || path.startsWith(prefix));
}

const MONTH_ABBR = [
  "jan",
  "feb",
  "mar",
  "apr",
  "mai",
  "jun",
  "jul",
  "aug",
  "sep",
  "okt",
  "nov",
  "des",
];

/** `"2026-07-24T…"` → `"24. jul 2026"` (DR-8 provenance line, footer). */
function formatCrawlDate(iso: string): string {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return iso;
  const month = MONTH_ABBR[d.getUTCMonth()] ?? "";
  return `${d.getUTCDate()}. ${month} ${d.getUTCFullYear()}`;
}

const crawlDate = formatCrawlDate(semestersData.crawledAt);
---

<!doctype html>
<html lang="nb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={groteskLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoLatin} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={faviconDataUri(ACCENT)} />
    <script is:inline define:vars={{ THEME_KEY }}>
      // No-flash theme init — reads the stored choice, falls back to the OS
      // preference, and sets data-theme on <html> before first paint.
      (function () {
        function isDark() {
          try {
            const saved = localStorage.getItem(THEME_KEY);
            return saved
              ? saved === "dark"
              : matchMedia("(prefers-color-scheme: dark)").matches;
          } catch (e) {
            return false;
          }
        }
        function applyTheme() {
          if (isDark())
            document.documentElement.setAttribute("data-theme", "dark");
          else document.documentElement.removeAttribute("data-theme");
        }
        applyTheme();
        // ClientRouter's swapRootAttributes() removes EVERY attribute from
        // <html> and restores only the ones the server rendered — and
        // data-theme is set here on the client, so it is wiped on every
        // navigation and the page snaps back to light. This script does not
        // re-execute on a swap (head elements are re-appended, not re-run),
        // so re-apply from a listener on `document`, which survives swaps.
        // astro:after-swap fires before the new page paints: no flash.
        document.addEventListener("astro:after-swap", applyTheme);
        matchMedia("(prefers-color-scheme: dark)").addEventListener(
          "change",
          function () {
            try {
              if (localStorage.getItem(THEME_KEY)) return;
            } catch (e) {
              /* storage disabled — OS still wins */
            }
            applyTheme();
            document.dispatchEvent(
              new CustomEvent("np:themechange", {
                detail:
                  document.documentElement.getAttribute("data-theme") === "dark"
                    ? "dark"
                    : "light",
              }),
            );
          },
        );
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Hopp til innhold</a>
    <div class="site">
      <header class="site-topbar">
        <a class="site-brand" href="/">
          Semesterplan<span class="site-brand-suffix">NTNU</span>
        </a>
        <nav class="site-nav" aria-label="Hovednavigasjon">
          {
            NAV.map((item) => (
              <a
                class="np-navlink"
                href={item.href}
                aria-current={isCurrentSection(item.sections) ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <a
          class="np-btn studieinfo-chip"
          id="studieinfo-chip"
          href="/planlegger/?studieinfo"
        >
          Velg studieprogram
        </a>
        <ThemeToggle storageKey={THEME_KEY} />
      </header>
      <a class="np-hint" id="plan-count-link" href="/planlegger/" hidden></a>
      <main id="main-content" class:list={["site-content", { wide }]}>
        <slot />
      </main>
      <footer class="site-footer">
        <a href="/emner/">Søk i emner</a>
        <span class="site-footer-sep">·</span>
        {`Data hentet ${crawlDate} fra NTNU`}
        <span class="site-footer-sep">·</span>
        uoffisiell
      </footer>
    </div>
    <script>
      import { OPEN_STUDIEINFO_EVENT } from "../components/planner/studieinfo.ts";
      import { onPage } from "../lib/pageLifecycle.ts";
      import { activeCourses, createPlanStore } from "../lib/planner/store.ts";

      /** `"26h"` → `"Høst 2026"` (rework Task 11's Facts). `null` for a malformed id. */
      function semesterLabel(semesterId: string): string | null {
        const m = /^(\d{2})([hv])$/i.exec(semesterId.trim());
        if (!m) return null;
        const year = 2000 + Number(m[1]);
        return m[2]?.toLowerCase() === "h" ? `Høst ${year}` : `Vår ${year}`;
      }

      /**
       * The persistent studieinfo chip (always visible — "who is this plan
       * for") and, on every OTHER page with a real plan, the count-link back
       * to the week (I2). Three surfaces write to the plan (course page,
       * catalog search, the planner itself) and none of them led back to it,
       * which is exactly what this sitewide chrome fixes: it renders once
       * here, subscribes to the store's change event, and every page gets it
       * for free.
       */
      onPage((signal) => {
        const chip = document.getElementById("studieinfo-chip") as HTMLAnchorElement | null;
        const countLink = document.getElementById("plan-count-link") as HTMLAnchorElement | null;
        if (!chip && !countLink) return;

        const path = location.pathname;
        const onPlanner = path.startsWith("/planlegger/");

        // On the planner itself the chip opens the same studieinfo dialog
        // `mountStudieinfo` already wires there — no navigation needed, so
        // the click is intercepted instead of following the href.
        if (chip && onPlanner) {
          chip.addEventListener(
            "click",
            (event) => {
              event.preventDefault();
              window.dispatchEvent(new CustomEvent(OPEN_STUDIEINFO_EVENT));
            },
            { signal },
          );
        }

        // The homepage has its own resume line for the same plan (I2's
        // original affordance); showing the count-link there too would be
        // the same sentence twice one scroll apart.
        const countLinkEligible = countLink && !onPlanner && path !== "/";

        const store = createPlanStore("");

        function render(): void {
          const plan = store.loadPlan();

          if (chip) {
            chip.textContent = plan.program
              ? `${plan.program.code} · ${plan.program.cohort} · ${semesterLabel(plan.semesterId) ?? plan.semesterId}`
              : "Velg studieprogram";
          }

          if (!countLinkEligible || !countLink) return;
          const active = activeCourses(plan);
          if (active.length === 0) {
            countLink.hidden = true;
            return;
          }

          // Stored credits only (B9.1's study-plan fallback) — no bundle
          // fetch here, unlike the strip this replaces: the count-link is a
          // glance, not a place the live-fetched total needs to be exact.
          let credits = 0;
          let unknown = 0;
          for (const course of active) {
            if (typeof course.credits === "number") credits += course.credits;
            else unknown++;
          }
          const rounded = Math.round(credits * 10) / 10;
          const creditsText = Number.isInteger(rounded)
            ? `${rounded}`
            : rounded.toFixed(1).replace(".", ",");

          countLink.replaceChildren();
          const countEl = document.createElement("span");
          countEl.className = "np-data";
          countEl.textContent = `${active.length} ${active.length === 1 ? "emne" : "emner"}`;
          countLink.append(countEl);
          countLink.append(document.createTextNode(" · "));
          const creditsEl = document.createElement("span");
          creditsEl.className = "np-data";
          creditsEl.textContent = `${creditsText} sp`;
          countLink.append(creditsEl);
          if (unknown > 0) {
            countLink.append(document.createTextNode(` + ${unknown} uten oppgitt sp`));
          }
          countLink.append(document.createTextNode(" → ukeplanen"));
          countLink.hidden = false;
        }

        render();
        const unsubscribe = store.onPlanChange(render);
        signal.addEventListener("abort", unsubscribe);
      });
    </script>
  </body>
</html>
