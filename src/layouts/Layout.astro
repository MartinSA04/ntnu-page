---
import { ClientRouter } from "astro:transitions";
import ThemeToggle from "../components/ThemeToggle.astro";
import { ACCENT, faviconDataUri } from "../lib/favicon.ts";
import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/primitives.css";
import "../styles/site.css";

/**
 * Site shell: sticky topbar (wordmark + nav + theme toggle), a centered
 * content column (reading measure by default, the `--maxw` data column when
 * `wide`), and a quiet mono footer. Ruteark's accent lives in tokens.css —
 * no inline accent vars here (see docs/SPEC.md "Design-system usage").
 */
interface Props {
  title: string;
  description: string;
  wide?: boolean;
}
const { title, description, wide = false } = Astro.props;

const THEME_KEY = "np:theme";

const NAV = [
  { href: "/planlegger/", label: "Planlegger" },
  { href: "/emner/", label: "Emner" },
  { href: "/studier/", label: "Studier" },
] as const;

const path = Astro.url.pathname;
---

<!doctype html>
<html lang="nb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={faviconDataUri(ACCENT)} />
    <script is:inline define:vars={{ THEME_KEY }}>
      // No-flash theme init — reads the stored choice, falls back to the OS
      // preference, and sets data-theme on <html> before first paint.
      (function () {
        function isDark() {
          try {
            const saved = localStorage.getItem(THEME_KEY);
            return saved
              ? saved === "dark"
              : matchMedia("(prefers-color-scheme: dark)").matches;
          } catch (e) {
            return false;
          }
        }
        function applyTheme() {
          if (isDark())
            document.documentElement.setAttribute("data-theme", "dark");
          else document.documentElement.removeAttribute("data-theme");
        }
        applyTheme();
        matchMedia("(prefers-color-scheme: dark)").addEventListener(
          "change",
          function () {
            try {
              if (localStorage.getItem(THEME_KEY)) return;
            } catch (e) {
              /* storage disabled — OS still wins */
            }
            applyTheme();
            document.dispatchEvent(
              new CustomEvent("np:themechange", {
                detail:
                  document.documentElement.getAttribute("data-theme") === "dark"
                    ? "dark"
                    : "light",
              }),
            );
          },
        );
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <div class="site">
      <header class="site-topbar">
        <a class="site-brand" href="/">
          Semesterplan<span class="site-brand-suffix">NTNU</span>
        </a>
        <nav class="site-nav" aria-label="Hovednavigasjon">
          {
            NAV.map((item) => (
              <a
                class="np-navlink"
                href={item.href}
                aria-current={path.startsWith(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <ThemeToggle storageKey={THEME_KEY} />
      </header>
      <main class:list={["site-content", { wide }]}>
        <slot />
      </main>
      <footer class="site-footer">
        Uoffisiell side · data fra NTNU og HK-dir (DBH)
      </footer>
    </div>
  </body>
</html>
