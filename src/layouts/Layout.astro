---
import { ClientRouter } from "astro:transitions";
import semestersData from "../../data/semesters.json";
import AccountButton from "../components/AccountButton.astro";
import Icon from "../components/Icon.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { faviconDataUri, VERDICT } from "../lib/favicon.ts";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/primitives.css";
import "../styles/site.css";

/**
 * Site shell: sticky topbar (wordmark, nav, theme toggle), a centered content
 * column (reading measure by default, the `--maxw` data column when `wide`),
 * and a footer carrying provenance. All colour lives in tokens.css: no inline
 * colour vars here.
 *
 * THE TOPBAR CARRIES NO PLAN STATE — still true, and the three attempts that
 * broke it (a plan strip, a plan-count link, a studieinfo chip) stay dead. It
 * does carry the ACCOUNT, which is a different thing: `<AccountButton>` prints
 * the account's own name when there is a session and "Profil" when there is
 * not. No semester, no course count, no programme code.
 *
 * The rule that used to stand here — "no way into the studieinfo modal; the
 * planner's own button is the single entrance" — was written when programme +
 * kull were the only thing behind that door and the planner was the only page
 * that cared. Neither holds now. The account governs `np:profile`, `np:plans`
 * and `np:lastSemester`, which `/`, `/emner/` and `/emne/[code]/` all read;
 * and `/emne/[code]/` is the largest cold-traffic surface on the site, so a
 * student arriving there from a search engine must be able to sign in — and to
 * say which programme they are on — without navigating away first. A door that
 * exists on exactly one of four pages is not a settings surface (mandate 8).
 *
 * What stays with the planner is what belongs to a PLAN rather than to a
 * person: the semester select, and the plan's own name in the planner's title.
 */
interface Props {
  title: string;
  description: string;
  wide?: boolean;
  /**
   * Which week-drawing surface this page is, when it is one. Server-rendered
   * onto `<html>` because it is the first half of the frame reservation's key
   * (surface, view, width) — the pre-paint probe below and the CSS in
   * planner-week.css both read it, and neither can wait for a module to mount.
   */
  surface?: "planner" | "emne" | "user";
}
const { title, description, wide = false, surface } = Astro.props;

const THEME_KEY = "np:theme";
const PLANS_KEY = "np:plans";
const PROFILE_KEY = "np:profile";
const LAST_SEMESTER_KEY = "np:lastSemester";
// The remembered view and the height each surface's frame last measured in it —
// see `WEEK_VIEW_KEY`/`WEEK_BOX_KEY` in components/planner/weekView.ts.
const WEEK_VIEW_KEY = "np:weekView";
const WEEK_BOX_KEY = "np:weekBox";
/** Widths further apart than this discard the remembered box (see below). */
const WEEK_BOX_TOLERANCE = 32;
// The probe's fallback when nothing has been stored yet — the same default
// `createPlanStore` is constructed with on every page, so the two read the
// same semester's course list.
const DEFAULT_SEMESTER_ID = semestersData.current?.id ?? "";

// Kept as a list of sections (not a bare href prefix) so a future addition
// cannot reintroduce the aria-current substring bug — `/emne/` is not a prefix
// of `/emner/`, which orphaned the highest-traffic page from its own nav.
const NAV = [
  { href: "/planlegger/", label: "Planlegger", sections: ["/planlegger/"] },
  { href: "/emner/", label: "Emner", sections: ["/emner/", "/emne/"] },
] as const;

const path = Astro.url.pathname;

function isCurrentSection(sections: readonly string[]): boolean {
  return sections.some((prefix) => path === prefix || path.startsWith(prefix));
}

const MONTH_ABBR = [
  "jan",
  "feb",
  "mar",
  "apr",
  "mai",
  "jun",
  "jul",
  "aug",
  "sep",
  "okt",
  "nov",
  "des",
];

/** `"2026-07-24T…"` → `"24. jul 2026"` (DR-8 provenance line, footer). */
function formatCrawlDate(iso: string): string {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return iso;
  const month = MONTH_ABBR[d.getUTCMonth()] ?? "";
  return `${d.getUTCDate()}. ${month} ${d.getUTCFullYear()}`;
}

const crawlDate = formatCrawlDate(semestersData.crawledAt);
---

<!doctype html>
<html lang="nb" data-surface={surface}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={faviconDataUri(VERDICT)} />
    {/* One page needs head tags nothing else does: `/user/<navn>` refuses
        indexing and carries `og:` tags the worker rewrites per name. A named
        slot rather than a growing list of props — the shell has no opinion
        about what goes in here, and every page that passes nothing emits
        nothing. */}
    <slot name="head" />
    <script
      is:inline
      define:vars={{
        THEME_KEY,
        PLANS_KEY,
        PROFILE_KEY,
        LAST_SEMESTER_KEY,
        DEFAULT_SEMESTER_ID,
        WEEK_VIEW_KEY,
        WEEK_BOX_KEY,
        WEEK_BOX_TOLERANCE,
      }}
    >
      // No-flash theme init — reads the stored choice, falls back to the OS
      // preference, sets data-theme on <html> before first paint.
      //
      // It carries a second passenger: the PLAN PROBE (tokens.css,
      // `--plan-courses`). Same mechanism, same reason — something only
      // localStorage knows, needed before the first frame, and wiped by every
      // view-transition swap. All it reports is how much space the page is
      // about to need.
      (function () {
        function isDark() {
          try {
            const saved = localStorage.getItem(THEME_KEY);
            return saved
              ? saved === "dark"
              : matchMedia("(prefers-color-scheme: dark)").matches;
          } catch (e) {
            return false;
          }
        }
        function applyTheme() {
          if (isDark())
            document.documentElement.setAttribute("data-theme", "dark");
          else document.documentElement.removeAttribute("data-theme");
        }
        // Deliberately forgiving: every failure path lands on "no plan", which
        // reserves nothing. A wrong reservation is worse than none.
        function applyPlan() {
          var root = document.documentElement;
          var count = 0;
          var program = false;
          var anyCourses = false;
          try {
            var last = localStorage.getItem(LAST_SEMESTER_KEY) || DEFAULT_SEMESTER_ID;
            var plans = JSON.parse(localStorage.getItem(PLANS_KEY) || "{}");
            var courses = plans && typeof plans === "object" ? plans[last] : null;
            // Dropped courses are counted: they still draw a row in the course
            // list, which is what the reservation is measured in.
            if (Array.isArray(courses)) count = courses.length;
            // ANY semester, not just this one — see below.
            if (plans && typeof plans === "object") {
              for (var key in plans) {
                if (Array.isArray(plans[key]) && plans[key].length > 0) anyCourses = true;
              }
            }
            var profile = JSON.parse(localStorage.getItem(PROFILE_KEY) || "{}");
            program = !!(profile && profile.program && profile.program.code);
          } catch (e) {
            count = 0;
            program = false;
            anyCourses = false;
          }
          // TWO FACTS, TWO SCOPES, and keeping them apart is the whole point.
          // The COUNT is this semester's and sizes the reservations, so a row
          // that is not being drawn is not reserved for. `data-plan`'s PRESENCE
          // is "does this student have a plan at all", across every semester:
          // /planlegger/ gates its first-run screen on the absence of it, and
          // someone who switched to an empty term has not become a first-time
          // visitor. `syncPlanProbe` must keep agreeing with this.
          root.style.setProperty("--plan-courses", String(count));
          if (program) root.setAttribute("data-plan", "program");
          else if (count > 0) root.setAttribute("data-plan", "courses");
          else if (anyCourses) root.setAttribute("data-plan", "elsewhere");
          else root.removeAttribute("data-plan");
          // Whether this load carries a search query. A static build cannot see
          // `?q=`, so /emner/ — whose status line changes for it — needs the
          // fact before first paint or it paints the wrong line and swaps it.
          if (/(^|&)q=[^&]/.test(location.search.slice(1)))
            root.setAttribute("data-query", "");
          else root.removeAttribute("data-query");
          applyWeekBox(root);
        }
        // Which way the planner draws its week, and how tall that came out last
        // time. The two views have different geometries, so one reserved height
        // cannot serve both (planner-week.css has the measurements).
        //
        // The default must agree with `loadWeekView`'s: disagree, and a cold
        // load reserves the height of a view it is not about to draw.
        //
        // The remembered height is preferred over any formula because it is
        // evidence rather than a model, and it is nearly always available: a
        // load in Liste is by construction a return visit. It is stored WITH
        // the width it was measured at and discarded outside a small
        // tolerance — a height measured at another width is not evidence about
        // this one.
        function applyWeekBox(root) {
          var view = "kolonner";
          var box = null;
          try {
            var stored = localStorage.getItem(WEEK_VIEW_KEY);
            if (stored === "kolonner" || stored === "tavle") view = stored;
            // Keyed by SURFACE first: three pages draw a week, and a height
            // measured on a five-course planner is not evidence about a
            // one-course course page. A page that is not one of them has no
            // frame to reserve, so it looks nothing up.
            var surface = root.getAttribute("data-surface");
            var saved = JSON.parse(localStorage.getItem(WEEK_BOX_KEY) || "{}");
            var forSurface =
              surface && saved && typeof saved === "object" ? saved[surface] : null;
            var entry = forSurface && typeof forSurface === "object" ? forSurface[view] : null;
            if (
              Array.isArray(entry) &&
              entry[1] > 0 &&
              Math.abs(entry[0] - window.innerWidth) <= WEEK_BOX_TOLERANCE
            ) {
              box = entry[1];
            }
          } catch (e) {
            view = "kolonner";
            box = null;
          }
          root.setAttribute("data-view", view);
          if (box === null) root.style.removeProperty("--planner-box");
          else root.style.setProperty("--planner-box", box + "px");
        }
        applyTheme();
        applyPlan();
        // ClientRouter's swapRootAttributes() removes EVERY attribute from
        // <html> and restores only the ones the server rendered — and data-theme
        // is set here on the client, so it is wiped on every navigation. This
        // script does not re-execute on a swap (head elements are re-appended,
        // not re-run), so re-apply from a listener on `document`, which survives
        // swaps. astro:after-swap fires before the new page paints: no flash.
        //
        // The plan probe rides the same listener, and it matters more here: a
        // soft navigation does NOT reset CLS, so the next page's shift lands in
        // the score of the page-load the visitor started on. Re-read rather than
        // re-apply a cached value — the plan may have changed.
        document.addEventListener("astro:after-swap", function () {
          applyTheme();
          applyPlan();
        });
        matchMedia("(prefers-color-scheme: dark)").addEventListener(
          "change",
          function () {
            try {
              if (localStorage.getItem(THEME_KEY)) return;
            } catch (e) {
              /* storage disabled — OS still wins */
            }
            applyTheme();
            document.dispatchEvent(
              new CustomEvent("np:themechange", {
                detail:
                  document.documentElement.getAttribute("data-theme") === "dark"
                    ? "dark"
                    : "light",
              }),
            );
          },
        );
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Hopp til innhold</a>
    <div class="site">
      <header class="site-topbar">
        <a class="site-brand" href="/">
          Semesterplan<span class="site-brand-suffix">NTNU</span>
        </a>
        {/* THE RUN THAT FOLDS. Above 480px this wrapper is `display: contents`
            and these are ordinary flex children of the bar, laid out exactly
            as they were before the menu existed; below it, it IS the menu's
            panel. One DOM either way — every control in here is bound by id
            somewhere else (`#site-account-btn`, `#site-account-name`,
            `.theme-toggle`), so a duplicated phone-only copy would collide and
            the pre-paint name script would correct the wrong node. */}
        <div class="site-menu-panel" id="site-menu-panel">
          <nav class="site-nav" aria-label="Hovednavigasjon">
            {
              NAV.map((item) => (
                <a
                  class="np-navlink"
                  href={item.href}
                  aria-current={isCurrentSection(item.sections) ? "page" : undefined}
                >
                  {item.label}
                </a>
              ))
            }
          </nav>
          {/* Links go somewhere; the two below change something. Drawn only
              inside the panel — with the wrapper at `display: contents` this
              would otherwise rule a line across the middle of the bar. */}
          <hr class="site-menu-sep" />
          <AccountButton defaultSemesterId={DEFAULT_SEMESTER_ID} />
          <ThemeToggle storageKey={THEME_KEY} />
        </div>
        <button
          type="button"
          class="np-icon-btn site-menu-btn"
          id="site-menu-btn"
          aria-controls="site-menu-panel"
          aria-expanded="false"
          aria-label="Meny"
        >
          <Icon name="menu" size={20} />
        </button>
      </header>
      <main id="main-content" class:list={["site-content", { wide }]}>
        <slot />
      </main>
      <footer class="site-footer">
        {`Data hentet ${crawlDate} fra NTNU. Uoffisiell, med forbehold om feil`}
      </footer>
    </div>
    <script>
      import { mountMenuPanel } from "../lib/menuPanel.ts";
      import { onPage } from "../lib/pageLifecycle.ts";
      // Per page-load, never once per module: the topbar is re-rendered by the
      // server on every ClientRouter swap, so a top-level mount would leave
      // this button dead after any in-site navigation.
      onPage((signal) => {
        const bar = document.querySelector<HTMLElement>(".site-topbar");
        const trigger = document.getElementById("site-menu-btn");
        const panel = document.getElementById("site-menu-panel");
        if (!bar || !trigger || !panel) return;
        mountMenuPanel({ bar, trigger, panel, query: "(max-width: 480px)", signal });
      });
    </script>
  </body>
</html>
