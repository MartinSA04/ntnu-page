---
import Layout from "../layouts/Layout.astro";

const description =
  "Timeplan for NTNU-studenter: velg studieprogram og kull, se ukeplanen med en gang.";
---

<Layout title="Semesterplan" description={description}>
  {/* The returning student's answer, and the whole page: which room, right
      now, then what is left after it. `hidden` until the plan says otherwise,
      so a first-time visitor never sees an empty frame — they get the button
      and nothing else, which is the correct amount of explanation for a page
      whose job people already understand. */}
  {/* The card's place, held from first paint for a visitor whose stored plan
      says one is coming (Layout.astro's probe). `#home-now` itself stays
      `hidden` — it is genuinely not there yet, and a screen reader should not
      be walked through an empty card — so the space is held beside it rather
      than inside it. `now.ts` collapses this the moment it knows, in either
      direction.

      Why it is worth the machinery: the card is 253px and it is INSERTED ABOVE
      the button, so a returning student's landing page used to move everything
      under it about a second in. That was 0.133 CLS on a phone, on the page
      every visit starts at, and it hit exactly the people who come back
      most. */}
  <div class="home-now-hold" id="home-now-hold" aria-hidden="true"></div>
  <section class="home-now" id="home-now" aria-labelledby="home-now-label" hidden>
    <a class="home-now-link" href="/planlegger/" id="home-now-link">
      <span class="np-kicker home-now-label" id="home-now-label"></span>
      <span class="home-now-room np-data" id="home-now-room"></span>
      <span class="home-now-course" id="home-now-course"></span>
      <span class="np-note home-now-sub" id="home-now-sub"></span>
      <span class="home-now-bar" id="home-now-bar" aria-hidden="true"><span></span></span>
    </a>
    <ul class="home-now-next" id="home-now-next"></ul>
  </section>

  {/* STILL NO PITCH — one line, and only on the first visit. What was struck
      here was a kicker, a headline and two sentences explaining what a
      schedule page is; people know what a schedule page is. What they cannot
      know from a button reading "Åpne planleggeren" is the two facts it is
      about to ask them for, so the line names those and stops. A returning
      student's answer is the card above, not an explanation, which is why the
      line is gone the moment there is a plan.

      The heading survives for the document outline only. A page with no `h1`
      is a page a screen reader cannot summarise, and the visible answer here
      is a card that changes every hour. */}
  <h1 class="sr-only">Semesterplan</h1>

  {/* Deliberately NOT the planner's first-run lead reworded. That sentence
      stands over the programme field and says what pressing it does; this one
      stands over a button and says what is on the other side of it, plus the
      one fact that decides whether a first-time visitor bothers pressing. */}
  <p class="home-intro" id="home-intro">
    Ukeplanen for studieprogrammet og kullet ditt, uten innlogging.
  </p>

  {/* THE accent's one job, spent on the one thing this page is for. It shipped
      as a bare `.np-btn`: the same grey chip as "Fjern" and "Avbryt", holding
      the only call to action on the front door, while the accent went unspent
      on the page entirely. */}
  <a class="np-btn np-btn--primary home-cta" href="/planlegger/">Åpne planleggeren</a>

</Layout>

<style>
  /* --- Introen ------------------------------------ */

  /* Body, not the title step: this is a sentence, and the scale gives one job
     per step. It is the only text on a first visit, so it does not also have
     to be large to be found. */
  .home-intro {
    max-width: 34ch;
    margin: 0 0 var(--space-5);
    color: var(--muted);
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    text-wrap: balance;
  }

  /* First visit only, decided by the SAME predicate the planner's first-run
     screen uses: `data-plan` is present whenever a plan exists in ANY
     semester, so a student who emptied this term is not walked back through
     the introduction. Layout's probe writes it before first paint, so this is
     a CSS gate on the document rather than a JS reveal: nothing to reserve
     space for, and no line that flashes in and then leaves. */
  html[data-plan] .home-intro {
    display: none;
  }

  /* --- Nå ---------------------------------------- */

  .home-now[hidden] {
    display: none;
  }

  .home-now {
    margin-bottom: var(--space-7);
  }

  /* The reservation. 15rem against a card that measures 253px at 390px and
     281px at 1440 — under both, per the house rule that the residual should
     nudge down rather than snatch upward. `--plan-any` is 0 for a first-time
     visitor, so the pitch-only page is untouched.

     The cost: a student whose week has nothing left to report gets an upward
     collapse of this box. That is the rarer branch of a card that exists
     because most plans do have a next lecture, and `now.ts` releases the hold
     there too, so it is one shift rather than a permanent hole. */
  .home-now-hold {
    min-height: calc(var(--plan-any) * 15rem);
  }

  .home-now-hold.is-released {
    min-height: 0;
  }

  /* The whole card is the door to the planner — one target, no button
     competing with it, and nothing inside it that is separately clickable. */
  .home-now-link {
    display: grid;
    gap: var(--space-1);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border-strong);
    color: inherit;
    text-decoration: none;
  }

  .home-now-link:hover .home-now-room {
    color: var(--ui);
  }

  /* "Nå, 37 min igjen" labels a moment; it does not judge a plan. */
  .home-now-label {
    color: var(--muted);
  }

  /* The room, set as display type: the one fact you are walking somewhere to
     find out. Nothing else on this page is this size. */
  .home-now-room {
    font-size: clamp(3.5rem, 15vw, 7rem);
    font-weight: var(--weight-medium);
    line-height: 0.85;
    letter-spacing: -0.05em;
    transition: color var(--dur-fast) var(--ease);
  }

  /* "Realfagbygget A" is a sentence wearing a room's clothes — it steps down
     rather than wrapping across three lines of display type. */
  .home-now-room.is-long {
    font-size: clamp(1.8rem, 6vw, 3rem);
    letter-spacing: -0.03em;
  }

  .home-now-room.is-none {
    color: var(--faint);
  }

  .home-now-course {
    margin-top: var(--space-2);
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
    letter-spacing: -0.01em;
  }

  .home-now-sub {
    color: var(--muted);
  }

  .home-now-bar {
    height: 3px;
    margin-top: var(--space-3);
    background: var(--card-nested);
  }

  .home-now-bar[hidden] {
    display: none;
  }

  /* How far through the lecture you are — a measurement, not a verdict. */
  .home-now-bar > span {
    display: block;
    height: 100%;
    background: var(--ui);
  }

  .home-now-next {
    list-style: none;
    max-width: none;
    margin: 0;
    padding: 0;
  }

  /* :global() because these rows are BUILT IN JS: Astro stamps a data attribute
     on the elements it compiled, and a node created at runtime never gets one,
     so a scoped selector matches nothing and the list collapses into one run-on
     line. */
  :global(.home-now-next li) {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr) auto;
    gap: 0 var(--gap-3);
    align-items: baseline;
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--border);
    font-size: var(--text-sm);
  }

  :global(.home-now-when) {
    color: var(--muted);
    font-size: var(--text-xs);
  }

  :global(.home-now-what) {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--muted);
  }

  :global(.home-now-where) {
    font-size: var(--text-xs);
  }


  @media (max-width: 40rem) {
    :global(.home-now-next li) {
      grid-template-columns: 5rem minmax(0, 1fr);
    }

    :global(.home-now-where) {
      grid-column: 2;
    }
  }

</style>

<script>
  import { onPage } from "../lib/pageLifecycle.ts";
  import { watchPlanProbe } from "../lib/planProbe.ts";
  import { createPlanStore } from "../lib/planner/store.ts";
  import { loadWeekSessions, nowVerdict, weekMinutes } from "../components/site/now.ts";
  import semestersData from "../../data/semesters.json";

  const defaultSemesterId = semestersData.current?.id ?? "";
  const DAYS = ["mandag", "tirsdag", "onsdag", "torsdag", "fredag", "lørdag", "søndag"];

  // Per page-load, not per module: ClientRouter evaluates this module once, so
  // wiring at top level left the card frozen at whatever it read on the first
  // visit.
  onPage((signal) => {
    const store = createPlanStore(defaultSemesterId);
    // Keeps `--plan-courses` true for the rest of the visit — a soft navigation
    // does not reset CLS, so the next page's reservations are still this
    // page-load's problem.
    watchPlanProbe(store, signal);

    // --- Nå ---------------------------------------

    const nowEl = document.getElementById("home-now") as HTMLElement | null;
    if (!nowEl) return;
    const holdEl = document.getElementById("home-now-hold");
    /**
     * Hands back the space the probe reserved for the card, on every terminal
     * state — the card's and the absence of one alike. The reservation is a
     * bridge to the first honest answer, and the moment there is one it has no
     * further business holding anything.
     */
    const releaseHold = (): void => holdEl?.classList.add("is-released");
    const el = (id: string) => document.getElementById(id) as HTMLElement | null;
    const semester =
      semestersData.semesters.find((s) => s.id === store.loadPlan().semesterId) ??
      semestersData.current;
    if (!semester) return;

    /**
     * One in-flight load at a time, and only the newest may paint: a plan change
     * while the timetables are arriving would let the old week's answer land on
     * top of the new one.
     */
    let token = 0;

    /**
     * The week this card is answering from. Held so the clock can repaint
     * without refetching: the card's claim is minute-resolution, and computed
     * once and left it was wrong within the hour.
     */
    let sessions: Awaited<ReturnType<typeof loadWeekSessions>> | null = null;

    async function renderNow(): Promise<void> {
      const mine = ++token;
      const plan = store.loadPlan();
      if (plan.courses.filter((c) => !c.dropped).length === 0) {
        sessions = null;
        if (nowEl) nowEl.hidden = true;
        releaseHold();
        return;
      }
      let loaded: Awaited<ReturnType<typeof loadWeekSessions>>;
      try {
        loaded = await loadWeekSessions(plan, semester.id, semester.teachingWeeks ?? []);
      } catch {
        // A dead fetch is a terminal state too. Without this the reserved space
        // is held open for the life of the page by the one branch that never
        // reaches `paintNow`.
        releaseHold();
        return;
      }
      if (mine !== token || signal.aborted || !nowEl) return;
      sessions = loaded;
      paintNow();
    }

    /** The half that reads the clock. No fetch, so it is safe every minute. */
    function paintNow(): void {
      if (!sessions || !nowEl) return;

      const verdict = nowVerdict(sessions, weekMinutes(new Date()));
      // Nothing to answer with (no timetables yet, or a course-less plan): the
      // resume line above is still true, so the page says nothing here rather
      // than showing an empty card.
      if (verdict.kind === "empty") {
        nowEl.hidden = true;
        releaseHold();
        return;
      }
      nowEl.hidden = false;
      releaseHold();

      const label = el("home-now-label");
      const room = el("home-now-room");
      const course = el("home-now-course");
      const sub = el("home-now-sub");
      const bar = el("home-now-bar");
      const next = el("home-now-next");
      const link = el("home-now-link") as HTMLAnchorElement | null;
      if (!label || !room || !course || !sub || !bar || !next || !link) return;


      if (verdict.kind === "done") {
        label.textContent = "Denne uka";
        room.textContent = "Ingen flere";
        room.classList.add("is-none");
        course.textContent = "Ingenting mer denne uka.";
        sub.textContent = "";
        bar.hidden = true;
        next.replaceChildren();
        link.setAttribute("aria-label", "Ingenting mer denne uka. Åpne planleggeren");
        return;
      }

      const s = verdict.session;
      const running = verdict.kind === "running";
      label.textContent = running ? "Nå" : "Neste";
      room.textContent = s.room || "Rom ikke satt";
      room.classList.toggle("is-none", !s.room);
      // The room is the display figure, so a building name that is really a
      // sentence steps down rather than wrapping across three lines. Ordinary
      // codes keep the display size, which is the point of the figure.
      room.classList.toggle("is-long", !s.room || s.room.length > 8 || /\s/.test(s.room));
      course.textContent = `${s.code} ${s.courseName}`;
      sub.textContent = [
        s.activity,
        `${DAYS[s.dayNumber - 1] ?? ""} ${s.startTime}–${s.endTime}`.trim(),
        // A lab across four rooms says so here, where a count fits; the figure
        // above stays one word.
        s.roomsExtra > 0 ? `+${s.roomsExtra} rom` : "",
      ]
        .filter(Boolean)
        .join(", ");

      bar.hidden = !running;
      if (running) {
        const fill = bar.firstElementChild as HTMLElement | null;
        if (fill) fill.style.width = `${Math.round(verdict.progress * 100)}%`;
        label.textContent = `Nå, ${verdict.minutesLeft} min igjen`;
      }
      link.setAttribute(
        "aria-label",
        `${running ? "Pågår nå" : "Neste time"}: ${s.code}, rom ${s.room || "ikke satt"}. Åpne planleggeren`,
      );

      next.replaceChildren();
      for (const item of verdict.rest) {
        const li = document.createElement("li");
        const when = document.createElement("span");
        when.className = "np-data home-now-when";
        when.textContent = `${DAYS[item.dayNumber - 1]?.slice(0, 3) ?? ""} ${item.startTime}`;
        const what = document.createElement("span");
        what.className = "home-now-what";
        what.textContent = `${item.code} ${item.activity}`;
        const where = document.createElement("span");
        where.className = "np-data home-now-where";
        where.textContent = item.room;
        li.append(when, what, where);
        next.append(li);
      }
    }

    void renderNow();
    signal.addEventListener(
      "abort",
      store.onPlanChange(() => {
        void renderNow();
      }),
    );

    // The clock, at the resolution the card claims. Repainting is cheap — the
    // week is already in hand — so this is a minute tick, and a tab that was
    // asleep is corrected the moment it is looked at.
    const clock = setInterval(paintNow, 60_000);
    signal.addEventListener("abort", () => clearInterval(clock));
    document.addEventListener(
      "visibilitychange",
      () => {
        if (document.visibilityState === "visible") paintNow();
      },
      { signal },
    );
  });
</script>
