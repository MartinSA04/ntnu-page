---
import catalogData from "../../../data/catalog.json";
import semestersData from "../../../data/semesters.json";
import Layout from "../../layouts/Layout.astro";
// The week is rendered by components/planner/grid.ts, so this page needs the
// same geometry /planlegger/ uses — one shared stylesheet, not a second copy.
import "../../styles/planner-week.css";

export function getStaticPaths() {
  return catalogData.courses.map((course) => ({
    params: { code: course.code },
    props: { course },
  }));
}

interface Props {
  course: (typeof catalogData.courses)[number];
}

const { course } = Astro.props;
const catalogYear = catalogData.year;

// C1: the catalog now unions two crawl years. A course missing from the
// canonical year is a real course that simply is not taught this year — its
// name, version, exams and timetable all belong to `offeredYears[0]`, and the
// page has to say so rather than render an empty current-year week.
const offeredYears: number[] = course.offeredYears ?? [catalogYear];
const isOffered = offeredYears.includes(catalogYear);
const sourceYear = isOffered ? catalogYear : (offeredYears[0] ?? catalogYear);

const semester = semestersData.current;
// "2026 Høst" is how semesters.json stores it; the copy reads "Høst 2026".
const semesterLabel = semester.name.replace(/^(\d{4})\s+(.+)$/, "$2 $1");

const SEASON_LABELS: Record<string, string> = {
  SPRING: "vår",
  AUTUMN: "høst",
  WINTER: "vinter",
  SUMMER: "sommer",
};

function formatDate(date: string | null): string | null {
  if (!date) return null;
  const d = new Date(date);
  if (Number.isNaN(d.getTime())) return date;
  return d.toLocaleDateString("nb-NO", { day: "numeric", month: "long", year: "numeric" });
}

const description = `${course.code} ${course.name} — timeplan, eksamen og nøkkeltall fra NTNU.`;
---

<Layout title={`${course.code} — ${course.name}`} description={description} wide>
  <p class="np-data emne-code">{course.code}</p>
  <h1 class="emne-title">{course.name}</h1>
  <p class="emne-meta np-note">
    {course.location}
    {course.examOnly && <span class="emne-examonly">kun eksamen</span>}
    {
      !isOffered && (
        <span class="emne-stale">
          ikke undervist i {catalogYear} · sist undervist {sourceYear}
        </span>
      )
    }
  </p>

  {/* The fork point (U10/U11): the verdict comes before the encyclopedia. */}
  <div class="emne-cta">
    <button
      type="button"
      class="np-btn emne-plan-btn"
      id="emne-plan-btn"
      data-code={course.code}
      aria-pressed="false"
    >
      Legg til i planen
    </button>
    <a class="emne-plan-link" id="emne-plan-link" href="/planlegger/" hidden>se ukeplanen →</a>
  </div>
  <div class="emne-clash-slot" id="emne-clash" aria-live="polite">
    <p class="np-hint">Sjekker planen din for {semesterLabel} …</p>
  </div>

  <div
    id="emne-islands"
    data-course-code={course.code}
    data-course-name={course.name}
    data-course-version={course.version ?? "1"}
    data-source-year={sourceYear}
    data-offered={String(isOffered)}
  >
    <section class="emne-section" id="timetable-section">
      <h2 class="np-kicker emne-section-head">Timeplan</h2>
      <p class="emne-loading np-hint" data-role="status" aria-live="polite">Henter timeplanen …</p>
      <div data-role="body" hidden></div>
    </section>

    <section class="emne-section" id="exam-section">
      <h2 class="np-kicker emne-section-head">Eksamen</h2>
      {
        course.exams.length > 0 ? (
          <ul class="emne-exams-list">
            {course.exams.map((exam) => (
              <li class="emne-exam-row">
                <span class="emne-exam-season">
                  {exam.season && SEASON_LABELS[exam.season]
                    ? SEASON_LABELS[exam.season]
                    : (exam.season ?? "eksamen")}
                </span>
                <span class="np-data emne-exam-date">
                  {formatDate(exam.date) ?? "eksamensdato ikke fastsatt"}
                </span>
                {exam.continuation && <span class="emne-exam-cont np-note">kontinuasjon</span>}
              </li>
            ))}
          </ul>
        ) : (
          <p class="np-hint">Eksamensdato er ikke fastsatt i emnekatalogen.</p>
        )
      }
      {
        !isOffered && course.exams.length > 0 && (
          <p class="np-hint">Datoene er fra {sourceYear} — emnet er ikke i katalogen for {catalogYear}.</p>
        )
      }
      <details class="emne-disclosure" data-role="exam-more" hidden>
        <summary class="np-summary">Eksamensdetaljer</summary>
        <div class="emne-disclosure-body" data-role="exam-body"></div>
      </details>
    </section>

    <section class="emne-section" id="details-section">
      <h2 class="np-kicker emne-section-head">Nøkkeltall</h2>
      <p class="emne-loading np-hint" data-role="status" aria-live="polite">
        Henter emnedetaljer …
      </p>
      <div data-role="body" hidden></div>
      <details class="emne-disclosure" data-role="prose-wrap" hidden>
        <summary class="np-summary">Mer om emnet</summary>
        <div class="emne-disclosure-body" data-role="prose"></div>
      </details>
    </section>
  </div>
</Layout>

<style>
  .emne-code {
    font-size: var(--text-sm);
    color: var(--muted);
    margin-bottom: var(--space-1);
  }
  .emne-title {
    margin-bottom: var(--space-2);
  }
  .emne-meta {
    margin-bottom: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: baseline;
  }
  .emne-examonly {
    color: var(--faint);
  }
  .emne-stale {
    color: var(--faint);
  }

  .emne-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-2);
  }
  .emne-plan-link {
    font-size: var(--text-sm);
    color: var(--accent-ink);
  }
  .emne-clash-slot {
    /* Reserved so the verdict landing does not shove the week down the page. */
    min-height: 1.6em;
    margin-bottom: var(--space-6);
  }

  .emne-section {
    margin-bottom: var(--space-7);
  }
  .emne-section-head {
    margin-bottom: var(--space-3);
  }

  .emne-exams-list {
    list-style: none;
    max-width: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-bottom: var(--space-3);
  }
  .emne-exam-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
  }
  .emne-exam-date {
    font-size: var(--text-md);
  }
  .emne-exam-cont {
    color: var(--faint);
  }

  .emne-disclosure {
    margin-top: var(--space-3);
  }
  .emne-disclosure-body {
    padding-top: var(--space-3);
  }

  /* Island content below is built client-side via document.createElement, so
     Astro's scoped-style attribute never reaches it — every selector that
     targets island-rendered markup must go through :global(). */

  :global(.timetable-term) {
    margin-bottom: var(--space-3);
  }
  :global(.timetable-others) {
    margin-bottom: var(--space-3);
  }

  /* --- Facts, exam enrichment and prose ----------------------------------- */

  :global(.details-facts) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: var(--space-3) var(--space-5);
    background: var(--card);
    border-radius: var(--radius);
    padding: var(--space-4) var(--space-5);
  }
  :global(.details-fact) {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  :global(.details-fact-value) {
    font-size: var(--text-base);
  }
  :global(.details-prose) {
    margin-bottom: var(--space-5);
  }
  :global(.details-prose-heading) {
    margin-bottom: var(--space-2);
  }
  :global(.details-prose-body) {
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    white-space: pre-line;
  }
  /* D6: data lists are not prose and must not inherit base.css's 38rem cap. */
  :global(.details-activities-list),
  :global(.details-reductions-list) {
    font-size: var(--text-base);
    max-width: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-left: var(--space-5);
  }
  :global(.details-exam-list) {
    list-style: none;
    max-width: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  :global(.details-exam-row) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
    font-size: var(--text-sm);
  }
  :global(.details-exam-facts) {
    color: var(--muted);
  }
  :global(.details-reductions) {
    margin-bottom: var(--space-5);
  }
</style>

<script>
  import { mountCourseDetails } from "../../components/site/courseDetails";
  import { mountCourseTimetable } from "../../components/site/courseTimetable";
  import { clashNode, planClash, semesterLabel } from "../../components/site/planClash";
  import { onPage } from "../../lib/pageLifecycle.ts";
  import { createPlanStore } from "../../lib/planner/store.ts";
  import semestersData from "../../../data/semesters.json";

  // Per page-load, not per module: ClientRouter evaluates this module once,
  // so mounting at top level left every course page after the first showing
  // the FIRST course's data (or nothing at all).
  onPage((signal) => {
    const root = document.getElementById("emne-islands");
    if (!root) return;
    const code = root.dataset.courseCode ?? "";
    const name = root.dataset.courseName ?? "";
    const version = root.dataset.courseVersion || "1";
    const sourceYear = Number(root.dataset.sourceYear ?? "0");
    const isOffered = root.dataset.offered === "true";

    const semester = semestersData.current;
    const term = semesterLabel(semester.name);

    mountCourseDetails(code);
    const timetable = mountCourseTimetable({
      code,
      name,
      version,
      year: sourceYear,
      semester: { season: semester.season, year: semester.year, label: term },
    });

    const planBtn = document.getElementById("emne-plan-btn") as HTMLButtonElement | null;
    const planLink = document.getElementById("emne-plan-link") as HTMLAnchorElement | null;
    const clashSlot = document.getElementById("emne-clash");
    if (!planBtn) return;
    const store = createPlanStore(semester.id);
    const clashSemester = {
      id: semester.id,
      name: semester.name,
      teachingWeeks: semester.teachingWeeks,
    };

    function syncPlanBtn(): void {
      if (!planBtn) return;
      const inPlan = store.hasCourse(code);
      planBtn.setAttribute("aria-pressed", String(inPlan));
      planBtn.textContent = inPlan ? "Fjern fra planen" : "Legg til i planen";
      if (planLink) planLink.hidden = !inPlan;
    }

    // U11: the verdict is recomputed on every plan change, and a stale
    // in-flight check must never overwrite a newer one.
    let clashToken = 0;
    async function renderClash(): Promise<void> {
      if (!clashSlot) return;
      const token = ++clashToken;
      // A course outside the planned semester's catalog year has no entries
      // that could legitimately land in this semester's weeks — asserting
      // that with `[]` beats fetching last year's grid and matching on it.
      const sameYear = isOffered && sourceYear === semester.year;
      const own = sameYear ? await timetable : [];
      const verdict = await planClash({ code, version }, store.loadPlan(), clashSemester, own);
      if (token !== clashToken) return;
      clashSlot.replaceChildren(clashNode(verdict, clashSemester));
    }

    planBtn.addEventListener(
      "click",
      () => {
        if (store.hasCourse(code)) {
          store.removeCourse(code);
        } else {
          store.addCourse({ code, name, version });
        }
        syncPlanBtn();
      },
      { signal },
    );

    signal.addEventListener(
      "abort",
      store.onPlanChange(() => {
        syncPlanBtn();
        renderClash();
      }),
    );
    syncPlanBtn();
    renderClash();
  });
</script>
