---
import catalogData from "../../../data/catalog.json";
import semestersData from "../../../data/semesters.json";
import Layout from "../../layouts/Layout.astro";
// The week is rendered by components/planner/grid.ts, so this page needs the
// same geometry /planlegger/ uses — one shared stylesheet, not a second copy.
import "../../styles/planner-week.css";

export function getStaticPaths() {
  return catalogData.courses.map((course) => ({
    params: { code: course.code },
    props: { course },
  }));
}

interface Props {
  course: (typeof catalogData.courses)[number];
}

const { course } = Astro.props;
const catalogYear = catalogData.year;

// The catalog unions two crawl years. A course missing from the canonical year
// is a real course that simply is not taught this year — its name, version,
// exams and timetable all belong to `offeredYears[0]`, and the page has to say
// so rather than render an empty current-year week.
const offeredYears: number[] = course.offeredYears ?? [catalogYear];
const isOffered = offeredYears.includes(catalogYear);
const sourceYear = isOffered ? catalogYear : (offeredYears[0] ?? catalogYear);

// Only the *catalog's* own semester is a build-time fact — which semester the
// student is planning is client state, so nothing below the fold names one.
const semester = semestersData.current;

/**
 * `examOnly` is upstream's answer for the semester the catalog was crawled in,
 * but it is stored as a year-level course property — so the page printed a bare
 * "kun eksamen" while its own week rendered that course's spring lectures a few
 * centimetres below. Naming the semester the flag speaks for makes the two
 * agree, and the year comes from the catalog the row came from. Not suppressed
 * once the week resolves: for an exam-only course the other term's teaching is
 * exactly what the qualified badge predicts.
 */
const examOnlySeason = semester.name.replace(/^(\d{4})\s+(.+)$/, "$2");

const SEASON_LABELS: Record<string, string> = {
  SPRING: "vår",
  AUTUMN: "høst",
  WINTER: "vinter",
  SUMMER: "sommer",
};

/**
 * The catalog's exam array is raw upstream order with one row per course
 * *version*, so a course led with a November date over an assessment seven
 * weeks earlier and rendered four byte-identical "dato ikke fastsatt" rows for
 * two exams. Sorted by date with the dateless last, deduped on the (season,
 * date, continuation) triple — the same rule `renderCreditReductions` applies
 * to the same per-version duplication.
 */
function orderedExams(exams: typeof course.exams): typeof course.exams {
  const seen = new Set<string>();
  return exams
    .filter((exam) => {
      const key = `${exam.season ?? ""}|${exam.date ?? ""}|${exam.continuation ? "1" : "0"}`;
      if (seen.has(key)) return false;
      seen.add(key);
      return true;
    })
    .sort((a, b) => {
      if (a.date === b.date) return 0;
      if (!a.date) return 1;
      if (!b.date) return -1;
      return a.date < b.date ? -1 : 1;
    });
}

const exams = orderedExams(course.exams);

function formatDate(date: string | null): string | null {
  if (!date) return null;
  const d = new Date(date);
  if (Number.isNaN(d.getTime())) return date;
  return d.toLocaleDateString("nb-NO", { day: "numeric", month: "long", year: "numeric" });
}

const description = `${course.code} ${course.name}: timeplan, eksamen og nøkkeltall fra NTNU.`;
---

<Layout title={`${course.code} · ${course.name}`} description={description} wide>
  <p class="np-data emne-code">{course.code}</p>
  <h1 class="emne-title">{course.name}</h1>
  <p class="emne-meta np-note">
    {course.location}
    {
      course.examOnly && (
        <span class="emne-examonly">
          kun eksamen i {examOnlySeason} {sourceYear}
        </span>
      )
    }
    {
      !isOffered && (
        <span class="emne-stale">
          ikke undervist i {catalogYear} · sist undervist {sourceYear}
        </span>
      )
    }
  </p>

  {/* The fork point (U10/U11): the verdict comes before the encyclopedia. */}
  <div class="emne-cta">
    {
      isOffered ? (
        <>
          <button
            type="button"
            class="np-btn emne-plan-btn"
            id="emne-plan-btn"
            data-code={course.code}
          >
            Legg til i planen
          </button>
          {/* Says which of the four states the verb beside it belongs to —
              "Dropp" on a course the student never added themselves needs a
              reason. */}
          <span class="np-hint emne-plan-state" id="emne-plan-state" hidden />
        </>
      ) : (
        /* A course that is not in this year's catalog has no timetable and no
           details to fetch, so adding it produced a plan row reading "fikk ikke
           hentet detaljer: Not found". The add dialog declines the same way —
           this says so instead of offering the dead end. */
        <p class="np-hint emne-plan-off">
          Kan ikke legges til i planen — emnet er ikke undervist i {catalogYear}.
        </p>
      )
    }
  </div>
  <div class="emne-clash-slot" id="emne-clash" aria-live="polite">
    {/* No semester named here: which one the plan is for is client state
        (`np:lastSemester`), and this line is built at crawl time — naming
        the canonical semester is the same wrong claim astro-1 is about. The
        verdict that replaces it names the real one. */}
    <p class="np-hint">Sjekker planen din …</p>
  </div>

  <div
    id="emne-islands"
    data-course-code={course.code}
    data-course-name={course.name}
    data-course-version={course.version ?? "1"}
    data-source-year={sourceYear}
    data-offered={String(isOffered)}
  >
    <section class="emne-section" id="timetable-section">
      <h2 class="np-kicker emne-section-head">Timeplan</h2>
      <p class="emne-loading np-hint" data-role="status" data-reserve aria-live="polite">
        Henter timeplanen …
      </p>
      <div data-role="body" hidden></div>
    </section>

    <section class="emne-section" id="exam-section">
      <h2 class="np-kicker emne-section-head">Eksamen</h2>
      {
        exams.length > 0 ? (
          <ul class="emne-exams-list">
            {exams.map((exam) => (
              <li class="emne-exam-row">
                <span class="emne-exam-season">
                  {exam.season && SEASON_LABELS[exam.season]
                    ? SEASON_LABELS[exam.season]
                    : (exam.season ?? "eksamen")}
                </span>
                <span class="np-data emne-exam-date">
                  {formatDate(exam.date) ?? "eksamensdato ikke fastsatt"}
                </span>
                {exam.continuation && <span class="emne-exam-cont np-note">kontinuasjon</span>}
              </li>
            ))}
          </ul>
        ) : (
          <p class="np-hint">Eksamensdato er ikke fastsatt i emnekatalogen.</p>
        )
      }
      {
        !isOffered && exams.length > 0 && (
          <p class="np-hint">Datoene er fra {sourceYear}. Emnet er ikke i katalogen for {catalogYear}.</p>
        )
      }
      <details class="emne-disclosure" data-role="exam-more" hidden>
        <summary class="np-summary">Eksamensdetaljer</summary>
        <div class="emne-disclosure-body" data-role="exam-body"></div>
      </details>
    </section>

    <section class="emne-section" id="grades-section">
      <h2 class="np-kicker emne-section-head">Karakterer</h2>
      <p class="emne-loading np-hint" data-role="status" data-reserve aria-live="polite">
        Henter karakterstatistikk …
      </p>
      <div data-role="body" hidden></div>
    </section>

    <section class="emne-section" id="details-section">
      <h2 class="np-kicker emne-section-head">Nøkkeltall</h2>
      <p class="emne-loading np-hint" data-role="status" data-reserve aria-live="polite">
        Henter emnedetaljer …
      </p>
      <div data-role="body" hidden></div>
      <details class="emne-disclosure" data-role="prose-wrap" hidden>
        <summary class="np-summary">Mer om emnet</summary>
        <div class="emne-disclosure-body" data-role="prose"></div>
      </details>
    </section>
  </div>
</Layout>

<style>
  .emne-code {
    font-size: var(--text-sm);
    color: var(--muted);
    margin-bottom: var(--space-1);
  }
  /* 474 of 5 470 course names carry a 20+ character token, and at 32 px in a
     328 px column one of those overflows the h1 and takes the whole document
     18 px wider than a 360 px viewport — every section below then slides
     sideways under a slightly diagonal swipe. The document is `lang="nb"`, so
     `hyphens: auto` breaks where Norwegian breaks; `break-word` is the fallback
     for a token with no break opportunity at all. */
  .emne-title {
    margin-bottom: var(--space-2);
    overflow-wrap: break-word;
    hyphens: auto;
  }
  @media (max-width: 26rem) {
    .emne-title {
      font-size: var(--text-lg);
    }
  }
  .emne-meta {
    margin-bottom: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: baseline;
  }
  .emne-examonly {
    color: var(--faint);
  }
  .emne-stale {
    color: var(--faint);
  }

  .emne-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-2);
  }
  .emne-clash-slot {
    /* Reserved so the verdict landing does not shove the week down the page. */
    min-height: 1.6em;
    margin-bottom: var(--space-6);
  }

  .emne-section {
    margin-bottom: var(--space-7);
  }
  .emne-section-head {
    margin-bottom: var(--space-3);
  }

  /* The three fetched sections each collapsed to a one-line "Henter … …" and
     then expanded — 844 px → 3 181 px, CLS 0.26 warm and 0.61 on a realistic
     RTT, on the page that takes the most cold traffic. The placeholder holds
     the space instead.

     These bound the shift rather than removing it: the week's height is the
     course's own teaching span and is not knowable at build time, so the
     numbers are a middle ground — the page moves by the difference rather than
     by the whole box.

     `data-reserve` is a lease, not a layout: the island drops the attribute the
     moment it reaches a terminal state that keeps the status line on screen, so
     a failure never sits at the top of 24rem of empty page. The success path
     hides the line, which releases it too. */
  #timetable-section [data-role="status"][data-reserve] {
    min-height: 24rem;
  }
  #details-section [data-role="status"][data-reserve] {
    min-height: 8rem;
  }
  /* Karakterer's height is the one that is actually predictable: the figure
     draws exactly `VISIBLE_SEMESTERS` charts of a fixed 96 px plot, so the only
     variable is how many columns they sit in. Measured in Chromium on the real
     stylesheets: 657 px one-up, 437 px two-up, 237 px three-up, each reserved a
     little under so the residual nudges DOWN.

     The cost, stated plainly: a course DBH has never recorded releases the
     lease and the page jumps UP instead. Checked against the real population —
     4 811 of 5 470 courses (88,0 %) have grade rows — so the expected shift at
     390 px is ~117 px against ~539 px with no reservation. If that ratio ever
     inverts, delete these three rules, not the release in gradeChart.ts. */
  #grades-section [data-role="status"][data-reserve] {
    min-height: 36rem;
  }
  @media (min-width: 40rem) {
    #grades-section [data-role="status"][data-reserve] {
      min-height: 24rem;
    }
  }
  @media (min-width: 60rem) {
    #grades-section [data-role="status"][data-reserve] {
      min-height: 13rem;
    }
  }

  .emne-exams-list {
    list-style: none;
    max-width: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-bottom: var(--space-3);
  }
  .emne-exam-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
  }
  .emne-exam-date {
    font-size: var(--text-md);
  }
  .emne-exam-cont {
    color: var(--faint);
  }

  .emne-disclosure {
    margin-top: var(--space-3);
  }
  .emne-disclosure-body {
    padding-top: var(--space-3);
  }

  /* Island content below is built client-side, so Astro's scoped-style
     attribute never reaches it — every selector targeting island-rendered
     markup must go through :global(). */

  :global(.timetable-term) {
    margin-bottom: var(--space-3);
  }

  /* The week's two switches share a row: WHAT is drawn (øvinger og labber) and
     HOW MUCH of it (alle / bare min). They wrap on a narrow phone rather than
     compressing — a `.np-toggle` at its min-height is already a phone target,
     and two of them do not fit 358px side by side. */
  :global(.timetable-controls) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-2);
    margin-bottom: var(--space-2);
  }

  /* What the week is showing, under the controls that change it. */
  :global(.timetable-scope) {
    margin-bottom: var(--space-3);
  }

  /* --- Facts, exam enrichment and prose ----------------------------------- */

  :global(.details-facts) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: var(--space-3) var(--space-5);
    background: var(--card);
    border-radius: var(--radius);
    padding: var(--space-4) var(--space-5);
  }
  :global(.details-fact) {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  :global(.details-fact-value) {
    font-size: var(--text-base);
  }
  :global(.details-prose) {
    margin-bottom: var(--space-5);
  }
  :global(.details-prose-heading) {
    margin-bottom: var(--space-2);
  }
  :global(.details-prose-body) {
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    white-space: pre-line;
  }
  /* D6: data lists are not prose and must not inherit base.css's 38rem cap. */
  :global(.details-activities-list) {
    font-size: var(--text-base);
    max-width: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-left: var(--space-5);
  }

  /* Studiepoengreduksjon: three values a student compares down the column,
     so it is a table, not a bullet list of run-together sentences. */
  :global(.details-reductions-table) {
    border-collapse: collapse;
    font-size: var(--text-sm);
    text-align: left;
  }
  :global(.details-reductions-table th) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    text-transform: uppercase;
    letter-spacing: var(--tracking);
    color: var(--muted);
    padding: 0 var(--space-5) var(--space-1) 0;
    border-bottom: 1px solid var(--border);
  }
  :global(.details-reductions-table td) {
    padding: var(--space-2) var(--space-5) var(--space-2) 0;
    border-bottom: 1px solid var(--border);
    vertical-align: baseline;
  }
  :global(.details-reductions-table tr:last-child td) {
    border-bottom: none;
  }

  /* --- Karakterer ---------------------------------------------------------
     Small multiples sharing a y-scale, ONE hue for every bar (--hue-blue, the
     token, so it re-steps in dark): the stacked-bar alternative needs six
     mutually distinguishable colours and the palette validator failed every
     such ramp this system can build. Red is not used for F — Red-Is-Collision
     reserves it for coexistence failures. */

  /* Explicit column counts, not auto-fit: six semesters under auto-fit landed
     4 + 2, and a ragged last row reads as "these two are different" rather than
     "this is the older half". */
  :global(.grades-grid) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5) var(--space-6);
  }
  @media (min-width: 40rem) {
    :global(.grades-grid) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 60rem) {
    :global(.grades-grid) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* The figure was 39 % of the mobile page, so only the newest three semesters
     are drawn up front and the rest fold into this disclosure. Its list repeats
     `.grades-grid`'s columns rather than reusing the class — e2e locates
     `#grades-section .grades-grid` strictly, and a second match would fail the
     test rather than the rule. */
  :global(.grades-older) {
    margin-top: var(--space-5);
  }
  :global(.grades-older-list) {
    padding-top: var(--space-3);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5) var(--space-6);
  }
  @media (min-width: 40rem) {
    :global(.grades-older-list) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 60rem) {
    :global(.grades-older-list) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  :global(.grades-chart-head) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--gap-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-2);
  }
  :global(.grades-chart-term) {
    font-size: var(--text-md);
  }
  :global(.grades-chart-count) {
    font-size: var(--text-xs);
    color: var(--muted);
  }

  /* The bars share one baseline; the track holds the full plot height so
     every column's baseline lands on the same pixel row. */
  :global(.grades-plot) {
    display: flex;
    align-items: flex-end;
    gap: var(--gap-2);
  }
  :global(.grades-bar-col) {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
  }
  :global(.grades-bar-value) {
    font-size: var(--text-xs);
    color: var(--muted);
  }
  :global(.grades-bar-track) {
    width: 100%;
    height: var(--grades-plot-h, 96px);
    display: flex;
    align-items: flex-end;
  }
  /* Rounded data-end only: the bar is anchored to its baseline, so the
     bottom corners stay square. */
  :global(.grades-bar) {
    width: 100%;
    min-height: 1px;
    background: var(--hue-blue);
    border-radius: var(--radius-xs) var(--radius-xs) 0 0;
  }
  :global(.grades-bar-grade) {
    font-size: var(--text-xs);
    color: var(--fg);
  }

  :global(.grades-masked) {
    margin-top: var(--space-2);
    color: var(--faint);
  }
  :global(.grades-source) {
    margin-top: var(--space-4);
    max-width: none;
  }
  :global(.details-exam-list) {
    list-style: none;
    max-width: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  :global(.details-exam-row) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
    font-size: var(--text-sm);
  }
  :global(.details-exam-facts) {
    color: var(--muted);
  }
  :global(.details-reductions) {
    margin-bottom: var(--space-5);
  }
</style>

<script>
  import { mountCourseDetails } from "../../components/site/courseDetails";
  import { mountCourseTimetable } from "../../components/site/courseTimetable";
  import { mountGradeChart } from "../../components/site/gradeChart";
  import { clashNode, planClash, semesterLabel } from "../../components/site/planClash";
  import { onPage } from "../../lib/pageLifecycle.ts";
  import { watchPlanProbe } from "../../lib/planProbe.ts";
  import { createPlanStore } from "../../lib/planner/store.ts";
  import semestersData from "../../../data/semesters.json";

  // Per page-load, not per module: ClientRouter evaluates this module once, so
  // mounting at top level left every course page after the first showing the
  // FIRST course's data.
  onPage((signal) => {
    const root = document.getElementById("emne-islands");
    if (!root) return;
    const code = root.dataset.courseCode ?? "";
    const name = root.dataset.courseName ?? "";
    const version = root.dataset.courseVersion || "1";
    const sourceYear = Number(root.dataset.sourceYear ?? "0");
    const isOffered = root.dataset.offered === "true";

    // Off-year courses need the catalog year they actually come from, or the
    // details endpoint 404s and Nøkkeltall renders empty. The grade figure
    // reads the SAME payload to learn which seasons hold an ordinary exam, so
    // both callers take the one year — one URL, one cache entry, one request.
    const detailsYear = isOffered ? null : sourceYear;
    mountCourseDetails(code, detailsYear);
    void mountGradeChart(code, signal, detailsYear);

    // A course the catalog no longer offers gets no add control at all (the
    // add dialog's policy for the same row); the week, the verdict and the
    // details still render.
    const planBtn = document.getElementById("emne-plan-btn") as HTMLButtonElement | null;
    const planState = document.getElementById("emne-plan-state");
    const clashSlot = document.getElementById("emne-clash");
    // The store prefers `np:lastSemester` over this default, so it is only the
    // fallback for a visitor who has never picked a semester.
    const store = createPlanStore(semestersData.current.id);
    // "Legg til i planen" here changes what /planlegger/ and the landing page
    // have to reserve on the next soft navigation — still this page-load's CLS.
    watchPlanProbe(store, signal);

    /**
     * The plan the verdict checks is the store's, and the store follows
     * `np:lastSemester` — so building from the build-time `semestersData.current`
     * named and checked a semester the student is not planning. An id we do not
     * know falls back to the canonical one rather than inventing weeks.
     */
    function plannedSemester(): (typeof semestersData.semesters)[number] {
      const id = store.loadPlan().semesterId;
      return semestersData.semesters.find((s) => s.id === id) ?? semestersData.current;
    }

    let semester = plannedSemester();

    function mountWeek() {
      // The three facts the scope line and the "bare min" switch are about,
      // read at mount. The programme narrows lectures to your own section; a
      // plan ENTRY is the only thing that can carry your øving-group pick,
      // which is why the line offers a plan when there is none.
      const planNow = store.loadPlan();
      const entryNow = planNow.courses.find((c) => c.code === code);
      return mountCourseTimetable({
        code,
        name,
        version,
        year: sourceYear,
        semester: {
          season: semester.season,
          year: semester.year,
          label: semesterLabel(semester.name),
          teachingWeeks: semester.teachingWeeks,
        },
        programCode: planNow.program?.code ?? null,
        selectedGroups: entryNow?.groups,
        inPlan: !!entryNow && !entryNow.dropped,
        signal,
      });
    }

    let timetable = mountWeek();

    /**
     * One button, four verbs — the same four the planner's course rail and the
     * add dialog use, because they act on the same plan. "Fjern fra planen" on a
     * programme course promised an irreversible delete and the next study-plan
     * derive put the course back undropped: destructive copy over a change that
     * did not stick. A programme course is dropped and restored (PRODUCT §1.3).
     *
     * `.is-active` rather than `aria-pressed` carries the in-plan fill: with
     * four states there is nothing to press, and `hasCourse` is deliberately
     * blind to `dropped`.
     *
     * The STATE is spelled "I planen" — DESIGN §8's other half of "Legg til i
     * planen", spelled the same way on all four surfaces. The button cannot
     * carry it here (the verb has to name what pressing does), so the span does.
     */
    function syncPlanBtn(): void {
      if (!planBtn) return;
      const entry = store.loadPlan().courses.find((c) => c.code === code);
      const program = entry?.source === "program";
      planBtn.textContent = !entry
        ? "Legg til i planen"
        : entry.dropped
          ? "Legg tilbake"
          : program
            ? "Dropp"
            : "Fjern fra planen";
      planBtn.classList.toggle("is-active", !!entry && !entry.dropped);
      if (planState) {
        planState.textContent = !entry
          ? ""
          : entry.dropped
            ? "droppet, men fortsatt en del av programmet"
            : program
              ? "fra studieprogrammet ditt"
              : "I planen";
        planState.hidden = !entry;
      }
    }

    // The verdict is recomputed on every plan change, and a stale in-flight
    // check must never overwrite a newer one.
    let clashToken = 0;
    async function renderClash(): Promise<void> {
      if (!clashSlot) return;
      const token = ++clashToken;
      const clashSemester = {
        id: semester.id,
        name: semester.name,
        teachingWeeks: semester.teachingWeeks,
      };
      // A course the current catalog does not offer has no entries that could
      // legitimately land in this semester's weeks — asserting that with `[]`
      // beats matching last year's grid against this year's week numbers.
      //
      // A course that IS offered hands over what the week drew, whichever
      // semester the student is planning: `planClash` clamps to that semester's
      // teaching weeks itself, so an autumn-only course planning spring still
      // resolves to "undervises ikke" — by intersection, not by assertion.
      // Withholding the entries whenever the planned year is not the catalog
      // year fabricated that verdict for courses that ARE taught then.
      const own = isOffered ? await timetable : [];
      const currentPlan = store.loadPlan();
      const verdict = await planClash(
        { code, version },
        currentPlan,
        clashSemester,
        own,
        currentPlan.program?.code ?? null,
      );
      if (token !== clashToken) return;
      clashSlot.replaceChildren(clashNode(verdict, clashSemester));
    }

    /**
     * The semester can change while this page is open — another tab's
     * studieinfo save writes `np:lastSemester` and fires the same event. Redraw
     * the week rather than leaving a grid built for the old semester under a
     * verdict that names the new one.
     */
    function syncSemester(): void {
      const next = plannedSemester();
      if (next.id === semester.id) return;
      semester = next;
      timetable = mountWeek();
    }

    planBtn?.addEventListener(
      "click",
      () => {
        const entry = store.loadPlan().courses.find((c) => c.code === code);
        if (!entry) store.addCourse({ code, name, version });
        else if (entry.dropped) store.restoreCourse(code);
        // `removeCourse` routes a programme course to `dropCourse` itself
        //, so the verb above and the write below cannot drift.
        else store.removeCourse(code);
        syncPlanBtn();
      },
      { signal },
    );

    signal.addEventListener(
      "abort",
      store.onPlanChange(() => {
        syncSemester();
        syncPlanBtn();
        renderClash();
      }),
    );
    syncPlanBtn();
    renderClash();
  });
</script>
