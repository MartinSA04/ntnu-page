<script
  is:inline
  type="application/json"
  id="planner-program-options"
  set:html={programOptionsJson}
/>
<script>
  import { mountPlannerApp, type SemesterSummary } from "../../components/planner/plannerApp.js";
  import {
    mountStudieinfo,
    OPEN_STUDIEINFO_EVENT,
  } from "../../components/planner/studieinfo.js";
  import { createPlanStore } from "../../lib/planner/store.js";
  import { onPage } from "../../lib/pageLifecycle.ts";
  import semestersData from "../../../data/semesters.json";

  // Must run per page-load, not once per module: under ClientRouter this
  // module is evaluated only the first time it is fetched, so mounting at
  // top level left the planner an empty shell after any in-site navigation
  // back to it ("the plan is gone").
  onPage((signal) => {
    const optionsEl = document.getElementById("planner-program-options");
    if (!optionsEl) return;
    const programOptions = optionsEl.textContent ? JSON.parse(optionsEl.textContent) : [];
    mountPlannerApp(semestersData, programOptions, signal);

    // TEMPORARY dev wiring (Task 6). Task 10 unifies this with plannerApp's
    // own candidate-semester slice; for now compute the same "current + next
    // two" list inline (teaching ids, sorted by fromDate, from current).
    const defaultSemesterId = semestersData.current?.id ?? "26h";
    const teaching = (semestersData.semesters as SemesterSummary[]).filter((s) =>
      /^\d{2}[hv]$/i.test(s.id),
    );
    teaching.sort((a, b) => (a.fromDate ?? "").localeCompare(b.fromDate ?? ""));
    const today = new Date().toISOString().slice(0, 10);
    const currentIndex = semestersData.current
      ? teaching.findIndex((s) => s.id === semestersData.current?.id)
      : teaching.findIndex((s) => (s.fromDate ?? "") >= today);
    const start = currentIndex >= 0 ? currentIndex : 0;
    const candidateSemesters = teaching.slice(start, start + 3);

    const store = createPlanStore(defaultSemesterId);
    mountStudieinfo(
      { store, semesters: candidateSemesters, programOptions, defaultSemesterId },
      signal,
    );
    document
      .getElementById("planner-dev-studieinfo")
      ?.addEventListener("click", () => {
        window.dispatchEvent(new CustomEvent(OPEN_STUDIEINFO_EVENT));
      });
  });
</script>
