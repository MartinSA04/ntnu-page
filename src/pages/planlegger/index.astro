---
import programsData from "../../../data/programs.json";
import Layout from "../../layouts/Layout.astro";
// The week's geometry and ink live in one stylesheet because two surfaces
// render it through the same `renderGrid` (/planlegger/ and /emne/[code]/).
// Only this page's scroll-edge mask and the exam list stay scoped below.
import "../../styles/planner-week.css";

const description =
  "Velg studieprogram og kull, se ukeplanen med en gang: forelesninger, kollisjoner, eksamensdatoer og studiepoeng.";

// Trimmed tuples: the picker needs identity plus the field that tells two
// same-named programmes apart (B6 — MIDT and MTDT are both "Datateknologi",
// with opposite outcomes), not the full crawled record; this ships to every
// visitor. Same tuple as the homepage picker (src/pages/index.astro): the two
// ask the same question and must not disagree about what a row shows.
const programOptions: [code: string, name: string, studyLevel: string, cities: string[]][] =
  programsData.programs
    .map((p): [string, string, string, string[]] => [
      p.code,
      p.name,
      p.studyLevel ?? "",
      p.cities ?? [],
    ])
    .sort((a, b) => a[1].localeCompare(b[1], "nb"));

// `JSON.stringify` escapes neither "<" nor "/", so an upstream programme name
// containing "</script" would close this tag and everything after it would be
// parsed as markup (C5c). < is a legal JSON escape, so the payload stays
// valid JSON and the parser sees the original character.
const programOptionsJson = JSON.stringify(programOptions).replaceAll("<", "\\u003c");
---

<Layout title="Planlegger — Semesterplan" description={description} wide>
  <div class="planner-banner">
    {/* No "Planlegger" kicker: the topbar names the page and the title answers
        "whose plan is this" on its own. It was the first of seven uppercase
        mono labels competing down the page. */}
    <h1 class="planner-title" id="planner-title">Semesterplan</h1>
    <p class="np-hint planner-context-line" id="planner-context-line"></p>

    {/* PRODUCT §1 makes the collision verdict the page's primary job, and it
        used to be 0.84 rem of muted text wedged between a kicker and a toggle.
        The credit total sat here too until it got a drawing of its own — a
        drawn number belongs beside the thing it is drawn from, so it moved
        down to the course list with its strip (REWORK-2026-07-29d). */}
    <p class="planner-status" id="planner-status">
      <span class="planner-verdict" id="planner-grid-status" aria-live="polite"></span>
    </p>
  </div>

  <p class="np-hint planner-link-note" id="planner-link-note" hidden></p>

  <div id="planner-main">
    {/* The week runs the page's full width and the other two share the row
        under it. Transposing the grid is what made that possible: the week is
        ~290 px tall now instead of 768, so everything fits without a side rail
        stealing a third of the axis — the rail was starving the grid to 864 px
        of 1440 while its own column sat empty below the fold. It also retires
        the Uke/Emner tabs, which existed so a phone did not have to scroll
        past a very tall week. */}
    <section class="planner-week" id="planner-region-week" aria-labelledby="planner-week-heading">
      <div class="np-panel planner-direction" id="planner-direction" hidden>
        <h2 class="planner-direction-title" id="planner-direction-title"></h2>
        <p class="np-hint planner-direction-note" id="planner-direction-note"></p>
        <div class="planner-direction-actions" id="planner-direction-actions" hidden>
          <button type="button" class="np-btn" id="planner-direction-btn">Velg emner</button>
        </div>
      </div>

      <div class="planner-section-head">
        <h2 class="planner-section-name" id="planner-week-heading">Uke</h2>
        <div class="planner-section-tools">
          <div class="planner-view-tabs" role="group" aria-label="Vis uka som rutenett eller liste">
            <button
              type="button"
              class="np-toggle planner-view-tab"
              id="planner-view-uke"
              aria-pressed="true"
            >
              Rutenett
            </button>
            <button
              type="button"
              class="np-toggle planner-view-tab"
              id="planner-view-tavle"
              aria-pressed="false"
            >
              Liste
            </button>
          </div>
          <button
            type="button"
            class="np-toggle planner-others-toggle"
            id="planner-others-toggle"
            aria-pressed="false"
          >
            Vis øvinger og labber
          </button>
        </div>
      </div>
      <p class="np-hint planner-scroll-hint" id="planner-scroll-hint" hidden></p>
      <div class="planner-grid-frame" id="planner-grid-frame"></div>
      <div class="planner-grid-notes" id="planner-grid-notes"></div>
    </section>

    <div class="planner-below">
      <section class="planner-exams" aria-labelledby="planner-exam-heading">
        <div class="planner-section-head">
          <h2 class="planner-section-name" id="planner-exam-heading">Eksamener</h2>
          <p class="planner-section-sub" id="planner-exam-status" aria-live="polite"></p>
        </div>
        <div class="planner-exam-list" id="planner-exam-list-host"></div>
      </section>

      <section class="planner-courses" id="planner-region-courses" aria-labelledby="planner-courses-heading">
        <div class="planner-section-head">
          <h2 class="planner-section-name" id="planner-courses-heading">Emner</h2>
        </div>

        {/* The load, drawn: 30 sp as a track, each course a segment in its own
            hue. Same shape as the exam band over the exam list. */}
        <div class="planner-load" id="planner-credit-strip" aria-hidden="true" hidden></div>
        <p class="planner-load-foot">
          <span class="np-data planner-credit-line" id="planner-credit-line">0 av 30 sp</span>
        </p>
        <p class="np-hint planner-credit-note" id="planner-credit-note" hidden></p>

        <div class="planner-course-rows" id="planner-course-rows"></div>

        <p class="planner-gap-line" id="planner-gap-line" hidden>
          <span class="np-note" id="planner-gap-text"></span>
          <button type="button" class="np-btn planner-gap-btn" id="planner-gap-btn">
            Velg fra studieplanen
          </button>
        </p>

        <button type="button" class="np-btn planner-add-course-btn" id="planner-add-course-btn">
          Legg til emne
        </button>

        <details class="planner-plan-panel" id="planner-plan-panel" hidden>
          <summary class="np-summary planner-plan-summary">Fra studieplanen</summary>
          <div class="planner-plan-body" id="planner-plan-body"></div>
        </details>
      </section>
    </div>

    <p class="np-hint planner-provenance" id="planner-provenance"></p>
  </div>
</Layout>

<style>
  /* --- Banner ------------------------------------------------------------ */

  /* Facts only. The one control that changes any of them is the topbar
     studieinfo chip (Layout.astro) — the banner used to carry a second
     "Endre" button and the title itself was a third, all three opening the
     same modal. */
  .planner-banner {
    margin-bottom: var(--space-4);
  }

  /* The plan's two outputs, on one line under the identity. Set as figures,
     not as footnotes: PRODUCT §1 makes the verdict the page's primary job. */
  .planner-status {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--gap-2) var(--gap-4);
    margin-top: var(--space-3);
  }

  .planner-verdict {
    font-size: var(--text-md);
  }

  .planner-verdict:empty {
    display: none;
  }

  /* The page title IS the answer to "whose plan is this" (D2/A1). The
     programme name is set in the grotesk at the page-title step; the code
     rides beside it in mono, because that is the part a student copies. */
  .planner-title {
    display: flex;
    align-items: baseline;
    gap: var(--gap-3);
    flex-wrap: wrap;
  }

  :global(.planner-title-code) {
    font-size: var(--text-md);
    color: var(--muted);
  }

  .planner-context-line {
    max-width: none;
    margin-top: var(--space-1);
  }

  /* The unanswered studieretning, pulled out of a muted line. It asks you to
     do something; it does not say the term works — so it is ink, not the
     verdict green (REWORK-2026-07-30). */
  :global(.planner-context-direction) {
    color: var(--ui);
  }

  .planner-link-note:not([hidden]) {
    max-width: none;
    margin-bottom: var(--space-4);
  }

  /* --- Layout ------------------------------------------------------------ */

  /* The week takes the page's whole width; Eksamener and Emner share the row
     under it. This is what transposing the grid bought: the week is ~290 px
     tall instead of 768, so a side rail is no longer the only way to see the
     plan and the week at once — and the rail was costing the week a third of
     its axis (864 px of 1440) while its own column ran out of content four
     hundred pixels above the fold.

     It also retires the Uke/Emner tabs. They existed because a phone could not
     scroll past a 768 px week to reach the course list; it can scroll past
     290 px. */
  #planner-main {
    display: grid;
    gap: var(--space-7);
  }

  .planner-week,
  .planner-exams,
  .planner-courses {
    min-width: 0;
  }

  .planner-below {
    display: grid;
    gap: var(--space-7);
  }

  @media (min-width: 60rem) {
    .planner-below {
      /* Exams first: they are time-ordered, so they rhyme with the week above
         them. The course list wants a measure rather than a fraction — it only
         ever holds a code, a name and a credit figure. */
      grid-template-columns: minmax(0, 1fr) 22rem;
      align-items: start;
      gap: var(--space-8);
    }
  }

  @media (min-width: 84rem) {
    .planner-below {
      grid-template-columns: minmax(0, 1fr) 26rem;
    }
  }

  /* --- The week's open question ------------------------------------------ */

  /* Studieretning, campus, or "your period is all electives" (B2/U8). It sits
     above the grid because the same question behind a tab is a dead end. */
  .planner-direction:not([hidden]) {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  /* A title, not a kicker: "Studieplanen din for Høst 2026 er valgfri" is a
     sentence, and 11.5 px uppercase tracked mono is where D10 draws the line. */
  .planner-direction-title {
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
    letter-spacing: normal;
  }

  .planner-direction-note {
    margin: 0;
    max-width: none;
  }

  .planner-direction-actions:not([hidden]) {
    margin-top: var(--space-1);
  }

  /* --- Section headers --------------------------------------------------- */

  /* A section head is a NAME and its controls, divided by a rule — not four
     unrelated things on one line. The week's used to carry a mono kicker, the
     verdict, two view toggles and the øving toggle side by side, with a
     four-hundred-pixel gap in the middle of it. */
  .planner-section-head {
    display: flex;
    align-items: baseline;
    gap: var(--gap-3) var(--gap-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border-strong);
  }

  /* The grotesk at a real size, not 0.72 rem of tracked-out uppercase mono.
     Four of those competed down the page and none of them was a heading;
     Data-Is-Mono means the mono is for times, dates, codes and counts, so
     spending it on section labels was spending the rule's meaning too. */
  .planner-section-name {
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
    letter-spacing: -0.015em;
  }

  /* Controls sit at the far end of the rule, grouped, so the head reads
     "name … tools" rather than as a row of equal-weight chips. */
  .planner-section-tools {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--gap-2) var(--gap-3);
    margin-left: auto;
  }

  /* The default ink is set at ZERO specificity on purpose, and that is what
     `:global(:where(…))` buys. Astro scopes this block by appending
     [data-astro-cid-…], so a plain `.planner-section-sub { color: var(--muted) }`
     here computed (0,2,0) and outranked `.np-note-clash` (0,1,0): the flagship
     verdict "1 kollisjon denne uka" printed in the page's quietest gray in BOTH
     themes while the no-collision state was green — the emphasis inverted
     exactly where DESIGN's Red-Is-Collision rule says it must not be
     (a11y-4 / ds-2). `:where()` alone is not enough: the attribute strategy
     emits `[data-astro-cid-…]:where(.planner-section-sub)`, which is (0,1,0)
     again and would TIE with the primitive, leaving the verdict's colour to
     depend on which stylesheet Vite emitted first. `:global()` drops the
     attribute, so this really is (0,0,0) and every state class below wins. */
  :global(:where(.planner-section-sub, .planner-verdict)) {
    color: var(--muted);
  }

  .planner-section-sub {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
  }

  .planner-section-sub:empty {
    display: none;
  }

  /* --- Rutenett ⇄ Liste (REWORK-2026-07-29b D2) --------------------------- */

  /* Two views of one week. They sit in the section head beside the verdict
     because that is what they change; the toggles are `.np-toggle`, so the
     pressed state is the primitive's accent fill and nothing new is invented
     for it. */
  /* One control with two states, so it joins into a single segmented unit —
     three separately-spaced chips in a row read as three peers, and the
     øving toggle is not a peer of these two. It switches the layer the week
     draws; they switch how the week is drawn. */
  .planner-view-tabs {
    display: flex;
    gap: 1px;
    background: var(--border);
    border-radius: var(--radius-xs);
    overflow: hidden;
  }

  :global(.planner-view-tab) {
    padding-inline: var(--space-4);
    border-radius: 0;
  }

  /* The gap that says "different kind of control" — wider than any gap inside
     either group. */
  .planner-section-tools {
    gap: var(--gap-2) var(--space-5);
  }

  /* The verdict (U4): PRODUCT §1's primary job answered beside the kicker,
     in three states and three inks:
       .is-clean       — accent, the week holds together (Green-Means-Fits)
       .np-note-clash  — --clash, two things cannot coexist (Red-Is-Collision)
       neither         — the muted default above: "kan ikke sjekkes — mangler
                         timeplan for N emner". A gap is not a clash and not a
                         pass, so it may spend neither colour (DESIGN §2:
                         fetch errors and empty states are ink, not red).
     `.is-clean` keeps its `:global()` because it is added from plannerApp, not
     written in this template; it now merely has to beat :where(), not (0,2,0). */
  :global(.planner-section-sub.is-clean),
  :global(.planner-verdict.is-clean) {
    color: var(--verdict);
  }

  .planner-credit-line {
    font-size: var(--text-md);
    color: var(--muted);
    transition: color var(--dur-fast) var(--ease);
  }

  /* Green means it fits — exactly a full load, never an overload. "37,5 av
     30 sp" in the same green as 30 tells the student the opposite of the
     truth (B9.3); the overload keeps neutral ink and explains itself in
     .planner-credit-note below. */
  .planner-credit-line.is-full {
    color: var(--verdict);
  }

  .planner-credit-note:not([hidden]) {
    max-width: none;
    margin-bottom: var(--space-3);
  }

  /* --- Weekly grid --------------------------------------------------------- */

  /* The week's own geometry and ink are in src/styles/planner-week.css, shared
     with /emne/[code]/ — and so, since mob-2, is the scroll-edge mask: it used
     to live here, which is exactly how /emne/[code]/ ended up clipping its
     Friday column at 360 px with no fade at all. What follows is only what
     this page adds. */

  .planner-scroll-hint:not([hidden]) {
    margin-bottom: var(--space-2);
  }

  /* --- Empty / fallback week card ---------------------------------------- */

  /* The four empty states (no plan, unpublished, fetch failure, nothing this
     term) that carry an action. Centered in the (now unruled) week frame so
     the one next step is where the plan would be, not tucked under it. */
  :global(.planner-week-card) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-6) var(--space-3);
    text-align: center;
  }

  :global(.planner-week-card-hint) {
    margin: 0;
    max-width: var(--measure);
  }

  :global(.planner-week-card-secondary) {
    /* A quiet text action under the primary button, not a second button. */
    font-size: var(--text-sm);
  }

  /* --- Exam list ---------------------------------------------------------- */

  /* The dated list and nothing above it: the "5 eksamener over 26 dager"
     summary and the ruled frame it sat in are gone. The dates already say
     how many exams there are and how far apart they fall. */
  :global(.exam-empty) {
    margin: 0 0 var(--space-2);
  }

  .planner-exam-list {
    margin-bottom: var(--space-6);
  }

  /* --- The month band (REWORK-2026-07-29c) ------------------------------- */

  /* One row per month, one cell per day. It answers "how clustered is this"
     before a date is read, for about 40 px. */
  :global(.exam-band) {
    display: grid;
    gap: var(--gap-1);
    margin-bottom: var(--space-4);
  }

  :global(.exam-band-row) {
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr);
    align-items: center;
    gap: 0 var(--gap-3);
  }

  :global(.exam-band-name) {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking);
    text-transform: uppercase;
    color: var(--faint);
    text-align: right;
  }

  :global(.exam-band-days) {
    display: grid;
    grid-template-columns: repeat(31, minmax(0, 1fr));
    gap: 2px;
  }

  :global(.exam-band-day) {
    height: 13px;
    background: var(--card);
    border-radius: 1px;
  }

  /* The weekend ground is what makes a cluster look like a cluster rather than
     four evenly-spaced marks — one tonal step was invisible at 9 px. */
  :global(.exam-band-day.is-weekend) {
    background: color-mix(in srgb, var(--fg) 15%, var(--card));
  }

  /* Days past the end of a short month: nothing there, not an empty day. */
  :global(.exam-band-day.is-void) {
    background: transparent;
  }

  /* A colliding day keeps BOTH courses' hues (examList.ts sets the split fill
     inline) and takes a ring instead of a red fill. A flat red square says
     "something collides" and throws away the fact you would act on — which
     two. The ring is a different KIND of mark from a fill, which is what lets
     it out-shout five hues without erasing them (Red-Is-Collision). */
  :global(.exam-band-day.is-clash) {
    box-shadow: 0 0 0 1px var(--clash);
  }

  /* --- The list: one rule, and it runs along the list -------------------- */

  /* Three gaps used to draw NINE horizontal rules — each connector had a
     border above, a border below and a bar through the middle. A rule across a
     list divides it; a gap is not a division between two exams, it is the
     distance between them, and distance runs along the list. So the only rule
     left is vertical, the exams are knots on it, and the gaps hang between
     them. */
  :global(.exam-list) {
    --exam-date-col: 6.5rem;
    --exam-knot: 20px;
    position: relative;
    list-style: none;
    max-width: none;
    margin: 0;
    padding: 0;
  }

  :global(.exam-list)::before {
    content: "";
    position: absolute;
    left: calc(var(--exam-date-col) + var(--gap-4) + 3px);
    top: 1.1em;
    bottom: 1.1em;
    width: 1px;
    background: var(--border-strong);
  }

  /* Two columns: the date, then the exam. A dated row has nothing else to say
     — the countdown that used to need a third one is a segment on the rule now
     (`awayLine`). Keeping the column "just in case" was not free either: an
     `auto` track collapses to zero, but its gap does not, and those 16 px were
     exactly what pushed "Skriftlig skoleeksamen" onto a second line at 390 px. */
  :global(.exam-row) {
    display: grid;
    grid-template-columns: var(--exam-date-col) minmax(0, 1fr);
    align-items: baseline;
    gap: 0 var(--gap-4);
    padding: var(--space-1) 0;
  }

  /* The one row that still has a third thing to say. */
  :global(.exam-row.exam-dateless) {
    grid-template-columns: var(--exam-date-col) minmax(0, 1fr) auto;
  }

  :global(.exam-date) {
    text-align: right;
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
    letter-spacing: -0.02em;
  }

  :global(.exam-weekday) {
    font-size: var(--text-xs);
    font-weight: var(--weight-normal);
    color: var(--faint);
    margin-inline-end: var(--gap-1);
  }

  :global(.exam-what) {
    position: relative;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0 var(--gap-2);
    min-width: 0;
    padding-inline-start: var(--exam-knot);
  }

  /* The knot: the same mark as the course list's own dot, so a colour means
     one thing wherever it appears. */
  :global(.exam-what)::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    top: 0.35em;
    width: 7px;
    height: 7px;
    background: var(--dot);
  }

  :global(.exam-code) {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  /* Vurderingsform (D6): whether a date is something to revise for or
     something to hand in. */
  :global(.exam-form) {
    min-width: 0;
    font-size: var(--text-sm);
    color: var(--muted);
  }

  /* "dato ikke satt", and nothing else — see `.exam-row.exam-dateless`. */
  :global(.exam-away) {
    font-size: var(--text-xs);
    color: var(--faint);
    white-space: nowrap;
  }

  /* The distance, hung on the rule between two knots. */
  :global(.exam-gap) {
    padding: var(--space-1) 0 var(--space-1)
      calc(var(--exam-date-col) + var(--gap-4) + var(--exam-knot));
    font-size: var(--text-xs);
    color: var(--faint);
  }

  /* The first segment — today to the next exam. Same rule, same indent as the
     lesedager connectors below it, so the list reads as one chain of
     distances; never `is-tight`'s red, because how far off an exam is says
     nothing about how much room there is to revise. */
  :global(.exam-gap.is-away) {
    color: var(--muted);
  }

  :global(.exam-gap.is-tight) {
    color: var(--clash);
    font-weight: var(--weight-medium);
  }

  :global(.exam-dateless) :global(.exam-date) {
    color: var(--faint);
  }

  /* Named in words, because the split cell and the ring are the fast read but
     neither survives a screen reader, a printout or colour blindness. */
  :global(.exam-clash) {
    margin: var(--space-3) 0 0;
    padding-inline-start: calc(var(--exam-date-col) + var(--gap-4) + var(--exam-knot));
  }

  /* --- The load strip (REWORK-2026-07-29d) ------------------------------ */

  /* Same shape as the exam band over the exam list: a drawing that answers the
     section's question, then the rows that answer it precisely. */
  .planner-load:not([hidden]) {
    display: block;
    margin-bottom: var(--space-2);
  }

  :global(.planner-load-track) {
    display: flex;
    gap: 2px;
    height: 15px;
    background: var(--card);
    border-radius: var(--radius-xs);
    overflow: hidden;
  }

  /* Printed ink, exactly like a week bar and an exam-band cell, so one course
     is one colour in all three places. `flex-grow` is the credits, written
     inline by `renderCreditStrip`. */
  :global(.planner-load-seg) {
    flex-basis: 0;
    background: color-mix(in srgb, var(--dot) var(--block-mix), var(--block-base));
  }

  /* The gap to a full load is empty track, never a segment — it is the absence
     of a course and must not read as one. */
  :global(.planner-load-rest) {
    flex-basis: 0;
  }

  .planner-load-foot {
    margin-bottom: var(--space-4);
  }

  /* --- Course rows ------------------------------------------------------- */

  .planner-course-rows {
    display: flex;
    flex-direction: column;
    margin-bottom: var(--space-3);
  }

  /* Four columns — chip, name, credits, settings — and NO horizontal rule.
     Five courses used to draw five borders, dividing up what is one thing:
     your semester. A vertical rule was tried instead and rejected for saying
     something untrue: a rule with knots on it encodes *sequence*, and a course
     list is a set, not a timeline (the exam list is the one with an order).

     The row itself is inert. It used to be a full-width `<button>`, which gave
     the whole row a pointer cursor and a hover wash while showing nothing that
     looked pressable — an affordance the row's appearance never promised. The
     one target is the settings button at its end. */
  :global(.planner-course-row) {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 0 var(--gap-3);
    padding: var(--space-2) 0;
  }

  /* The one interactive thing in the row, and it looks it: a real target at
     the touch size the tokens already define, revealed to full ink on hover.
     It is quiet at rest because five of them down a rail would out-shout the
     courses they belong to. */
  :global(.planner-course-open) {
    color: var(--faint);
    flex: none;
    transition:
      color var(--dur-fast) var(--ease),
      background var(--dur-fast) var(--ease);
  }

  :global(.planner-course-open:hover) {
    color: var(--fg);
    background: var(--wash);
  }

  :global(.planner-course-open svg) {
    width: 16px;
    height: 16px;
  }

  /* The chip is the week's own bar at label size: printed hue, code knocked
     out of it. */
  :global(.planner-course-chip) {
    display: inline-flex;
    align-items: center;
    height: 20px;
    padding: 0 var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: -0.01em;
    white-space: nowrap;
    border-radius: var(--radius-xs);
    background: color-mix(in srgb, var(--dot) var(--block-mix), var(--block-base));
    color: var(--on-block);
  }

  /* A dropped course is still a course: the chip keeps its shape and loses its
     fill, so the row reads as switched off rather than as missing (§0.3). */
  :global(.planner-course-row.is-dropped .planner-course-chip) {
    background: transparent;
    color: var(--faint);
    box-shadow: inset 0 0 0 1px var(--border-strong);
  }

  /* `anywhere` is the floor, not the plan: with the full measure almost every
     name wraps at a space, but a single 21-character word is still wider than
     the rail at the narrowest widths it reaches. */
  :global(.planner-course-name) {
    display: grid;
    gap: 1px;
    min-width: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    overflow-wrap: anywhere;
  }

  :global(.planner-course-row.is-dropped .planner-course-title) {
    color: var(--faint);
    text-decoration: line-through;
    text-decoration-color: var(--border-strong);
  }

  /* Right-aligned in its own column so the figures stack into something a
     student can add up by eye — which is the only reason this list quotes
     credits at all. */
  :global(.planner-course-sp) {
    font-size: var(--text-xs);
    color: var(--faint);
    text-align: right;
    white-space: nowrap;
  }

  /* The attention mark sits under the name, so the credit column stays a
     column of figures. Ink, not red — it is an invitation to open the row, and
     Red-Is-Collision keeps red for two things that cannot coexist. Not green
     either: "se detaljer" is a thing to do, not a verdict (REWORK-2026-07-30). */
  :global(.planner-course-flag) {
    font-size: var(--text-xs);
    color: var(--ui);
  }

  /* --- Credit gap door --------------------------------------------------- */

  .planner-gap-line:not([hidden]) {
    display: flex;
    align-items: baseline;
    gap: var(--gap-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-4);
  }

  /* --- Add-course button --------------------------------------------------
     The inline typeahead is gone (Task 12) — one button opens the dialog
     addCourse.ts builds itself (its CSS lives in site.css, alongside the
     studieinfo modal it's modeled on). */

  .planner-add-course-btn {
    align-self: flex-start;
  }

  /* --- "Fra studieplanen" panel -----------------------------------------
     Design §8: the study plan's choice groups with their VERBATIM prose
     (DR-5 — never assert "group satisfied"), collapsed by default so it never
     buries the plan itself. Only shown when a programme is set and the period
     has choice groups. Rows reuse the add-dialog's code · name · credits +
     add-affordance pattern, simplified. */
  .planner-plan-panel {
    margin-top: var(--space-4);
  }

  :global(.planner-plan-group) {
    margin-top: var(--space-3);
  }

  :global(.planner-plan-group-name) {
    margin-bottom: var(--space-1);
  }

  :global(.planner-plan-group-desc) {
    max-width: none;
    margin-bottom: var(--space-2);
  }

  :global(.planner-plan-row) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    column-gap: var(--gap-3);
    row-gap: var(--space-1);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--border);
  }

  :global(.planner-plan-row-head) {
    grid-column: 1;
    display: inline-flex;
    align-items: baseline;
    gap: var(--gap-2);
    flex-wrap: wrap;
  }

  :global(.planner-plan-row-name) {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  :global(.planner-plan-row-meta) {
    grid-column: 1 / -1;
    color: var(--muted);
    font-size: var(--text-xs);
  }

  :global(.planner-plan-add) {
    grid-column: 2;
    grid-row: 1;
    justify-self: end;
  }

  .planner-provenance {
    max-width: none;
    margin-top: var(--space-6);
  }
</style>

<script
  is:inline
  type="application/json"
  id="planner-program-options"
  set:html={programOptionsJson}
/>
<script>
  import { mountPlannerApp } from "../../components/planner/plannerApp.js";
  import { onPage } from "../../lib/pageLifecycle.ts";
  import semestersData from "../../../data/semesters.json";

  // Must run per page-load, not once per module: under ClientRouter this
  // module is evaluated only the first time it is fetched, so mounting at
  // top level left the planner an empty shell after any in-site navigation
  // back to it ("the plan is gone"). `mountPlannerApp` owns the single store
  // and mounts the studieinfo modal + block popover itself.
  onPage((signal) => {
    const optionsEl = document.getElementById("planner-program-options");
    if (!optionsEl) return;
    const programOptions = optionsEl.textContent ? JSON.parse(optionsEl.textContent) : [];
    mountPlannerApp(semestersData, programOptions, signal);
  });
</script>
