---
import programsData from "../../../data/programs.json";
import Layout from "../../layouts/Layout.astro";
// The week's geometry and ink live in one stylesheet because two surfaces
// render it through the same `renderGrid` (/planlegger/ and /emne/[code]/).
// Only this page's scroll-edge mask and the exam ribbon stay scoped below.
import "../../styles/planner-week.css";

const description =
  "Velg studieprogram og kull, se ukeplanen med en gang: forelesninger, kollisjoner, eksamensdatoer og studiepoeng.";

// Trimmed tuples: the picker needs identity plus the field that tells two
// same-named programmes apart (B6 — MIDT and MTDT are both "Datateknologi",
// with opposite outcomes), not the full crawled record; this ships to every
// visitor. Same tuple as the homepage picker (src/pages/index.astro): the two
// ask the same question and must not disagree about what a row shows.
const programOptions: [code: string, name: string, studyLevel: string, cities: string[]][] =
  programsData.programs
    .map((p): [string, string, string, string[]] => [
      p.code,
      p.name,
      p.studyLevel ?? "",
      p.cities ?? [],
    ])
    .sort((a, b) => a[1].localeCompare(b[1], "nb"));

// `JSON.stringify` escapes neither "<" nor "/", so an upstream programme name
// containing "</script" would close this tag and everything after it would be
// parsed as markup (C5c). < is a legal JSON escape, so the payload stays
// valid JSON and the parser sees the original character.
const programOptionsJson = JSON.stringify(programOptions).replaceAll("<", "\\u003c");
---

<Layout title="Planlegger — Semesterplan" description={description} wide>
  <div class="planner-banner">
    <div class="planner-banner-main">
      <p class="np-kicker planner-kicker">Planlegger</p>
      <h1 class="planner-title" id="planner-title">Semesterplan</h1>
      <p class="np-hint planner-context-line" id="planner-context-line"></p>
    </div>
    <div class="planner-banner-controls">
      <button
        type="button"
        class="np-btn planner-context-change"
        id="planner-context-change"
        aria-expanded="false"
        aria-controls="planner-picker"
      >
        Velg studieprogram
      </button>
      <!-- TEMPORARY dev entry (Task 6). The inline picker above and this
           button are both deleted in Task 10, which makes the studieinfo
           modal the only way in. -->
      <button type="button" class="np-btn" id="planner-dev-studieinfo">Endre studieinfo</button>
    </div>
  </div>

  <p class="np-hint planner-link-note" id="planner-link-note" hidden></p>

  <details class="planner-semester" id="planner-semester">
    <summary class="np-summary planner-semester-summary">Bytt semester</summary>
    <div
      class="planner-semester-toggle"
      id="planner-semester-toggle"
      role="group"
      aria-label="Velg semester"
    >
    </div>
  </details>

  <section class="np-panel planner-picker" id="planner-picker" hidden aria-labelledby="planner-picker-heading">
    <h2 class="np-kicker planner-picker-kicker" id="planner-picker-heading">Studieprogram</h2>
    <form class="np-field planner-picker-field" id="planner-picker-field" autocomplete="off">
      <input
        type="text"
        id="planner-picker-input"
        placeholder="Søk etter studieprogram …"
        aria-label="Søk etter studieprogram"
        role="combobox"
        aria-expanded="false"
        aria-autocomplete="list"
        aria-controls="planner-picker-listbox"
      />
    </form>
    <ul
      class="np-popover planner-picker-listbox"
      id="planner-picker-listbox"
      role="listbox"
      aria-label="Studieprogramforslag"
      hidden
    >
    </ul>
    <div class="planner-picker-kull" id="planner-picker-kull" hidden>
      <p class="np-kicker">Kull</p>
      <div class="planner-picker-kull-chips" id="planner-picker-kull-chips" role="group" aria-label="Velg kull"></div>
      <p class="np-hint planner-picker-kull-hint">Kull = året du startet på studiet.</p>
    </div>
    <p class="np-hint" id="planner-picker-status" aria-live="polite"></p>
  </section>

  <div id="planner-main">
    <div class="planner-tabs" id="planner-tabs" role="group" aria-label="Bytt mellom uke og emner">
      <button
        type="button"
        class="np-toggle planner-tab"
        id="planner-tab-week"
        aria-pressed="true"
      >
        Uke
      </button>
      <button
        type="button"
        class="np-toggle planner-tab"
        id="planner-tab-courses"
        aria-pressed="false"
      >
        Emner
      </button>
    </div>

    <div class="planner-regions" id="planner-regions" data-region="week">
      <section class="planner-region planner-region-week" id="planner-region-week" aria-labelledby="planner-week-heading">
        <div class="np-panel planner-direction" id="planner-direction" hidden>
          <h2 class="planner-direction-title" id="planner-direction-title"></h2>
          <p class="np-hint planner-direction-note" id="planner-direction-note"></p>
          <div
            class="planner-direction-chips"
            id="planner-direction-chips"
            role="group"
            aria-label="Velg studieretning"
          >
          </div>
          <div class="planner-direction-actions" id="planner-direction-actions" hidden>
            <button type="button" class="np-btn" id="planner-direction-btn">Velg emner</button>
          </div>
        </div>

        <div class="planner-section-head">
          <h2 class="np-kicker" id="planner-week-heading">Ukeplan</h2>
          <p class="planner-section-sub" id="planner-grid-status" aria-live="polite"></p>
          <button
            type="button"
            class="np-toggle planner-others-toggle"
            id="planner-others-toggle"
            aria-pressed="false"
          >
            Vis øvinger og labber
          </button>
        </div>
        <p class="np-hint planner-scroll-hint" id="planner-scroll-hint" hidden></p>
        <div class="np-frame np-ruled np-ruled--hours planner-grid-frame" id="planner-grid-frame"></div>
        <div class="planner-grid-notes" id="planner-grid-notes"></div>

        <div class="planner-section-head">
          <h2 class="np-kicker" id="planner-exam-heading">Eksamener</h2>
          <p class="np-data planner-section-sub" id="planner-exam-window"></p>
          <p class="planner-section-sub" id="planner-exam-status" aria-live="polite"></p>
        </div>
        <div class="np-frame np-ruled planner-exam-frame" id="planner-exam-frame"></div>
        <div class="planner-exam-list" id="planner-exam-list-host"></div>
      </section>

      <section class="planner-region planner-region-courses" id="planner-region-courses" aria-labelledby="planner-courses-heading">
        <div class="planner-section-head">
          <h2 class="np-kicker" id="planner-courses-heading">Emner</h2>
          <span class="np-data planner-credit-line" id="planner-credit-line">0 av 30 sp</span>
        </div>
        <p class="np-hint planner-credit-note" id="planner-credit-note" hidden></p>

        <div class="planner-course-rows" id="planner-course-rows"></div>

        <p class="planner-gap-line" id="planner-gap-line" hidden>
          <span class="np-note" id="planner-gap-text"></span>
          <button type="button" class="np-btn planner-gap-btn" id="planner-gap-btn">
            Velg fra studieplanen
          </button>
        </p>

        <div class="planner-add-block" id="planner-add-block">
          <form class="np-field planner-add-field" id="planner-add-field" autocomplete="off">
            <input
              type="text"
              id="planner-add-input"
              placeholder="+ legg til emne …"
              aria-label="Legg til emne i planen"
              role="combobox"
              aria-expanded="false"
              aria-autocomplete="list"
              aria-controls="planner-add-listbox"
            />
          </form>
          <div class="planner-scope" id="planner-scope" role="group" aria-label="Hvor det søkes">
            <button type="button" class="np-toggle" id="planner-scope-plan" aria-pressed="true">
              Fra studieplanen
            </button>
            <button type="button" class="np-toggle" id="planner-scope-all" aria-pressed="false">
              Alle emner
            </button>
          </div>
          <p class="np-hint planner-scope-note" id="planner-scope-note" hidden></p>
          <ul
            class="np-popover planner-add-listbox"
            id="planner-add-listbox"
            role="listbox"
            aria-label="Emneforslag"
            hidden
          >
          </ul>
        </div>
      </section>
    </div>

    <p class="np-hint planner-provenance" id="planner-provenance"></p>
  </div>
</Layout>

<style>
  /* --- Banner ------------------------------------------------------------ */

  .planner-banner {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--gap-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-4);
  }

  .planner-kicker {
    margin-bottom: var(--space-1);
  }

  /* The page title IS the answer to "whose plan is this" (D2/A1). The
     programme name is set in the grotesk at the page-title step; the code
     rides beside it in mono, because that is the part a student copies. */
  .planner-title {
    display: flex;
    align-items: baseline;
    gap: var(--gap-3);
    flex-wrap: wrap;
  }

  :global(.planner-title-code) {
    font-size: var(--text-md);
    color: var(--muted);
  }

  :global(.planner-title a) {
    color: inherit;
    text-decoration-color: color-mix(in srgb, var(--accent) 40%, transparent);
  }

  :global(.planner-title a:hover) {
    color: var(--accent-ink);
  }

  .planner-context-line {
    max-width: none;
    margin-top: var(--space-1);
  }

  :global(.planner-context-direction) {
    color: var(--accent-ink);
  }

  .planner-banner-controls {
    display: flex;
    align-items: center;
    gap: var(--gap-3);
    flex-wrap: wrap;
  }

  .planner-link-note:not([hidden]) {
    max-width: none;
    margin-bottom: var(--space-4);
  }

  /* --- Semester disclosure ---------------------------------------------- */

  /* DR-9/U6: the tool resolves the plannable term itself and states it in the
     context line. Switching is still available, but it is a disclosure rather
     than the fold's loudest control — two of the three terms it offers have
     no published timetable, and each says so on its own chip. */
  .planner-semester {
    margin-bottom: var(--space-5);
  }

  .planner-semester-summary {
    display: inline-flex;
  }

  .planner-semester-toggle {
    display: flex;
    gap: var(--gap-3);
    flex-wrap: wrap;
    margin-top: var(--space-2);
  }

  :global(.planner-semester-choice) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-1);
  }

  :global(.planner-semester-note) {
    color: var(--faint);
  }

  /* --- Programme/kull picker ------------------------------------------- */

  .planner-picker:not([hidden]) {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: var(--measure);
    margin-bottom: var(--space-6);
  }

  .planner-picker-kicker {
    margin-bottom: 0;
  }

  .planner-picker-field {
    position: relative;
  }

  .planner-picker-listbox {
    --popover-max: 16rem;
  }

  :global(.planner-picker-option) {
    display: flex;
    align-items: baseline;
    gap: var(--gap-3);
    flex-wrap: wrap;
  }

  :global(.planner-picker-code) {
    color: var(--muted);
    font-size: var(--text-xs);
    flex-shrink: 0;
    width: 6em;
  }

  :global(.planner-picker-name) {
    font-size: var(--text-sm);
  }

  :global(.planner-picker-level) {
    font-size: var(--text-xs);
    color: var(--faint);
  }

  .planner-picker-kull-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-2);
  }

  .planner-picker-kull-hint {
    margin-top: var(--space-1);
  }

  /* --- Two regions ------------------------------------------------------- */

  /* Tabs exist only where there isn't room for both regions; the wide
     layout below hides them and shows Uke + Emner side by side. */
  .planner-tabs {
    display: flex;
    gap: var(--gap-2);
    margin-bottom: var(--space-4);
  }

  .planner-regions {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  /* Narrow: one region at a time, driven by [data-region] on the container.
     display:none (not [hidden]) keeps the same rule from applying at wide
     widths, where both regions are always shown. */
  .planner-regions[data-region="week"] .planner-region-courses,
  .planner-regions[data-region="courses"] .planner-region-week {
    display: none;
  }

  .planner-region {
    min-width: 0;
  }

  /* Empty plan (B5): the picker is the page. The week and the tabs have
     nothing to say yet, but the add field stays mounted — a student who
     already knows a course code should not have to pick a programme first. */
  #planner-main.is-empty .planner-tabs,
  #planner-main.is-empty .planner-region-week {
    display: none;
  }

  #planner-main.is-empty .planner-regions {
    display: block;
  }

  /* A credit total and a course list with nothing in them are not an
     invitation; the field is. */
  #planner-main.is-empty .planner-credit-line,
  #planner-main.is-empty .planner-course-rows,
  #planner-main.is-empty .planner-scope {
    display: none;
  }

  @media (min-width: 60rem) {
    .planner-tabs {
      display: none;
    }

    /* The week is the primary surface (§0.2) and takes every pixel the rail
       does not need; the rail only ever holds a code, a name and a button,
       so it wants a fixed measure rather than a fraction (D7). */
    .planner-regions {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 18rem;
      align-items: start;
      gap: var(--space-7);
    }

    .planner-regions[data-region="week"] .planner-region-courses,
    .planner-regions[data-region="courses"] .planner-region-week {
      display: block;
    }

    .planner-region-courses {
      position: sticky;
      top: var(--space-4);
    }
  }

  @media (min-width: 72rem) {
    .planner-regions {
      grid-template-columns: minmax(0, 1fr) 20rem;
    }
  }

  /* --- The week's open question ------------------------------------------ */

  /* Studieretning, campus, or "your period is all electives" (B2/U8). It sits
     above the grid because the same question behind a tab is a dead end. */
  .planner-direction:not([hidden]) {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  /* A title, not a kicker: "Studieplanen din for Høst 2026 er valgfri" is a
     sentence, and 11.5 px uppercase tracked mono is where D10 draws the line. */
  .planner-direction-title {
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
    letter-spacing: normal;
  }

  .planner-direction-note {
    margin: 0;
    max-width: none;
  }

  .planner-direction-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-2);
    margin-top: var(--space-1);
  }

  .planner-direction-chips:empty {
    display: none;
  }

  .planner-direction-actions:not([hidden]) {
    margin-top: var(--space-1);
  }

  /* --- Section headers --------------------------------------------------- */

  .planner-section-head {
    display: flex;
    align-items: center;
    gap: var(--gap-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-3);
  }

  .planner-section-sub {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .planner-section-sub:empty {
    display: none;
  }

  /* The verdict (U4): PRODUCT §1's primary job answered beside the kicker.
     Accent when the week holds together, --clash when it does not — the two
     states Green-Means-Fits and Red-Is-Collision are named for. */
  :global(.planner-section-sub.is-clean) {
    color: var(--accent-ink);
  }

  .planner-others-toggle {
    margin-left: auto;
  }

  .planner-credit-line {
    margin-left: auto;
    font-size: var(--text-md);
    color: var(--muted);
    transition: color var(--dur-fast) var(--ease);
  }

  /* Green means it fits — exactly a full load, never an overload. "37,5 av
     30 sp" in the same green as 30 tells the student the opposite of the
     truth (B9.3); the overload keeps neutral ink and explains itself in
     .planner-credit-note below. */
  .planner-credit-line.is-full {
    color: var(--accent-ink);
  }

  .planner-credit-note:not([hidden]) {
    max-width: none;
    margin-bottom: var(--space-3);
  }

  /* --- Weekly grid --------------------------------------------------------- */

  /* The week's own geometry and ink are in src/styles/planner-week.css, shared
     with /emne/[code]/. What follows is only what this page adds to it. */

  /* A4: at 390 px the week is ~200 px narrower than its content and the
     frame's own border closes right after ONS — no fade, no scrollbar, and
     the page itself does not scroll, so the clip reads as an edge and a
     student can conclude they have no Thursday lecture. The mask says
     "there is more"; #planner-scroll-hint names which days. */
  .planner-grid-frame[data-scroll="start"] {
    mask-image: linear-gradient(to right, #000 calc(100% - 2rem), transparent 100%);
  }

  .planner-grid-frame[data-scroll="middle"] {
    mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 2rem,
      #000 calc(100% - 2rem),
      transparent 100%
    );
  }

  .planner-grid-frame[data-scroll="end"] {
    mask-image: linear-gradient(to right, transparent 0, #000 2rem);
  }

  .planner-scroll-hint:not([hidden]) {
    margin-bottom: var(--space-2);
  }

  /* --- Exam ribbon ----------------------------------------------------- */

  .planner-exam-frame {
    padding: calc(var(--cell) * 2) var(--cell) var(--cell);
    margin-bottom: var(--space-2);
    position: relative;
  }

  /* The frame's own padding is the spacing; a message in it is not prose. */
  :global(.planner-exam-empty) {
    margin: 0;
  }

  :global(.planner-exam-axis) {
    position: relative;
    height: 1.2rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: var(--space-4);
  }

  :global(.planner-exam-month) {
    position: absolute;
    left: var(--planner-pos);
    font-size: var(--text-xs);
    color: var(--muted);
    transform: translateX(-50%);
  }

  :global(.planner-exam-dots) {
    position: relative;
    height: 1.5rem;
  }

  :global(.planner-exam-stack) {
    position: absolute;
    left: var(--planner-pos);
    top: 0;
    display: flex;
    gap: 2px;
    transform: translateX(-50%);
    padding: 3px;
    border-radius: var(--radius-xs);
  }

  :global(.planner-exam-stack.is-clash) {
    outline: 2px solid var(--clash);
    outline-offset: 1px;
  }

  .planner-exam-list {
    margin-bottom: var(--space-6);
  }

  :global(.planner-exam-list ul) {
    list-style: none;
    max-width: none;
  }

  :global(.planner-exam-row) {
    display: flex;
    align-items: center;
    gap: var(--gap-3);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }

  /* 9em, not 6.5 — "dato ikke satt" is a real value and has to fit (D3). */
  :global(.planner-exam-date) {
    color: var(--muted);
    font-size: var(--text-sm);
    width: 9em;
    flex-shrink: 0;
  }

  :global(.planner-exam-code) {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-2);
    font-size: var(--text-sm);
  }

  :global(.planner-exam-gap.is-tight) {
    color: var(--clash);
  }

  /* --- Course rows ------------------------------------------------------- */

  .planner-course-rows {
    display: flex;
    flex-direction: column;
    margin-bottom: var(--space-3);
  }

  /* Three columns (code · name · button) is one column too many for a 20 rem
     rail. D7 correctly gave the week the width it was missing, which left the
     name sharing a line with "Dropp" on 130 px: "Informasjonsteknologi,
     grunnkurs" ran under the button and "Examen philosophicum for
     naturvitenskap og teknologi" broke into five one-word lines. So the row
     is two columns — identity and the one verb on the top line, which is the
     pair a student scans — and the name takes the rail's full measure on its
     own line below. Nothing is taken back from the week. */
  :global(.planner-course-row) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    column-gap: var(--gap-3);
    row-gap: var(--space-1);
    padding: var(--space-3) var(--space-2);
    border-bottom: 1px solid var(--border);
    transition: color var(--dur-fast) var(--ease);
  }

  :global(.planner-course-row.is-dropped) {
    color: var(--muted);
  }

  :global(.planner-course-row.is-dropped .planner-course-row-name) {
    text-decoration: line-through;
    text-decoration-color: var(--border-strong);
  }

  :global(.planner-course-row-head) {
    grid-column: 1;
    grid-row: 1;
    display: inline-flex;
    align-items: center;
    gap: var(--gap-2);
  }

  /* `anywhere` is the floor, not the plan: with the full measure almost every
     name wraps at a space, but a single 21-character word is still wider than
     the rail at the narrowest widths it reaches, and a word clipped mid-stroke
     under a button is the one outcome worse than a break. */
  :global(.planner-course-row-name) {
    grid-column: 1 / -1;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  :global(.planner-course-row-meta) {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-3);
    color: var(--muted);
    font-size: var(--text-xs);
  }

  :global(.planner-course-remove) {
    grid-column: 2;
    grid-row: 1;
    justify-self: end;
  }

  /* --- Credit gap door --------------------------------------------------- */

  .planner-gap-line:not([hidden]) {
    display: flex;
    align-items: baseline;
    gap: var(--gap-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-4);
  }

  /* --- Add / picker block ------------------------------------------------ */

  .planner-add-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .planner-add-field {
    position: relative;
  }

  .planner-scope {
    display: flex;
    gap: var(--gap-2);
    flex-wrap: wrap;
  }

  .planner-scope-note {
    margin: 0;
    max-width: none;
  }

  .planner-add-listbox {
    --popover-max: 24rem;
  }

  :global(.planner-pool-group) {
    padding: var(--space-3) var(--space-2) var(--space-1);
    color: var(--faint);
  }

  :global(.planner-typeahead-option) {
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: var(--gap-3);
    row-gap: 2px;
  }

  :global(.planner-typeahead-head) {
    display: flex;
    align-items: baseline;
    gap: var(--gap-2);
    min-width: 0;
  }

  :global(.planner-typeahead-code) {
    color: var(--muted);
    font-size: var(--text-xs);
    flex-shrink: 0;
  }

  :global(.planner-typeahead-name) {
    font-size: var(--text-sm);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(.planner-typeahead-credits) {
    color: var(--muted);
