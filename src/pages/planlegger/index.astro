---
import Icon from "../../components/Icon.astro";
import Layout from "../../layouts/Layout.astro";
// The week's geometry and ink live in one stylesheet because two surfaces
// render it through the same `renderGrid`. Only this page's exam list stays
// scoped below.
import "../../styles/planner-week.css";

const description =
  "Velg studieprogram og kull, se ukeplanen med en gang: forelesninger, kollisjoner, eksamensdatoer og studiepoeng.";

// The programme catalogue used to be inlined here as a 27 KB
// `<script type="application/json">` for the studieinfo modal this page owned.
// The picker lives in the profile panel now, which opens from the topbar on
// every page — including the 5 470 `/emne/[code]/` documents — so it is a
// build-time static file (`src/pages/data/programs.json.ts`) that
// `studieinfo.ts` fetches the first time a student opens the panel.
---

<Layout title="Planlegger · Semesterplan" description={description} wide>
  <div class="planner-banner">
    {/* ETT NAVN. The plan is named ONCE, here, in the notation a student
        types: MTDT · 2026 · Høst 2026. The topbar's chip carried the same
        three facts 100 px above this and is gone from this page; the
        programme's own 42-character database string is a hint now, not a
        2 rem headline. The title is a NAME, not a headline (DESIGN §9): one
        size, one family, no probe-driven face swap.

        The verdict is not on this line. It gets its own, between the plan's
        name and the week it is about — PRODUCT §2's question and its answer
        adjacent, but the answer read as a caption on the name when the two
        shared a baseline. */}
    {/* One row: what this plan is, then everything you can do to it. A
        calendar's chrome lives at the top of the page, not scattered down it —
        the view switch and the layer box used to sit in the week's own section
        head, a second bar 200 px lower saying the same kind of thing. */}
    <div class="planner-head">
      <div class="planner-name">
        <h1 class="planner-title" id="planner-title">Semesterplan</h1>
        {/* Always filled by `renderBanner` — the programme's long name, or the
            semester the empty week is for — so the one line it will occupy is
            held from first paint rather than appearing at mount and pushing
            the whole page down 21px. */}
        <p class="np-hint planner-context-line" id="planner-context-line"></p>
      </div>

      {/* The layer is a box you tick; the view is a switch you throw. They read
          as two kinds of control because they are. */}
      <button
        type="button"
        class="planner-others-toggle"
        id="planner-others-toggle"
        aria-pressed="false"
      >
        <span class="planner-check" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5">
            <path d="m4 12 6 6L20 6" />
          </svg>
        </span>
        Øvinger og labber
        {/* What the layer is still waiting on. The narrowing that makes this
            necessary is deliberate (drawing every group put 41 blocks in one
            week) — what was not deliberate is that the control said nothing
            about it, so ticking the box on a five-course plan appeared to do
            nothing at all. Filled by `renderOthersPending`. */}
        <span class="planner-others-pending" id="planner-others-pending" hidden></span>
      </button>

      {/* "Uke" is the timetable shape a student already knows from every other
          calendar: days as columns, time down. The id keeps saying `kolonner`
          because that is the value in localStorage and the name of the module
          that draws it — the transposed week it used to be named against now
          lives only on /emne/[code]/. */}
      <div class="planner-view-tabs" role="group" aria-label="Velg hvordan uka vises">
        <span class="planner-view-thumb" aria-hidden="true"></span>
        <button
          type="button"
          class="planner-view-tab"
          id="planner-view-kolonner"
          aria-pressed="true"
        >
          Uke
        </button>
        <button
          type="button"
          class="planner-view-tab"
          id="planner-view-tavle"
          aria-pressed="false"
        >
          Liste
        </button>
      </div>
      {/* THE PLAN IS THE URL, AND NOTHING ON THE PAGE SAID SO. Shared-link
          creations are PRODUCT §2's north-star metric, `syncHash` has kept the
          address bar current since the beginning, and there was no way to act
          on that short of knowing to select the address bar. Hidden until
          there is a plan — an empty plan is not a thing to send anyone. */}
      {/* TWO MARKS, ONE SHOWN. The confirmation swaps the mark as well as the
          word, because a check is the half of "it worked" a student reads
          before any word. Both are authored here rather than built at runtime
          so neither can arrive a frame late.

          The share mark used to be an inline `<svg>` with no width, no height
          and no CSS. `base.css` gives every svg `display: block; max-width:
          100%`, and as a flex child of `.np-btn` that resolves to 0x0 — the
          button painted "Del" with an 8px gap where the icon should be, and the
          icon appeared, oversized, only when the label wrapped the box open.
          `<Icon>` writes real width/height attributes; nothing here relies on
          CSS to give the mark a size. */}
      <button type="button" class="np-btn planner-share" id="planner-share" hidden>
        <Icon name="share" size={16} class="planner-share-mark" />
        <Icon name="check" size={16} class="planner-share-check" />
        {/* "Del lenke", not "Del" — and that is what makes the confirmation
            free. The old pair was "Del" → "Lenke kopiert", so the button had to
            be pinned to the WIDER of the two and then sat in that width holding
            the shorter word for the rest of the visit: a slab of dead space
            after "Del". Naming the object in the resting label makes the rest
            state the widest one, so the pin costs nothing and the confirmation
            can be a single word. */}
        <span id="planner-share-label">Del lenke</span>
      </button>

      {/* WHICH TERM THIS PLAN IS FOR — the one thing in this bar that is not a
          verb, and the slot the old "Profil" button vacated.

          It was a `<select>` inside the studieinfo modal, staged next to
          programme, kull and studieretning. Those three describe the STUDENT
          and moved to the profile panel the topbar opens; this describes the
          PLAN, so it belongs beside the plan's own name. It commits on change
          — which is what the modal did anyway, writing the semester first and
          unconditionally before anything else it staged.

          No visible label: every option names itself ("Høst 2026"), and a
          "Semester" caption beside it would spend a phone row restating the
          option. `renderSemesterOptions` fills it. */}
      <div class="np-select-shell planner-semester">
        <select class="np-select" id="planner-semester-select" aria-label="Semester"></select>
        <svg
          class="np-select-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <path d="m6 9 6 6 6-6" />
        </svg>
      </div>
    </div>

    {/* The verdict, on its own line under the bar. The product's one job is to
        answer "can I take these together", so the answer stands between the
        plan's name and the week it is about — not tucked at the end of the
        title's line where it read as a caption on the name. */}
    <p class="planner-status" id="planner-status">
      <span class="planner-verdict" id="planner-grid-status" aria-live="polite"></span>
      {/* DR-9's date, which is a fact about the calendar rather than about the
          plan, so it sits at the far end rather than in the run of verdicts. */}
      <span class="planner-deadline" id="planner-deadline" hidden></span>
    </p>
  </div>

  <p class="np-hint planner-link-note" id="planner-link-note" hidden></p>

  <div id="planner-main">
    {/* The week runs the page's full width and the other two share the row
        under it. Transposing the grid is what made that possible: the week is
        ~290 px tall now instead of 768, so everything fits without a side rail
        stealing a third of the axis — the rail was starving the grid to 864 px
        of 1440 while its own column sat empty below the fold. It also retires
        the Uke/Emner tabs, which existed so a phone did not have to scroll
        past a very tall week. */}
    <section class="planner-week" id="planner-region-week" aria-labelledby="planner-week-heading">
      <div class="planner-direction" id="planner-direction" hidden>
        <h2 class="planner-direction-title" id="planner-direction-title"></h2>
        <p class="np-hint planner-direction-note" id="planner-direction-note"></p>
        <div class="planner-direction-actions" id="planner-direction-actions" hidden>
          <button type="button" class="np-btn" id="planner-direction-btn">Velg emner</button>
        </div>
      </div>

      {/* Kept for the region's accessible name and hidden from the page: a
          grid of weekdays with an hour ruler over it does not need to be told
          it is a week. The head that used to carry it is
          gone with its controls — they live in the page's own bar now, and a
          rule under an invisible heading ruled nothing. */}
      <h2 class="planner-section-name sr-only" id="planner-week-heading">Uke</h2>
      {/* `data-reserve`: the week's height, held from first paint until a real
          week is drawn into it — a LEASE, like the exam list's and the course
          page's, not a permanent floor. See planner-week.css. */}
      <div class="planner-grid-frame" id="planner-grid-frame" data-reserve></div>
      <div class="planner-grid-notes" id="planner-grid-notes"></div>
      {/* What was fetched and when, under the week it qualifies rather than at
          the foot of the page: a composition has to admit where it is thin, and
          it cannot do that two screens below the thing it is thin about. */}
      <p class="np-hint planner-provenance" id="planner-provenance" hidden></p>
    </section>

    <div class="planner-below">
      <section class="planner-exams" aria-labelledby="planner-exam-heading">
        <div class="planner-section-head">
          <h2 class="planner-section-name" id="planner-exam-heading">Eksamener</h2>
          <p class="planner-section-sub" id="planner-exam-status" aria-live="polite"></p>
        </div>
        <div class="planner-exam-list" id="planner-exam-list-host" data-reserve></div>
      </section>

      <section class="planner-courses" id="planner-region-courses" aria-labelledby="planner-courses-heading">
        <div class="planner-section-head">
          <h2 class="planner-section-name" id="planner-courses-heading">Emner</h2>
        </div>

        {/* The load, drawn: 30 sp as a track, each course a segment in its own
            hue. Same shape as the exam band over the exam list. */}
        {/* Not `hidden`: an empty strip has to keep occupying its 15px, or the
            course rows under it move down when the first segment is drawn.
            CLAUDE.md's own rule — something that must stay laid out while it
            shows nothing wants a state, not the attribute — and the state here
            is simply "no children". The reservation is the probe's
            (tokens.css), so a plan-less page still spends nothing on it. */}
        <div class="planner-load" id="planner-credit-strip" aria-hidden="true"></div>
        {/* The figure, then what the mark on the track above it means. The
            track cannot label itself, and "streken er 30 sp" is the difference
            between a bar with a tick in it and a bar you can read. */}
        <p class="planner-load-foot">
          <span class="np-data planner-credit-line" id="planner-credit-line">0 av 30 sp</span>
          <span class="planner-load-legend" id="planner-load-legend" hidden>streken er 30 sp</span>
        </p>
        <p class="np-hint planner-credit-note" id="planner-credit-note" hidden></p>

        <div class="planner-course-rows" id="planner-course-rows" data-reserve></div>

        {/* WHAT THE MODAL CANNOT SAY. "Mangler 7,5 sp" is a fact about the plan
            you are looking at, and a dialog you have not opened cannot tell you
            it is worth opening.

            It used to carry "Velg fra studieplanen (8)" beside it — a second,
            conditional door to picking courses, one row above the standing
            "Legg til emne" and opening the identical unfiltered dialog, so the
            pool it promised was on neither surface. The pool is a facet in that
            dialog now, engaged on open while this line is showing, which is the
            same one press this button used to cost. */}
        <p class="planner-gap-line" id="planner-gap-line" hidden>
          <span class="np-note" id="planner-gap-text"></span>
        </p>

        {/* THE PRIMARY ACTION, AT THE FOOT OF THE LIST IT ADDS TO. It spent a
            while up in the page's bar, on two arguments that have both expired.

            "Indistinguishable from 'Velg fra studieplanen' beside it" — there
            is no such button any more. It was a second, conditional door to the
            same dialog this one opens, and the study plan it named is a filter
            inside that dialog now. `#planner-gap-line` above is the sentence it
            left behind, and a sentence does not compete with a verb.

            "Below the fold on a phone" — the layout it was measured in is
            gone (the Uke/Emner tabs it mentions no longer exist), and the
            Emner column is one scroll under the week either way. Re-measured
            at 390 px: it lands well down the page on a full plan, which is
            where the thing it adds to also is. A student who wants a sixth
            course is looking at the five they have.

            It keeps the accent, which is the token's one job (DESIGN §2's
            One-Job-Accent) — `renderBanner` takes it off while there is no
            plan, because then the empty week's own "Velg studieprogram" is the
            primary action and two accents is none. */}
        <button
          type="button"
          class="np-btn np-btn--primary planner-add-course-btn"
          id="planner-add-course-btn"
        >
          Legg til emne
        </button>

        <details class="planner-plan-panel" id="planner-plan-panel" hidden>
          <summary class="np-summary planner-plan-summary">Fra studieplanen</summary>
          <div class="planner-plan-body" id="planner-plan-body"></div>
        </details>
      </section>
    </div>
  </div>
</Layout>

<style>
  /* --- Banner ------------------------------------------------------------ */

  /* Facts only — the identity block carries no control of its own. Every
     button that acts on the plan lives in `.planner-head`'s action run. */
  .planner-banner {
    margin-bottom: var(--space-4);
  }

  /* THE BAR. What the plan is, then everything you can do to it, on one line —
     the shape every calendar opens with. A wrapping flex row rather than named
     grid areas: the areas existed to keep the code and the long programme name
     adjacent while a verdict and a button wrapped between them, and the name
     now sits inside `.planner-name` where nothing can get in.

     `--gap-4` between tools and `--space-3` between wrapped rows: on a phone
     this comes out as the name on its own line, then the layer box and the
     Uke/Liste switch sharing the next, then Del (once a plan exists) and the
     semester select on the last. Two controls left this bar in the same change
     — the account's door went to the topbar and "Legg til emne" went back to
     the foot of the Emner column — and one arrived, so the bar carries less
     than it did. */
  .planner-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--gap-4);
  }

  /* Pushes everything else to the far end, and is allowed to shrink first: a
     42-character programme name may ellipsise, a control may not. */
  .planner-name {
    margin-inline-end: auto;
    min-width: 0;
  }

  /* The verdict's own line, between the plan's name and the week it judges. */
  .planner-status {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--gap-4);
    margin-top: var(--space-3);
    min-height: 1.4rem;
  }

  /* The run of verdicts. A flex row of its own rather than `display: contents`,
     so `renderVerdict` keeps owning one element and the `.is-clean` rule below
     keeps having a box to hide. */
  .planner-verdict {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--gap-4);
    min-width: 0;
  }

  .planner-verdict:empty {
    display: none;
  }

  /* NOT A PILL. A mark and a sentence: the colour sits in the sign, the words
     stay ink, and nothing here is a badge the eye learns to skip. A filled
     capsule would also have to pick a fill for "we do not know", and there
     isn't one — Green-Means-Fits and Red-Is-Collision are both spoken for. */
  :global(.planner-chip) {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--fg);
  }

  :global(.planner-chip svg) {
    width: 15px;
    height: 15px;
    flex: none;
  }

  /* The caveat rides the pass rather than replacing it: the mark and the words
     stay a verdict, and this is the qualifier in the quieter ink — one chip,
     one reading, "it holds, and here is what I did not look at". */
  /* A heading inside the picker's list, not above it: the list is one column of
     rows and the two kinds are told apart in that column, where the eye already
     is. First one gets no space above it — it is the top of the list. */
  :global(.course-settings-group-heading) {
    margin: var(--space-3) 0 var(--space-1);
  }

  :global(.course-settings-group-heading:first-child) {
    margin-top: 0;
  }

  /* "ditt program", on the row that names it. Ink and small, never a colour:
     it is a fact about the label beside it, not a verdict about the plan. */
  :global(.course-settings-group-own) {
    margin-inline-start: var(--gap-2);
    color: var(--muted);
    font-size: var(--text-xs);
  }

  :global(.course-settings-group-own)::before {
    content: "· ";
  }

  :global(.planner-chip-caveat) {
    color: var(--muted);
    font-weight: var(--weight-normal);
  }

  :global(.planner-chip.is-clean svg) {
    color: var(--verdict);
  }

  :global(.planner-chip.np-note-clash svg) {
    color: var(--clash);
  }

  /* An over-full load is worth a look, not a stop — DESIGN §2's whole reason
     for --warn existing ("amber exists so red is never spent on something
     merely worth a look"). It wore --clash here, which put the identical mark
     on "45 av 30 sp" and on "2 kollisjoner denne uka". */
  :global(.planner-chip.is-over svg) {
    color: var(--warn);
  }

  /* "kan ikke sjekkes" carries no mark at all: a sign would have to be one of
     the two colours that already mean fits and collides. */
  :global(.planner-chip.is-unknown) {
    color: var(--muted);
    font-weight: var(--weight-normal);
  }

  /* The verdict you can follow. Underlined ON HOVER only: at rest it is a
     verdict and must read as one, and a permanently underlined sentence in the
     page's most important line would look like a footnote.

     The target is the whole sentence — and it did NOT clear 24px on its own,
     which this comment claimed for as long as the button existed: measured
     153×20.8 at every width, the one control on the page under WCAG 2.5.8's
     floor, and the one you most want pressed. The padding is what makes the
     claim true. `.planner-chip` is already `inline-flex; align-items: center`,
     so a min-height grows the box around the centred sentence — no padding
     math, and nothing moves but this control's own hit area. */
  :global(button.planner-chip.is-jump) {
    font-family: inherit;
    cursor: pointer;
    text-align: start;
    text-decoration-color: transparent;
    min-height: 24px;
  }

  :global(button.planner-chip.is-jump:hover) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Not a fact about the plan but about the calendar, so it stands apart from
     the run of verdicts rather than in it. */
  .planner-deadline {
    margin-inline-start: auto;
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .planner-deadline :global(b) {
    color: var(--fg);
    font-weight: var(--weight-medium);
  }

  @media (max-width: 46rem) {
    .planner-deadline {
      margin-inline-start: 0;
    }
  }

  /* THE TITLE. `MTFYMA Kull 24 H26` — the plan in the notation a student writes
     on a timetable. No separators between the three parts, only spaces: at this
     size the facts already read as three, and the short forms are what pays for
     the code beside them at 390 px.

     A NAME, NOT A HEADLINE. It was `--text-xl` — the page-title step — for a
     string that names the document you are already looking at, and it pushed
     the week down for the privilege. A calendar puts its own name at the top
     left in about 20 px and gives the rest of the row to the controls.

     ONE SIZE, so the probe no longer has to pick. The old pair existed because
     the plan's title was set in a second typeface at a second size, and a class
     added at mount swapped both one frame after the server had painted the
     other (27px → 39px at 390px, with the whole page hanging off its baseline).
     Stage 1 aliased `--font-mono` to the system face, which killed the face
     half; equal sizes kill the rest, and a swap that cannot happen needs no
     probe. `data-plan` is still load-bearing for `--plan-courses` and for the
     reservations — this is only the title's use of it that has gone. */
  .planner-title {
    font-size: 1.25rem;
    font-weight: var(--weight-semibold);
    letter-spacing: -0.015em;
    line-height: var(--leading-snug);
  }

  :global(.planner-title-part) {
    white-space: nowrap;
  }

  .planner-context-line {
    max-width: none;
    /* One line, held. `renderBanner` always writes this, so the line is never
       absent once the page is alive. */
    min-height: 1lh;
  }

  /* THE HAND-OVER. Two marks live in this button and exactly one is drawn: the
     resting `share`, and the `check` that answers a press. A state class rather
     than `[hidden]`, because what changes is which of two siblings occupies one
     slot — the attribute is for something that stops existing.

     `flex: none` on the marks is a guard, not decoration: this control's icon
     was a flex child with no intrinsic size once already, and the whole failure
     was invisible until it was measured. */
  .planner-share :global(svg) {
    flex: none;
  }

  .planner-share :global(.planner-share-check) {
    display: none;
  }

  .planner-share.is-copied :global(.planner-share-mark) {
    display: none;
  }

  .planner-share.is-copied :global(.planner-share-check) {
    display: block;
  }

  /* The semester, at the end of the tool run. `flex: none` because a select
     with `appearance: none` has no min-content width worth trusting — the
     grammar is `.np-select` in primitives.css, shared with the studieretning
     picker in the profile panel. */
  .planner-semester {
    flex: none;
  }

  @media (max-width: 46rem) {
    /* Every row the bar spends is a row the week does not get, and the bar now
       carries the controls that used to sit lower down. So: tighter rows, and
       the context line clamped to ONE — a 42-character programme name wrapping
       to a second line is 18px spent restating what the title already says in
       the notation a student actually types. */
    .planner-head {
      gap: var(--space-2) var(--gap-3);
    }

    .planner-context-line {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .planner-status {
      margin-top: var(--space-2);
    }

    /* The pass is not shown on a phone: "Ingen forelesninger kolliderer"
       answers a question you only ask when something might be wrong, and it
       spent a line of the first screen saying nothing is. A collision still
       says so, as does "kan ikke sjekkes", and the line keeps its `aria-live`.

       Scoped to the VERDICT, not to `.planner-status` around it — the deadline
       shares that row now, and hiding the row took the one date the whole
       positioning rests on down with a clean week (D13).

       `:not(:has(.is-qualified))` is load-bearing: a pass that carries a
       caveat ("· 1 emne ikke sjekket") is NOT the pass this rule was written
       about. Without it the phone hid the answer and kept the caveat — the
       margin note still said "kollisjonssjekken er ufullstendig" with nothing
       on screen for it to qualify, which reads as a bare warning. A qualified
       pass must survive to the small screen; only an unqualified one is the
       line that says nothing. */
    .planner-verdict:has(.is-clean):not(:has(.is-qualified)) {
      display: none;
    }
  }

  /* The unanswered studieretning. It asks you to do something; it does not say
     the term works — so it is ink, not the verdict green. */
  :global(.planner-context-direction) {
    color: var(--ui);
  }

  .planner-link-note:not([hidden]) {
    max-width: none;
    margin-bottom: var(--space-4);
  }

  /* --- Layout ------------------------------------------------------------ */

  /* The week takes the page's whole width; Eksamener and Emner share the row
     under it. This is what transposing the grid bought: at ~290 px tall a side
     rail is no longer the only way to see the plan and the week at once, and
     the rail was costing the week a third of its axis. It also retires the
     Uke/Emner tabs, which existed because a phone could not scroll past a
     768 px week. */
  #planner-main {
    display: grid;
    gap: var(--space-7);
  }

  .planner-week,
  .planner-exams,
  .planner-courses {
    min-width: 0;
  }

  /* One rule between the week and what is under it, and one between the two
     columns. Two bordered boxes would say the same thing twice over — the page
     IS the surface, so what separates a region from its neighbour is the line
     between them, not a wall around each. */
  .planner-below {
    display: grid;
    gap: var(--space-7);
    margin-top: clamp(1.9rem, 4vw, 2.9rem);
    padding-top: clamp(1.4rem, 3vw, 1.9rem);
    border-top: 1px solid var(--border-strong);
  }

  @media (min-width: 60rem) {
    .planner-below {
      /* Equal halves. The course list used to take a fixed 22rem measure and
         leave the exams a fraction, which made the exam dates the wider of two
         lists that both hold five short rows — and the load track under Emner
         has nothing to say at 22rem that it cannot say at half the page. */
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
      gap: 0 clamp(2rem, 4vw, 3.5rem);
    }

    /* Only where they sit side by side: stacked, the gap between two heads is
       already the division, and a vertical line down a phone would divide
       nothing. */
    .planner-courses {
      padding-inline-start: clamp(2rem, 4vw, 3.5rem);
      border-inline-start: 1px solid var(--border);
    }
  }

  /* --- The week's open question ------------------------------------------ */

  /* Studieretning, campus, or "your period is all electives" (B2/U8). It sits
     above the grid because the same question behind a tab is a dead end.

     No panel, and no coloured bar down its side either: this page knows it has
     at most one open question, so the box was a container for a count it
     already knew, and a card's whole job on a white ground is to say "these
     things belong together" — which a title and the sentence under it say by
     standing next to each other. What makes it findable is that it is the only
     thing above the week and it carries the only button there; the accent is
     already spent on that button, which is the token's one job
     (Ink-Before-Chrome: structure is tone and hairlines, never a border). */
  .planner-direction:not([hidden]) {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  /* A title, not a kicker: "Studieplanen din for Høst 2026 er valgfri" is a
     sentence, and 11.5 px uppercase tracked mono is where D10 draws the line. */
  .planner-direction-title {
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
    letter-spacing: normal;
  }

  .planner-direction-note {
    margin: 0;
    max-width: none;
  }

  .planner-direction-actions:not([hidden]) {
    margin-top: var(--space-1);
  }

  /* --- Section headers --------------------------------------------------- */

  /* A section head is a NAME and a qualifier on one baseline. No rule under it:
     the two columns are already divided from the week by `.planner-below`'s own
     border-top and from each other by the hairline between them, and a third
     rule 40 px below the second is ruling that has stopped meaning anything.
     Structure is the heading, the space around it, and one line per division. */
  .planner-section-head {
    display: flex;
    align-items: baseline;
    gap: var(--gap-3) var(--gap-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-3);
  }

  /* A real size, not tracked-out uppercase. Data-Is-Mono means `.np-data` is
     for times, dates, codes and counts, so spending its voice on section labels
     spends the rule's meaning too. */
  .planner-section-name {
    font-size: var(--text-md);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.015em;
    margin-inline-end: auto;
  }

  /* The default ink is set at ZERO specificity on purpose, and that is what
     `:global(:where(…))` buys. Astro scopes this block by appending
     [data-astro-cid-…], so a plain class selector here computes (0,2,0) and
     outranks `.np-note-clash` (0,1,0) — the flagship verdict printed in the
     page's quietest gray while the no-collision state was green, inverting
     Red-Is-Collision. `:where()` alone is not enough: the attribute strategy
     emits `[data-astro-cid-…]:where(…)`, which TIES with the primitive and
     leaves the colour to Vite's emit order. `:global()` drops the attribute. */
  :global(:where(.planner-section-sub, .planner-verdict)) {
    color: var(--muted);
  }

  .planner-section-sub {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
  }

  .planner-section-sub:empty {
    display: none;
  }

  /* --- Uke ⇄ Liste ------------------------------ */

  /* A segmented control: a recessed track with the live view raised out of it.
     One of the two is always true, which is what the form has to say — a pair
     of buttons would ask to be pressed, and a pair of bare words in the page's
     bar would read as links among the chrome around them.

     The BUTTONS carry the height, not the container — a target is only a target
     where the pointer lands, and each is a full `--control-h` minus the track's
     2px lip (WCAG 2.5.8 asks 24). */
  .planner-view-tabs {
    position: relative;
    display: flex;
    flex: none;
    padding: 2px;
    background: var(--wash);
    border-radius: var(--radius-sm);
  }

  /* THE THUMB. A rule under a word was right when the switch lived in the
     week's own section head, where a hairline was the local idiom. In the
     page's bar it sits beside two buttons and a checkbox, and a segmented
     control is what every calendar puts there: a recessed track with the live
     view raised out of it on paper.

     `--view-x` / `--view-w` are still written by `renderViewTabs` from the live
     button boxes, because the labels are different widths in every font and at
     every zoom level. */
  .planner-view-thumb {
    position: absolute;
    top: 2px;
    bottom: 2px;
    inset-inline-start: 0;
    width: var(--view-w, 0);
    background: var(--card);
    border-radius: calc(var(--radius-sm) - 1px);
    box-shadow: var(--shadow-sm);
    transform: translateX(var(--view-x, 0));
    transition:
      transform var(--dur) var(--ease),
      width var(--dur) var(--ease);
  }

  :global(.planner-view-tab) {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    min-height: calc(var(--control-h) - 4px);
    padding-inline: var(--space-3);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--muted);
    border-radius: calc(var(--radius-sm) - 1px);
    transition: color var(--dur-fast) var(--ease);
  }

  :global(.planner-view-tab:hover) {
    color: var(--ui);
  }

  :global(.planner-view-tab[aria-pressed="true"]) {
    color: var(--fg);
  }

  /* The layer, not a view: a box you tick. Nothing about it is shaped like the
     pair beside it — it ADDS øvinger and labber; it does not choose how the
     week is drawn. */
  .planner-others-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-2);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--muted);
    /* Same trade as the tabs: a 24px target, none of it spent on layout. */
    margin-block: -7px;
    padding-block: 7px;
    border-radius: var(--radius-xs);
    transition: color var(--dur-fast) var(--ease);
  }

  .planner-others-toggle:hover,
  .planner-others-toggle[aria-pressed="true"] {
    color: var(--fg);
  }

  /* Not a badge and not a warning — a count the label finishes on. Amber would
     make an ordinary unmade choice look like a problem (§2's Red-Is-Collision
     and its amber sibling are both about the PLAN, not about our narrowing), so
     it is quiet ink set off by a middle dot. */
  .planner-others-pending:not([hidden]) {
    display: inline;
    color: var(--muted);
  }

  .planner-others-pending::before {
    content: " · ";
  }

  .planner-check {
    display: grid;
    place-items: center;
    flex: none;
    width: 14px;
    height: 14px;
    border: 1px solid var(--control-edge);
    border-radius: var(--radius-xs);
    transition:
      background var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }

  .planner-others-toggle[aria-pressed="true"] .planner-check {
    background: var(--ui);
    border-color: var(--ui);
  }

  .planner-check svg {
    width: 10px;
    height: 10px;
    color: var(--ui-contrast);
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease);
  }

  .planner-others-toggle[aria-pressed="true"] .planner-check svg {
    opacity: 1;
  }

  /* The exam head's own verdict, which is still one sentence rather than a run
     of chips: `.is-clean` there means the same as it does above. */
  :global(.planner-section-sub.is-clean) {
    color: var(--verdict);
  }

  .planner-credit-line {
    font-size: var(--text-md);
    color: var(--muted);
    transition: color var(--dur-fast) var(--ease);
  }

  /* Green means it fits — exactly a full load, never an overload. "37,5 av 30
     sp" in the same green as 30 tells the student the opposite of the truth;
     the overload keeps neutral ink and explains itself below. */
  .planner-credit-line.is-full {
    color: var(--verdict);
  }

  .planner-load-foot {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-1) var(--gap-3);
  }

  .planner-load-legend {
    font-size: var(--text-xs);
    color: var(--muted);
  }

  .planner-credit-note:not([hidden]) {
    max-width: none;
    margin-bottom: var(--space-3);
  }

  /* --- Weekly grid --------------------------------------------------------- */

  /* The week's own geometry and ink — and the scroll-edge mask — are in
     src/styles/planner-week.css, shared with /emne/[code]/. What follows is
     only what this page adds. */

  /* --- Empty / fallback week card ---------------------------------------- */

  /* The four empty states that carry an action, centered in the week frame so
     the one next step is where the plan would be, not tucked under it. */
  :global(.planner-week-card) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-6) var(--space-3);
    text-align: center;
  }

  :global(.planner-week-card-hint) {
    margin: 0;
    max-width: var(--measure);
  }

  :global(.planner-week-card-secondary) {
    /* The second route, and it has to LOOK like a route. It was `.np-navlink`
       — --muted, no underline, no surface — under a paper primary, so the one
       screen a student with five codes and no programme lands on offered them
       a sentence rather than a control. Paper against the card's accent
       primary is the ordinary two-button hierarchy; the size step keeps it
       second without making it a footnote. */
    font-size: var(--text-sm);
  }

  /* --- Exam list ---------------------------------------------------------- */

  /* The dated list and nothing above it: the dates already say how many exams
     there are and how far apart they fall. */
  :global(.exam-empty) {
    margin: 0 0 var(--space-2);
  }

  .planner-exam-list {
    margin-bottom: var(--space-6);
  }

  /* A LEASE, not a layout — the same instrument `/emne/[code]/` uses, with the
     same honesty clause: it holds the space the dated list is about to need
     while the bundles are in flight, and `renderGridAndExams` hands it back the
     moment the list shows whatever it will finally show, including a failed
     fetch. Nothing is left holding a hole open under a short answer.

     Sized per PLANNED COURSE, because the number of exams is exactly what we
     are waiting to find out. Measured 65px per course; 3.5rem is deliberately
     under it, so a longer list nudges the page down rather than snatching
     content out from under a thumb.

     On a phone this is the one that matters: `.planner-below` is a single
     column there, so an arriving exam list pushes the whole Emner section
     down. */
  .planner-exam-list[data-reserve] {
    min-height: calc(var(--plan-courses) * 3.5rem);
  }

  /* A narrow column wraps the row, so the same five exams measure 400px here
     against 325px wide. Measured, not scaled: this is the width where the list
     is the thing pushing Emner down. */
  @media (max-width: 46rem) {
    .planner-exam-list[data-reserve] {
      min-height: calc(var(--plan-courses) * 4.85rem);
    }
  }

  /* Rendered synchronously from the store at mount, so this bridges paint to
     mount and nothing further; `renderCourseRows` drops it on its first pass.
     One row per stored course, dropped ones included, a little under 52px. */
  .planner-course-rows[data-reserve] {
    min-height: calc(var(--plan-courses) * 3rem);
  }

  /* --- The month band ------------------------------- */

  /* One row per month, one cell per day. It answers "how clustered is this"
     before a date is read, for about 40 px. */
  :global(.exam-band) {
    display: grid;
    gap: var(--gap-1);
    margin-bottom: var(--space-4);
  }

  :global(.exam-band-row) {
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr);
    align-items: center;
    gap: 0 var(--gap-3);
  }

  :global(.exam-band-name) {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking);
    text-transform: uppercase;
    color: var(--muted);
    text-align: right;
  }

  :global(.exam-band-days) {
    display: grid;
    grid-template-columns: repeat(31, minmax(0, 1fr));
    gap: 2px;
  }

  :global(.exam-band-day) {
    height: 13px;
    background: var(--card);
    border-radius: 1px;
  }

  /* The weekend ground is what makes a cluster look like a cluster rather than
     four evenly-spaced marks — one tonal step was invisible at 9 px. */
  :global(.exam-band-day.is-weekend) {
    background: color-mix(in srgb, var(--fg) 15%, var(--card));
  }

  /* Days past the end of a short month: nothing there, not an empty day. */
  :global(.exam-band-day.is-void) {
    background: transparent;
  }

  /* A colliding day keeps BOTH courses' hues (examList.ts sets the split fill
     inline) and takes a ring instead of a red fill: a flat red square says
     "something collides" and throws away the fact you would act on. A ring is a
     different KIND of mark from a fill (Red-Is-Collision). */
  :global(.exam-band-day.is-clash) {
    box-shadow: 0 0 0 1px var(--clash);
  }

  /* --- The list: the distances are the only rules ------------------------ */

  /* A rule ACROSS a list divides it, and a gap between two exams is not a
     division — it is the distance between them, which is the one thing this
     list exists to show. So the gaps are the rules: each carries a hairline
     that runs from its own words to the edge, and nothing else here is ruled.
     (The vertical rule with the exams as knots on it said the same thing
     turned 90°, and cost a line down a page whose structure is now type,
     hairlines and space.) */
  :global(.exam-list) {
    --exam-date-col: 3.9rem;
    --exam-knot: 19px;
    list-style: none;
    max-width: none;
    margin: 0;
    padding: 0;
  }

  /* Three columns: the date, the exam, and the weekday at the far end. */
  :global(.exam-row) {
    display: grid;
    grid-template-columns: var(--exam-date-col) minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0 var(--gap-4);
    padding: var(--space-2) 0;
  }

  :global(.exam-date) {
    font-size: var(--text-sm);
    white-space: nowrap;
  }

  /* The figure being scanned. */
  :global(.exam-day) {
    font-weight: var(--weight-semibold);
  }

  :global(.exam-month),
  :global(.exam-weekday) {
    font-weight: var(--weight-normal);
    color: var(--muted);
  }

  :global(.exam-weekday) {
    font-size: var(--text-xs);
    white-space: nowrap;
  }

  :global(.exam-what) {
    position: relative;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0 var(--gap-2);
    min-width: 0;
    padding-inline-start: var(--exam-knot);
  }

  /* The knot: the same mark as the course list's own dot, so a colour means
     one thing wherever it appears. */
  :global(.exam-what)::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    top: 0.3em;
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: var(--dot);
  }

  :global(.exam-code) {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  /* Vurderingsform (D6): whether a date is something to revise for or
     something to hand in. */
  :global(.exam-form) {
    min-width: 0;
    font-size: var(--text-sm);
    color: var(--muted);
  }

  /* "dato ikke satt", and nothing else — see `.exam-row.exam-dateless`. */
  :global(.exam-away) {
    font-size: var(--text-xs);
    color: var(--muted);
    white-space: nowrap;
  }

  /* The distance between two dates, drawn as distance: the words, then a
     hairline running out to the edge. That is what makes the row read as a
     SPACE and not as a third entry in the list. */
  :global(.exam-gap) {
    display: flex;
    align-items: center;
    gap: var(--gap-3);
    padding: var(--space-1) 0 var(--space-1)
      calc(var(--exam-date-col) + var(--gap-4) + var(--exam-knot));
    font-size: var(--text-xs);
    color: var(--muted);
  }

  :global(.exam-gap-rule) {
    flex: 1 1 auto;
    height: 1px;
    background: var(--border);
  }

  /* The first segment — today to the next exam. Same idiom as the lesedager
     connectors, so the list reads as one chain of distances; never `is-tight`'s
     red, because how far off an exam is says nothing about how much room there
     is to revise. */
  :global(.exam-gap.is-tight) {
    color: var(--clash);
    font-weight: var(--weight-medium);
  }

  /* Tight is the one distance worth seeing from across the room, so its rule
     carries the colour too — but muted into the hairline, not drawn at full
     strength: a red line across the list would out-shout the dates. */
  :global(.exam-gap.is-tight) :global(.exam-gap-rule) {
    background: color-mix(in srgb, var(--clash) 35%, var(--border));
  }

  :global(.exam-dateless) :global(.exam-date) {
    color: var(--muted);
  }

  /* The one caveat that is true of every row and belongs on none of them. */
  :global(.exam-foot) {
    max-width: none;
    margin: var(--space-3) 0 0;
    padding-top: var(--space-3);
    border-top: 1px solid var(--border);
  }

  /* Named in words, because the split cell and the ring are the fast read but
     neither survives a screen reader, a printout or colour blindness. */
  :global(.exam-clash) {
    margin: var(--space-3) 0 0;
    padding-inline-start: calc(var(--exam-date-col) + var(--gap-4) + var(--exam-knot));
  }

  /* --- The load strip ------------------------------ */

  /* Same shape as the exam band over the exam list: a drawing that answers the
     section's question, then the rows that answer it precisely. */
  .planner-load {
    display: block;
    margin-bottom: var(--space-2);
  }

  /* The track's own height, held while the strip is still empty — otherwise the
     first segment shoves every course row down 23px. Keyed on the probe so a
     page with no plan reserves nothing. */
  .planner-load:empty {
    min-height: calc(var(--plan-any) * 8px);
    margin-bottom: calc(var(--plan-any) * var(--space-2));
  }

  /* A track, not a chart. 8px and fully rounded: it answers "roughly how full
     is this term" in one glance and then gets out of the way — at 15px it was
     a bar chart of one bar, competing with the course rows it introduces. */
  :global(.planner-load-track) {
    position: relative;
    display: flex;
    gap: 2px;
    height: 8px;
    background: var(--wash);
    border-radius: 4px;
    overflow: hidden;
  }

  /* Where 30 sp lands, on a track the plan has already run past. Ink, not a
     signal colour: it marks a boundary, and the verdict chip above says
     whether crossing it is a problem. */
  :global(.planner-load-mark) {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--fg);
  }

  /* Printed ink, exactly like a week bar and an exam-band cell, so one course
     is one colour in all three places. `flex-grow` is the credits. */
  :global(.planner-load-seg) {
    flex-basis: 0;
    background: color-mix(in srgb, var(--dot) var(--block-mix), var(--block-base));
  }

  /* The gap to a full load is empty track, never a segment — it is the absence
     of a course and must not read as one. */
  :global(.planner-load-rest) {
    flex-basis: 0;
  }

  .planner-load-foot {
    margin-bottom: var(--space-4);
  }

  /* --- Course rows ------------------------------------------------------- */

  .planner-course-rows {
    display: flex;
    flex-direction: column;
    margin-bottom: var(--space-3);
  }

  /* Four columns — chip, name, credits, settings — and NO horizontal rule. Five
     borders divide up what is one thing: your semester. A vertical rule was
     tried and rejected for saying something untrue: a rule with knots on it
     encodes *sequence*, and a course list is a set, not a timeline.

     The row itself is inert. As a full-width `<button>` it had a pointer cursor
     and a hover wash while showing nothing pressable. The one target is the
     settings button at its end. */
  :global(.planner-course-row) {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 0 var(--gap-3);
    padding: var(--space-2) 0;
  }

  /* The one interactive thing in the row, and it looks it: a real target at the
     touch size the tokens define, revealed to full ink on hover. Quiet at rest
     because five of them down a rail would out-shout the courses. */
  :global(.planner-course-open) {
    color: var(--muted);
    flex: none;
    transition:
      color var(--dur-fast) var(--ease),
      background var(--dur-fast) var(--ease);
  }

  :global(.planner-course-open:hover) {
    color: var(--fg);
    background: var(--wash);
  }

  :global(.planner-course-open svg) {
    width: 16px;
    height: 16px;
  }

  /* The same mark as the exam list's knot and Liste's dot, at the same size:
     one shape means "this course" everywhere on the page. It was a printed
     chip — the hue filled with the code knocked out of it — which made the
     same course two different objects on one page. */
  :global(.planner-course-chip) {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    background: color-mix(in srgb, var(--dot) var(--block-mix), var(--block-base));
  }

  /* A dropped course is still a course: the swatch keeps its place and loses
     its fill, so the row reads as switched off rather than as missing
     (PRODUCT §1.3). A ring, not nothing, or the column of marks develops a
     hole — one of the two sanctioned inset shadows, DESIGN §4. */
  :global(.planner-course-row.is-dropped .planner-course-chip) {
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--border-strong);
  }

  :global(.planner-course-code) {
    font-weight: var(--weight-semibold);
  }

  /* `anywhere` is the floor, not the plan: almost every name wraps at a space,
     but a single 21-character word is wider than the rail at its narrowest. */
  :global(.planner-course-name) {
    display: grid;
    gap: 1px;
    min-width: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    overflow-wrap: anywhere;
  }

  :global(.planner-course-row.is-dropped .planner-course-title) {
    color: var(--muted);
    text-decoration: line-through;
    text-decoration-color: var(--border-strong);
  }

  /* Right-aligned in its own column so the figures stack into something a
     student can add up by eye. */
  :global(.planner-course-sp) {
    font-size: var(--text-xs);
    color: var(--muted);
    text-align: right;
    white-space: nowrap;
  }

  /* The attention mark sits under the name, so the credit column stays a column
     of figures. Ink, not red — it is an invitation to open the row. Not green
     either: "se detaljer" is a thing to do, not a verdict. */
  :global(.planner-course-flag) {
    font-size: var(--text-xs);
    color: var(--ui);
  }

  /* --- The credit gap ----------------------------------------------------- */

  /* A sentence, not a door: the button that stood beside it moved into the add
     dialog as a filter. What is left says what the numbers above it imply, and
     leads the eye to the one action under it. */
  .planner-gap-line:not([hidden]) {
    display: block;
    margin-bottom: var(--space-4);
  }

  /* --- Add-course button --------------------------------------------------
     One button opens the dialog addCourse.ts builds itself (its CSS lives in
     site.css, alongside the profile panel it is modeled on).

     At the foot of the Emner column, under the rows it appends to, with a
     clear gap over it: the credit-gap line above it is a sentence and this is
     the only control on this stretch of the column, so there is nothing left
     for it to be confused with — which is the distinction the bar version was
     moved up to get and never needed to leave the column for.

     Not full width: `.np-btn` is `inline-flex` and stays it. A 100 %-wide
     accent bar under five course rows is a banner, and the button is a verb. */
  .planner-add-course-btn {
    margin-top: var(--space-2);
  }

  /* --- "Fra studieplanen" panel -----------------------------------------
     The study plan's choice groups with their VERBATIM prose (DR-5 — never
     assert "group satisfied"), collapsed by default so it never buries the plan
     itself. Shown only when a programme is set and the period has choice
     groups. */
  .planner-plan-panel {
    margin-top: var(--space-4);
  }

  :global(.planner-plan-group) {
    margin-top: var(--space-3);
  }

  :global(.planner-plan-group-name) {
    margin-bottom: var(--space-1);
  }

  :global(.planner-plan-group-desc) {
    max-width: none;
    margin-bottom: var(--space-2);
  }

  :global(.planner-plan-row) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    column-gap: var(--gap-3);
    row-gap: var(--space-1);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--border);
  }

  :global(.planner-plan-row-head) {
    grid-column: 1;
    display: inline-flex;
    align-items: baseline;
    gap: var(--gap-2);
    flex-wrap: wrap;
  }

  :global(.planner-plan-row-name) {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  :global(.planner-plan-row-meta) {
    grid-column: 1 / -1;
    color: var(--muted);
    font-size: var(--text-xs);
  }

  :global(.planner-plan-add) {
    grid-column: 2;
    grid-row: 1;
    justify-self: end;
  }

  /* Only present when the join has a gap to admit, so it
     is spaced as a note that arrived rather than as a permanent footer. */
  .planner-provenance:not([hidden]) {
    max-width: none;
    margin-top: var(--space-6);
  }
</style>

<script>
  import { mountPlannerApp } from "../../components/planner/plannerApp.js";
  import { onPage } from "../../lib/pageLifecycle.ts";
  import semestersData from "../../../data/semesters.json";

  // Must run per page-load, not once per module: under ClientRouter this module
  // is evaluated only the first time it is fetched, so mounting at top level
  // left the planner an empty shell after any in-site navigation back to it.
  // `mountPlannerApp` mounts this page's own modals; the store and the sync
  // client come from `account.ts`, shared with the topbar's profile panel.
  onPage((signal) => {
    mountPlannerApp(semestersData, signal);
  });
</script>
