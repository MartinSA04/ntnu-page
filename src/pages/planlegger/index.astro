---
import programsData from "../../../data/programs.json";
import Layout from "../../layouts/Layout.astro";

const description =
  "Velg studieprogram og kull, se ukeplanen med en gang: forelesninger, kollisjoner, eksamensdatoer og studiepoeng.";

// Trimmed to [code, name] tuples: the programme picker only needs identity,
// not the full crawled record (keeps the client payload small).
const programOptions: [code: string, name: string][] = programsData.programs
  .map((p): [string, string] => [p.code, p.name])
  .sort((a, b) => a[1].localeCompare(b[1], "nb"));
---

<Layout title="Planlegger — Semesterplan" description={description} wide>
  <div class="planner-headrow">
    <div class="planner-context">
      <p class="np-kicker planner-kicker">Planlegger</p>
      <p class="np-data planner-context-line" id="planner-context-line">
        <button type="button" class="planner-context-change" id="planner-context-change">endre</button>
      </p>
    </div>
    <div class="planner-headrow-controls">
      <div
        class="planner-semester-toggle"
        id="planner-semester-toggle"
        role="group"
        aria-label="Velg semester"
      >
      </div>
      <span class="np-data planner-credit-line" id="planner-credit-line">0 av 30 sp</span>
    </div>
  </div>

  <section class="np-panel planner-picker" id="planner-picker" hidden aria-label="Velg studieprogram og kull">
    <p class="np-kicker planner-picker-kicker">Studieprogram</p>
    <form class="np-field planner-picker-field" id="planner-picker-field" autocomplete="off">
      <input
        type="text"
        id="planner-picker-input"
        placeholder="Søk etter studieprogram …"
        aria-label="Søk etter studieprogram"
        role="combobox"
        aria-expanded="false"
        aria-autocomplete="list"
        aria-controls="planner-picker-listbox"
      />
    </form>
    <ul
      class="planner-picker-listbox"
      id="planner-picker-listbox"
      role="listbox"
      aria-label="Studieprogramforslag"
      hidden
    >
    </ul>
    <div class="planner-picker-kull" id="planner-picker-kull" hidden>
      <p class="np-kicker">Kull</p>
      <div class="planner-picker-kull-chips" id="planner-picker-kull-chips" role="group" aria-label="Velg kull"></div>
    </div>
    <p class="np-note" id="planner-picker-status"></p>
  </section>

  <p class="np-note planner-empty-invite" id="planner-empty-state" hidden>
    Ingen emner i planen ennå. Velg et studieprogram over, eller legg til emner under.
  </p>

  <div id="planner-main">
    <div class="planner-section-head">
      <p class="np-kicker">Ukeplan</p>
      <p class="np-data planner-section-sub" id="planner-grid-status"></p>
      <button
        type="button"
        class="np-toggle planner-others-toggle"
        id="planner-others-toggle"
        aria-pressed="false"
      >
        Vis øvinger og labber
      </button>
    </div>
    <div class="np-frame np-ruled planner-grid-frame" id="planner-grid-frame"></div>
    <div class="planner-grid-notes" id="planner-grid-notes"></div>
    <p class="np-note planner-prepublish-note" id="planner-prepublish-note" hidden></p>

    <div class="planner-section-head">
      <p class="np-kicker">Eksamener</p>
      <p class="np-data planner-section-sub" id="planner-exam-window"></p>
      <p class="np-data planner-section-sub" id="planner-exam-status"></p>
    </div>
    <div class="np-frame np-ruled planner-exam-frame" id="planner-exam-frame"></div>
    <div class="planner-exam-list" id="planner-exam-list-host"></div>

    <div class="planner-section-head">
      <p class="np-kicker">Emner</p>
    </div>
    <div class="planner-course-rows" id="planner-course-rows"></div>

    <div class="planner-choice-section" id="planner-choice-section" hidden>
      <p class="np-kicker">Valgemner i studieplanen</p>
      <div class="planner-choice-rows" id="planner-choice-rows"></div>
    </div>

    <form class="np-field planner-add-field" id="planner-add-field" autocomplete="off">
      <input
        type="text"
        id="planner-add-input"
        placeholder="+ legg til emne …"
        aria-label="Legg til emne i planen"
        role="combobox"
        aria-expanded="false"
        aria-autocomplete="list"
        aria-controls="planner-add-listbox"
      />
    </form>
    <ul
      class="planner-add-listbox"
      id="planner-add-listbox"
      role="listbox"
      aria-label="Emneforslag"
      hidden
    >
    </ul>

    <p class="np-note planner-provenance" id="planner-provenance"></p>
  </div>
</Layout>

<style>
  .planner-headrow {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--gap-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-5);
  }

  .planner-kicker {
    margin-bottom: var(--space-1);
  }

  .planner-context-line {
    font-size: var(--text-sm);
    color: var(--muted);
  }

  :global(.planner-context-change) {
    font-family: var(--font-mono);
    font-size: inherit;
    color: var(--muted);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 2px;
  }

  :global(.planner-context-change:hover) {
    color: var(--accent-ink);
    text-decoration-color: currentColor;
  }

  .planner-headrow-controls {
    display: flex;
    align-items: center;
    gap: var(--gap-3);
    flex-wrap: wrap;
  }

  .planner-semester-toggle {
    display: flex;
    gap: var(--gap-2);
    flex-wrap: wrap;
  }

  .planner-credit-line {
    font-size: var(--text-md);
    color: var(--muted);
    transition: color var(--dur-fast) var(--ease);
  }

  .planner-credit-line.is-full {
    color: var(--accent-ink);
  }

  .planner-empty-invite {
    margin-bottom: var(--space-6);
  }

  /* --- Programme/kull picker ------------------------------------------- */

  .planner-picker:not([hidden]) {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: var(--measure);
    margin-bottom: var(--space-6);
  }

  .planner-picker-kicker {
    margin-bottom: 0;
  }

  .planner-picker-field {
    position: relative;
  }

  .planner-picker-listbox {
    list-style: none;
    background: var(--card-nested);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow);
    max-height: 16rem;
    overflow-y: auto;
    padding: var(--space-1);
  }

  :global(.planner-picker-option) {
    display: flex;
    align-items: baseline;
    gap: var(--gap-3);
    padding: var(--space-2);
    border-radius: var(--radius-xs);
    cursor: pointer;
  }

  :global(.planner-picker-option.is-active),
  :global(.planner-picker-option:hover) {
    background: var(--card-hover);
  }

  :global(.planner-picker-code) {
    color: var(--muted);
    font-size: var(--text-xs);
    flex-shrink: 0;
    width: 6em;
  }

  :global(.planner-picker-name) {
    font-size: var(--text-sm);
  }

  .planner-picker-kull-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-2);
  }

  /* --- Section headers --------------------------------------------------- */

  .planner-section-head {
    display: flex;
    align-items: center;
    gap: var(--gap-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-3);
  }

  .planner-section-sub {
    color: var(--muted);
    font-size: var(--text-xs);
  }

  .planner-others-toggle {
    margin-left: auto;
  }

  /* --- Weekly grid --------------------------------------------------------- */

  .planner-grid-frame {
    padding: var(--space-4);
    margin-bottom: var(--space-2);
    overflow-x: auto;
  }

  :global(.planner-grid-empty),
  :global(.planner-exam-empty) {
    margin: var(--space-4);
  }

  :global(.planner-grid) {
    position: relative;
    display: grid;
    grid-template-columns: 3.5em repeat(var(--planner-days), 1fr);
    /* One CSS grid row per 15-min slot, sized to the ruling's --cell so the
       grid-row-based rail and the absolutely-positioned blocks (top/height
       in --cell units) land on the same pixel grid. */
    grid-auto-rows: var(--cell);
    min-width: 40rem;
  }

  :global(.planner-grid-rail) {
    grid-column: 1;
    grid-row: 1 / span var(--planner-rows);
    position: relative;
  }

  :global(.planner-grid-hour) {
    position: absolute;
    /* Same pixel math as .planner-block's top — the rail is a positioned
       box, so grid-row placement doesn't apply to its absolute children. */
    top: calc((var(--planner-row-start) - 1) * var(--cell));
    right: var(--gap-2);
    transform: translateY(-0.5em);
    color: var(--faint);
    font-size: var(--text-xs);
  }

  :global(.planner-grid-day) {
    grid-row: 1 / span var(--planner-rows);
    grid-column: calc(var(--planner-day) + 1);
    position: relative;
  }

  :global(.planner-grid-day-header) {
    position: sticky;
    top: 0;
    text-align: center;
    padding-bottom: var(--space-1);
  }

  :global(.planner-block) {
    position: absolute;
    inset-inline: calc(var(--planner-col, 0) * (100% / var(--planner-col-count, 1)))
      calc((var(--planner-col-count, 1) - var(--planner-col, 0) - 1) * (100% / var(--planner-col-count, 1)));
    top: calc((var(--planner-row-start) - 1) * var(--cell));
    height: calc((var(--planner-row-end) - var(--planner-row-start)) * var(--cell));
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-1) var(--space-2);
    margin: 0 1px;
    background: color-mix(in srgb, var(--dot) 16%, var(--card));
    border-radius: var(--radius-xs);
    overflow: hidden;
    text-align: left;
    transition: background var(--dur-fast) var(--ease);
  }

  :global(.planner-block:hover) {
    background: color-mix(in srgb, var(--dot) 26%, var(--card));
  }

  /* Øving/lab display layer (DR-1): reduced ink, hue dot only, never red. */
  :global(.planner-block.is-muted) {
    background: color-mix(in srgb, var(--dot) 8%, var(--card));
    color: var(--muted);
  }

  :global(.planner-block.is-muted:hover) {
    background: color-mix(in srgb, var(--dot) 14%, var(--card));
  }

  :global(.planner-block.is-clash) {
    background-image: repeating-linear-gradient(
      45deg,
      color-mix(in srgb, var(--clash) 22%, transparent),
      color-mix(in srgb, var(--clash) 22%, transparent) 4px,
      transparent 4px,
      transparent 8px
    );
    background-color: color-mix(in srgb, var(--dot) 16%, var(--card));
  }

  :global(.planner-block-head) {
    display: flex;
    align-items: center;
    gap: var(--gap-2);
    min-width: 0;
  }

  :global(.planner-block-code) {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
  }

  :global(.planner-block.is-clash .planner-block-code) {
    text-decoration: underline wavy var(--clash);
    text-underline-offset: 2px;
  }

  :global(.planner-block-name) {
    font-size: var(--text-xs);
    line-height: var(--leading-snug);
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  :global(.planner-block-rooms),
  :global(.planner-block-weeks) {
    font-size: var(--text-xs);
    color: var(--muted);
  }

  .planner-grid-notes {
    margin-bottom: var(--space-2);
  }

  :global(.planner-notes-list) {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  :global(.planner-note-link) {
    text-align: left;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--clash) 40%, transparent);
    text-underline-offset: 2px;
  }

  :global(.planner-note-link:hover) {
    text-decoration-color: currentColor;
  }

  .planner-prepublish-note {
    margin-bottom: var(--space-6);
  }

  /* --- Exam ribbon ----------------------------------------------------- */

  .planner-exam-frame {
    padding: var(--space-6) var(--space-4) var(--space-4);
    margin-bottom: var(--space-2);
    position: relative;
    min-height: 6rem;
  }

  :global(.planner-exam-axis) {
    position: relative;
    height: 1.2rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: var(--space-4);
  }

  :global(.planner-exam-month) {
    position: absolute;
    left: var(--planner-pos);
    font-size: var(--text-xs);
    color: var(--muted);
    transform: translateX(-50%);
  }

  :global(.planner-exam-dots) {
    position: relative;
    height: 1.5rem;
  }

  :global(.planner-exam-stack) {
    position: absolute;
    left: var(--planner-pos);
    top: 0;
    display: flex;
    gap: 2px;
    transform: translateX(-50%);
    padding: 3px;
    border-radius: var(--radius-xs);
  }

  :global(.planner-exam-stack.is-clash) {
    outline: 2px solid var(--clash);
    outline-offset: 1px;
  }

  .planner-exam-list {
    margin-bottom: var(--space-6);
  }

  :global(.planner-exam-row) {
    display: flex;
    align-items: center;
    gap: var(--gap-3);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }

  :global(.planner-exam-date) {
    color: var(--muted);
    font-size: var(--text-sm);
    width: 6.5em;
    flex-shrink: 0;
  }

  :global(.planner-exam-code) {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-2);
    font-size: var(--text-sm);
  }

  /* --- Course rows ------------------------------------------------------- */

  .planner-course-rows {
    display: flex;
    flex-direction: column;
    margin-bottom: var(--space-4);
  }

  :global(.planner-course-row) {
    display: flex;
    align-items: center;
    gap: var(--gap-4);
    flex-wrap: wrap;
    padding: var(--space-3) var(--space-2);
    border-bottom: 1px solid var(--border);
    transition: color var(--dur-fast) var(--ease);
  }

  :global(.planner-course-row.is-dropped) {
    color: var(--muted);
  }

  :global(.planner-course-row.is-dropped .planner-course-row-name) {
    text-decoration: line-through;
    text-decoration-color: var(--border-strong);
  }

  :global(.planner-course-row-head) {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-2);
    width: 7em;
    flex-shrink: 0;
  }

  :global(.planner-course-row-name) {
    flex: 1;
    min-width: 10rem;
  }

  :global(.planner-course-row-assessment) {
    color: var(--muted);
    font-size: var(--text-sm);
  }

  :global(.planner-course-row-source) {
    color: var(--faint);
    font-size: var(--text-xs);
  }

  :global(.planner-course-remove) {
    margin-left: auto;
  }

  /* --- Choice-group list ---------------------------------------------- */

  .planner-choice-section {
    margin-bottom: var(--space-6);
  }

  :global(.planner-choice-row) {
    display: flex;
    align-items: center;
    gap: var(--gap-4);
    flex-wrap: wrap;
    padding: var(--space-2) var(--space-2);
    border-bottom: 1px solid var(--border);
  }

  :global(.planner-choice-name) {
    flex: 1;
    min-width: 10rem;
    font-size: var(--text-sm);
  }

  :global(.planner-choice-add) {
    margin-left: auto;
  }

  /* --- Add field --------------------------------------------------------- */

  .planner-add-field {
    max-width: 24rem;
    position: relative;
    margin-bottom: var(--space-2);
  }

  .planner-add-listbox {
    list-style: none;
    max-width: 24rem;
    background: var(--card);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow);
    max-height: 16rem;
    overflow-y: auto;
    padding: var(--space-1);
  }

  :global(.planner-typeahead-option) {
    display: flex;
    align-items: baseline;
    gap: var(--gap-3);
    padding: var(--space-2) var(--space-2);
    border-radius: var(--radius-xs);
    cursor: pointer;
  }

  :global(.planner-typeahead-option.is-active),
  :global(.planner-typeahead-option:hover) {
    background: var(--card-hover);
  }

  :global(.planner-typeahead-code) {
    color: var(--muted);
    font-size: var(--text-xs);
    flex-shrink: 0;
    width: 6.5em;
  }

  :global(.planner-typeahead-name) {
    font-size: var(--text-sm);
  }

  :global(.planner-typeahead-empty) {
    display: block;
    padding: var(--space-2);
  }

  .planner-provenance {
    margin-top: var(--space-4);
  }
</style>

<script
  is:inline
  type="application/json"
  id="planner-program-options"
  set:html={JSON.stringify(programOptions)}
/>
<script>
  import { mountPlannerApp } from "../../components/planner/plannerApp.js";
  import semestersData from "../../../data/semesters.json";

  const optionsEl = document.getElementById("planner-program-options");
  const programOptions = optionsEl?.textContent ? JSON.parse(optionsEl.textContent) : [];
  mountPlannerApp(semestersData, programOptions);
</script>
