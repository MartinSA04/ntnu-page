---
import programsData from "../../../data/programs.json";
import Layout from "../../layouts/Layout.astro";
// The week's geometry and ink live in one stylesheet because two surfaces
// render it through the same `renderGrid`. Only this page's exam list stays
// scoped below.
import "../../styles/planner-week.css";

const description =
  "Velg studieprogram og kull, se ukeplanen med en gang: forelesninger, kollisjoner, eksamensdatoer og studiepoeng.";

// Trimmed tuples: the picker needs identity plus the field that tells two
// same-named programmes apart, not the full crawled record; this ships to every
// visitor. Same tuple as the homepage picker — the two ask the same question.
const programOptions: [code: string, name: string, studyLevel: string, cities: string[]][] =
  programsData.programs
    .map((p): [string, string, string, string[]] => [
      p.code,
      p.name,
      p.studyLevel ?? "",
      p.cities ?? [],
    ])
    .sort((a, b) => a[1].localeCompare(b[1], "nb"));

// `JSON.stringify` escapes neither "<" nor "/", so a programme name containing
// "</script" would close this tag. < is a legal JSON escape, so the payload
// stays valid JSON and the parser sees the original character.
const programOptionsJson = JSON.stringify(programOptions).replaceAll("<", "\\u003c");
---

<Layout title="Planlegger · Semesterplan" description={description} wide>
  <div class="planner-banner">
    {/* ETT NAVN (REWORK-2026-07-30b). The plan is named ONCE, here, in the
        notation a student types: MTDT · 2026 · Høst 2026, set in the mono
        because every part of it is data (Data-Is-Mono, followed up the type
        scale rather than abandoned at the top of it). The topbar's chip
        carried the same three facts 100 px above this and is gone from this
        page; the programme's own 42-character database string is a hint now,
        not a 2 rem headline.

        The verdict shares the title's baseline — PRODUCT §1's question and
        its answer on one line, rather than two paragraphs apart. */}
    <div class="planner-head">
      <h1 class="planner-title" id="planner-title">Semesterplan</h1>
      {/* The plan's long name and the plan's verdict, as one band. On a phone
          they share a line under the title and the whole banner is two rows
          instead of four (mob-A, 2026-07-31): 138 px of naming before the week
          was 16 % of the screen, and three of those rows were one sentence
          each. On a wide screen `display: contents` dissolves this box and the
          two go back to their own grid areas — the verdict at the far end of
          the title's line, the hint under the pair. */}
      <div class="planner-meta">
        {/* Always filled by `renderBanner` — the programme's long name, or the
            semester the empty week is for — so the one line it will occupy is
            held from first paint rather than appearing at mount and pushing
            the whole page down 21px. */}
        <p class="np-hint planner-context-line" id="planner-context-line"></p>
        <p class="planner-status" id="planner-status">
          <span class="planner-verdict" id="planner-grid-status" aria-live="polite"></span>
        </p>
      </div>
      {/* The page's one permanent opener for studieinfo. It was an underlined
            word in the hint line: 37x22, under WCAG 2.5.8's 24px floor, and
            reading as a footnote rather than as the control that changes
            everything above it.

            Lucide `settings-2`, the exact mark `settingsIcon()` builds for the
            course rows — "settings for this thing", one scope up. It was a
            hand-drawn approximation of that icon, which is worse than either
            using it or using something else. */}
      <button type="button" class="np-btn planner-edit-plan" id="planner-edit-plan">
        <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M20 7h-9" />
            <path d="M14 17H5" />
            <circle cx="17" cy="17" r="3" />
            <circle cx="7" cy="7" r="3" />
          </svg>
        <span id="planner-edit-plan-label">Endre</span>
      </button>
    </div>
  </div>

  <p class="np-hint planner-link-note" id="planner-link-note" hidden></p>

  <div id="planner-main">
    {/* The week runs the page's full width and the other two share the row
        under it. Transposing the grid is what made that possible: the week is
        ~290 px tall now instead of 768, so everything fits without a side rail
        stealing a third of the axis — the rail was starving the grid to 864 px
        of 1440 while its own column sat empty below the fold. It also retires
        the Uke/Emner tabs, which existed so a phone did not have to scroll
        past a very tall week. */}
    <section class="planner-week" id="planner-region-week" aria-labelledby="planner-week-heading">
      <div class="planner-direction" id="planner-direction" hidden>
        <h2 class="planner-direction-title" id="planner-direction-title"></h2>
        <p class="np-hint planner-direction-note" id="planner-direction-note"></p>
        <div class="planner-direction-actions" id="planner-direction-actions" hidden>
          <button type="button" class="np-btn" id="planner-direction-btn">Velg emner</button>
        </div>
      </div>

      <div class="planner-section-head">
        {/* Kept for the region's accessible name and hidden from the page: a
            grid of weekdays with an hour ruler over it does not need to be
            told it is a week (REWORK-2026-07-30j). */}
        <h2 class="planner-section-name sr-only" id="planner-week-heading">Uke</h2>
        {/* Two ways of looking at one week, and one layer you can add to it —
            and they used to be identical uppercase mono `.np-toggle`s in a
            row, so nothing in the form said that one PICKS and the other ADDS.
            The switch is words with a rule that slides between them; the layer
            is a box you tick. Neither can be mistaken for the other now
            (REWORK-2026-07-30b).

            "Uke" is the timetable shape a student already knows from every
            other calendar: days as columns, time down. Its id keeps saying
            `kolonner` because that is the value in localStorage and the name of
            the module that draws it — the transposed week it used to be named
            against now lives only on /emne/[code]/. */}
        <div class="planner-section-tools">
          <div class="planner-view-tabs" role="group" aria-label="Velg hvordan uka vises">
            <button
              type="button"
              class="planner-view-tab"
              id="planner-view-kolonner"
              aria-pressed="true"
            >
              Uke
            </button>
            <button
              type="button"
              class="planner-view-tab"
              id="planner-view-tavle"
              aria-pressed="false"
            >
              Liste
            </button>
          </div>
          <button
            type="button"
            class="planner-others-toggle"
            id="planner-others-toggle"
            aria-pressed="false"
          >
            <span class="planner-check" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5">
                <path d="m4 12 6 6L20 6" />
              </svg>
            </span>
            Øvinger og labber
          </button>
        </div>
      </div>
      {/* `data-reserve`: the week's height, held from first paint until a real
          week is drawn into it — a LEASE, like the exam list's and the course
          page's, not a permanent floor. See planner-week.css. */}
      <div class="planner-grid-frame" id="planner-grid-frame" data-reserve></div>
      <div class="planner-grid-notes" id="planner-grid-notes"></div>
    </section>

    <div class="planner-below">
      <section class="planner-exams" aria-labelledby="planner-exam-heading">
        <div class="planner-section-head">
          <h2 class="planner-section-name" id="planner-exam-heading">Eksamener</h2>
          <p class="planner-section-sub" id="planner-exam-status" aria-live="polite"></p>
        </div>
        <div class="planner-exam-list" id="planner-exam-list-host" data-reserve></div>
      </section>

      <section class="planner-courses" id="planner-region-courses" aria-labelledby="planner-courses-heading">
        <div class="planner-section-head">
          <h2 class="planner-section-name" id="planner-courses-heading">Emner</h2>
        </div>

        {/* The load, drawn: 30 sp as a track, each course a segment in its own
            hue. Same shape as the exam band over the exam list. */}
        {/* Not `hidden`: an empty strip has to keep occupying its 15px, or the
            course rows under it move down when the first segment is drawn.
            CLAUDE.md's own rule — something that must stay laid out while it
            shows nothing wants a state, not the attribute — and the state here
            is simply "no children". The reservation is the probe's
            (tokens.css), so a plan-less page still spends nothing on it. */}
        <div class="planner-load" id="planner-credit-strip" aria-hidden="true"></div>
        <p class="planner-load-foot">
          <span class="np-data planner-credit-line" id="planner-credit-line">0 av 30 sp</span>
        </p>
        <p class="np-hint planner-credit-note" id="planner-credit-note" hidden></p>

        <div class="planner-course-rows" id="planner-course-rows" data-reserve></div>

        <p class="planner-gap-line" id="planner-gap-line" hidden>
          <span class="np-note" id="planner-gap-text"></span>
          <button type="button" class="np-btn planner-gap-btn" id="planner-gap-btn">
            Velg fra studieplanen
          </button>
        </p>

        <button type="button" class="np-btn planner-add-course-btn" id="planner-add-course-btn">
          Legg til emne
        </button>

        <details class="planner-plan-panel" id="planner-plan-panel" hidden>
          <summary class="np-summary planner-plan-summary">Fra studieplanen</summary>
          <div class="planner-plan-body" id="planner-plan-body"></div>
        </details>
      </section>
    </div>

    <p class="np-hint planner-provenance" id="planner-provenance" hidden></p>
  </div>
</Layout>

<style>
  /* --- Banner ------------------------------------------------------------ */

  /* Facts only. The one control that changes any of them is the "endre" button
     in the hint line below the title. */
  .planner-banner {
    margin-bottom: var(--space-4);
  }

  /* The question and its answer on one baseline. The verdict pushes to the far
     end on a wide screen and drops under the title when there is no room.

     A grid rather than a wrapping flex row, because two of these four things
     are a PAIR and wrapping cannot be told that: the code line and the long
     programme name are one statement said twice, and flex wrapped the verdict
     and the Endre button in between them. Areas keep the pair adjacent at every
     width.

     Two rows on a phone, not four: the four-row stack cost 138 px before a
     single hour of the week was drawn. Nothing is dropped and nothing is
     collapsed behind a tap. */
  .planner-head {
    display: grid;
    grid-template-areas:
      "title edit"
      "meta  meta";
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-2) var(--gap-3);
  }

  .planner-title {
    grid-area: title;
  }

  /* Baseline-aligned rather than centred: the hint is 13 px and the verdict
     18 px, and centring two sizes on one line makes neither sit on the line the
     title established. Wrapping is allowed. */
  .planner-meta {
    grid-area: meta;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--gap-3);
    min-width: 0;
  }

  .planner-context-line {
    grid-area: hint;
  }

  .planner-status {
    grid-area: verdict;
  }

  /* Wide enough for all three on the title's line: the code, the control that
     changes it, and the verdict at the far end. */
  @media (min-width: 46rem) {
    .planner-head {
      grid-template-areas:
        "title edit verdict"
        "hint  hint hint";
      grid-template-columns: auto auto minmax(0, 1fr);
      align-items: center;
      gap: var(--space-1) var(--gap-6);
    }

    /* The box dissolves and its two children become grid children again, each
       in the area it has always had. */
    .planner-meta {
      display: contents;
    }

    .planner-status {
      justify-self: end;
    }
  }

  .planner-verdict {
    font-size: var(--text-md);
  }

  .planner-verdict:empty {
    display: none;
  }

  /* THE TITLE. `MTFYMA Kull 24 H26` — the plan in the notation a student writes
     on a timetable, so it is the mono at the page-title step. Data-Is-Mono has
     always governed codes and counts; this follows it to the top of the scale.

     No separators between the three parts, only spaces: in a mono face at
     display size the facts already read as three. The short forms are what pays
     for the code beside them at 390 px.

     Slightly under --text-xl because Spline Sans Mono sets wider and taller
     than Schibsted Grotesk: 1.75rem mono optically matches 2rem grotesk.

     WHICH OF THE TWO IS DECIDED BY THE PROBE, NOT BY A CLASS. As a class added
     at mount, the title changed face and size (27px → 39px at 390px) one frame
     after the server had painted the other one, with the whole page hanging off
     its baseline. `html[data-plan="program"]` is the same fact known before the
     first frame; the grotesk is the DEFAULT because "no plan" is the only state
     a static page can honestly assume. `syncPlanProbe` keeps it true after. */
  .planner-title {
    font-family: var(--font-sans);
    font-size: var(--text-xl);
    letter-spacing: -0.015em;
    line-height: var(--leading-tight);
  }

  :global(html[data-plan="program"]) .planner-title {
    font-family: var(--font-mono);
    font-size: clamp(1.4rem, 4.4vw, 1.75rem);
    letter-spacing: -0.02em;
  }

  :global(.planner-title-part) {
    white-space: nowrap;
  }

  .planner-context-line {
    max-width: none;
    /* One line, held. `renderBanner` always writes this, so the line is never
       absent once the page is alive. */
    min-height: 1lh;
  }

  /* The title and the control that changes it as one group, so the verdict
     still lands at the far end under `space-between`.
     A real `.np-btn`: 36px of target, a paper surface and a mark — paper rather
     than an ink fill, so it does not out-shout the fact beside it, but it no
     longer hides from the pointer either. */
  .planner-edit-plan {
    grid-area: edit;
    flex: none;
  }

  .planner-edit-plan svg {
    width: 16px;
    height: 16px;
    flex: none;
  }

  /* On the title's own line there is no width for the word: the mark is the
     same `settings-2` the course rows use, and `renderBanner` writes the button
     an aria-label, so only the ink changes. A square --control-h box, 44 px on
     every touch device. */
  @media (max-width: 46rem) {
    /* The row the verdict shares with the hint, held at the taller of the two:
       the verdict appears, says "henter timeplan …", then vanishes under the
       `:has(.is-clean)` rule below, so without this the page moved 4px each
       way. */
    .planner-meta {
      min-height: 1.6rem;
    }

    .planner-edit-plan {
      justify-content: center;
      width: var(--control-h);
      padding: 0;
    }

    #planner-edit-plan-label {
      /* Not `display: none`: the label is this button's visible name at every
         other width, and a screen reader ignoring aria-label needs one. */
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    /* The verdict is not shown when it is a pass: "ingen kollisjoner" answers a
       question you only ask when something might be wrong, and on a phone it
       spent a line of the first screen saying nothing is. A collision still
       says so, as does "kan ikke sjekkes", and the line keeps its `aria-live`.

       Matched through the wrapper with `:has()`, not on the span, or the flex
       gap stays behind. `.is-clean` is the only class that survives
       `renderVerdict`'s own `className =`. */
    .planner-status:has(.is-clean) {
      display: none;
    }
  }

  /* The unanswered studieretning. It asks you to do something; it does not say
     the term works — so it is ink, not the verdict green. */
  :global(.planner-context-direction) {
    color: var(--ui);
  }

  .planner-link-note:not([hidden]) {
    max-width: none;
    margin-bottom: var(--space-4);
  }

  /* --- Layout ------------------------------------------------------------ */

  /* The week takes the page's whole width; Eksamener and Emner share the row
     under it. This is what transposing the grid bought: at ~290 px tall a side
     rail is no longer the only way to see the plan and the week at once, and
     the rail was costing the week a third of its axis. It also retires the
     Uke/Emner tabs, which existed because a phone could not scroll past a
     768 px week. */
  #planner-main {
    display: grid;
    gap: var(--space-7);
  }

  .planner-week,
  .planner-exams,
  .planner-courses {
    min-width: 0;
  }

  .planner-below {
    display: grid;
    gap: var(--space-7);
  }

  @media (min-width: 60rem) {
    .planner-below {
      /* Exams first: they are time-ordered, so they rhyme with the week above.
         The course list wants a measure rather than a fraction. */
      /* The track carries the rule's gutter as well as the list, so the list
         keeps its measure rather than paying for the division. */
      grid-template-columns: minmax(0, 1fr) calc(22rem + var(--space-6));
      align-items: start;
      gap: var(--space-6);
    }

    /* One hairline divides the two, with the same distance on either side.
       Two bordered boxes would say the same thing twice over — the page IS
       the surface, so what separates a column from its neighbour is the line
       between them, not a wall around each. Only where they sit side by side:
       stacked, each section head's own rule already divides them, and a
       vertical line down a phone would divide nothing. */
    .planner-courses {
      padding-inline-start: var(--space-6);
      border-inline-start: 1px solid var(--border);
    }
  }

  @media (min-width: 84rem) {
    .planner-below {
      grid-template-columns: minmax(0, 1fr) calc(26rem + var(--space-6));
    }
  }

  /* --- The week's open question ------------------------------------------ */

  /* Studieretning, campus, or "your period is all electives" (B2/U8). It sits
     above the grid because the same question behind a tab is a dead end.

     No panel, and no coloured bar down its side either: this page knows it has
     at most one open question, so the box was a container for a count it
     already knew, and a card's whole job on a white ground is to say "these
     things belong together" — which a title and the sentence under it say by
     standing next to each other. What makes it findable is that it is the only
     thing above the week and it carries the only button there; the accent is
     already spent on that button, which is the token's one job
     (Ink-Before-Chrome: structure is tone and hairlines, never a border). */
  .planner-direction:not([hidden]) {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  /* A title, not a kicker: "Studieplanen din for Høst 2026 er valgfri" is a
     sentence, and 11.5 px uppercase tracked mono is where D10 draws the line. */
  .planner-direction-title {
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
    letter-spacing: normal;
  }

  .planner-direction-note {
    margin: 0;
    max-width: none;
  }

  .planner-direction-actions:not([hidden]) {
    margin-top: var(--space-1);
  }

  /* --- Section headers --------------------------------------------------- */

  /* A section head is a NAME and its controls, divided by a rule — not four
     unrelated things on one line with a four-hundred-pixel gap in the middle. */
  .planner-section-head {
    display: flex;
    align-items: baseline;
    gap: var(--gap-3) var(--gap-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border-strong);
  }


  /* The grotesk at a real size, not tracked-out uppercase mono. Data-Is-Mono
     means the mono is for times, dates, codes and counts, so spending it on
     section labels spends the rule's meaning too. */
  .planner-section-name {
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
    letter-spacing: -0.015em;
  }

  /* Controls sit at the far end of the rule, grouped, so the head reads
     "name … tools" rather than as a row of equal-weight chips. */
  .planner-section-tools {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--gap-2) var(--gap-3);
    margin-left: auto;
  }

  /* The default ink is set at ZERO specificity on purpose, and that is what
     `:global(:where(…))` buys. Astro scopes this block by appending
     [data-astro-cid-…], so a plain class selector here computes (0,2,0) and
     outranks `.np-note-clash` (0,1,0) — the flagship verdict printed in the
     page's quietest gray while the no-collision state was green, inverting
     Red-Is-Collision. `:where()` alone is not enough: the attribute strategy
     emits `[data-astro-cid-…]:where(…)`, which TIES with the primitive and
     leaves the colour to Vite's emit order. `:global()` drops the attribute. */
  :global(:where(.planner-section-sub, .planner-verdict)) {
    color: var(--muted);
  }

  .planner-section-sub {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
  }

  .planner-section-sub:empty {
    display: none;
  }

  /* --- Rutenett ⇄ Liste ------------------------------ */

  /* Two words and a rule that slides between them. No box: a box says "press
     me", and this is a place you already are — one of the two is always true,
     which is exactly what a filled chip cannot say. The rule is also the mark
     the section head draws underneath, so the control sits IN the structure.

     The BUTTONS carry the padding, not the container — a target is only a
     target where the pointer lands. The negative margins pull that height back
     out of the layout, so the head keeps its rhythm while each word becomes a
     34px target (WCAG 2.5.8 asks 24; a bare word at --text-sm is 21). */
  .planner-view-tabs {
    position: relative;
    display: flex;
    gap: var(--gap-4);
    margin-block: -9px -8px;
    padding-bottom: 2px;
  }

  /* The travelling rule. `--view-x` / `--view-w` are written by
     `renderViewTabs` from the live button boxes, because the labels are
     different widths in every font and at every zoom level. It rides the same
     --dur and --ease as the week's own layer change. */
  .planner-view-tabs::after {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    bottom: 0;
    height: 2px;
    width: var(--view-w, 0);
    background: var(--ui);
    transform: translateX(var(--view-x, 0));
    transition:
      transform var(--dur) var(--ease),
      width var(--dur) var(--ease);
  }

  :global(.planner-view-tab) {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-normal);
    color: var(--muted);
    /* 9px above and 4px below: the rule has to stay ~6px under the word, so the
       target grows mostly upward, into the gap the head already has. */
    padding: 9px var(--space-1) 4px;
    margin-inline: calc(-1 * var(--space-1));
    border-radius: var(--radius-xs);
    transition: color var(--dur-fast) var(--ease);
  }

  :global(.planner-view-tab:hover) {
    color: var(--ui);
  }

  :global(.planner-view-tab[aria-pressed="true"]) {
    color: var(--fg);
    font-weight: var(--weight-medium);
  }

  /* The layer, not a view: a box you tick. Nothing about it is shaped like the
     pair beside it — it ADDS øvinger and labber; it does not choose how the
     week is drawn. */
  .planner-others-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-2);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--muted);
    /* Same trade as the tabs: a 24px target, none of it spent on layout. */
    margin-block: -7px;
    padding-block: 7px;
    border-radius: var(--radius-xs);
    transition: color var(--dur-fast) var(--ease);
  }

  .planner-others-toggle:hover,
  .planner-others-toggle[aria-pressed="true"] {
    color: var(--fg);
  }

  .planner-check {
    display: grid;
    place-items: center;
    flex: none;
    width: 14px;
    height: 14px;
    border: 1px solid var(--control-edge);
    border-radius: var(--radius-xs);
    transition:
      background var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }

  .planner-others-toggle[aria-pressed="true"] .planner-check {
    background: var(--ui);
    border-color: var(--ui);
  }

  .planner-check svg {
    width: 10px;
    height: 10px;
    color: var(--ui-contrast);
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease);
  }

  .planner-others-toggle[aria-pressed="true"] .planner-check svg {
    opacity: 1;
  }

  /* The gap that says "different kind of control" — wider than any gap inside
     either group. */
  .planner-section-tools {
    gap: var(--gap-2) var(--space-5);
  }

  /* The verdict: PRODUCT §1's primary job answered beside the kicker, in three
     states and three inks —
       .is-clean       — the week holds together (Green-Means-Fits)
       .np-note-clash  — two things cannot coexist (Red-Is-Collision)
       neither         — the muted default: "kan ikke sjekkes". A gap is not a
                         clash and not a pass, so it may spend neither colour.
     `.is-clean` keeps its `:global()` because plannerApp adds it. */
  :global(.planner-section-sub.is-clean),
  :global(.planner-verdict.is-clean) {
    color: var(--verdict);
  }

  .planner-credit-line {
    font-size: var(--text-md);
    color: var(--muted);
    transition: color var(--dur-fast) var(--ease);
  }

  /* Green means it fits — exactly a full load, never an overload. "37,5 av 30
     sp" in the same green as 30 tells the student the opposite of the truth;
     the overload keeps neutral ink and explains itself below. */
  .planner-credit-line.is-full {
    color: var(--verdict);
  }

  .planner-credit-note:not([hidden]) {
    max-width: none;
    margin-bottom: var(--space-3);
  }

  /* --- Weekly grid --------------------------------------------------------- */

  /* The week's own geometry and ink — and the scroll-edge mask — are in
     src/styles/planner-week.css, shared with /emne/[code]/. What follows is
     only what this page adds. */

  /* --- Empty / fallback week card ---------------------------------------- */

  /* The four empty states that carry an action, centered in the week frame so
     the one next step is where the plan would be, not tucked under it. */
  :global(.planner-week-card) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-6) var(--space-3);
    text-align: center;
  }

  :global(.planner-week-card-hint) {
    margin: 0;
    max-width: var(--measure);
  }

  :global(.planner-week-card-secondary) {
    /* A quiet text action under the primary button, not a second button. */
    font-size: var(--text-sm);
  }

  /* --- Exam list ---------------------------------------------------------- */

  /* The dated list and nothing above it: the dates already say how many exams
     there are and how far apart they fall. */
  :global(.exam-empty) {
    margin: 0 0 var(--space-2);
  }

  .planner-exam-list {
    margin-bottom: var(--space-6);
  }

  /* A LEASE, not a layout — the same instrument `/emne/[code]/` uses, with the
     same honesty clause: it holds the space the dated list is about to need
     while the bundles are in flight, and `renderGridAndExams` hands it back the
     moment the list shows whatever it will finally show, including a failed
     fetch. Nothing is left holding a hole open under a short answer.

     Sized per PLANNED COURSE, because the number of exams is exactly what we
     are waiting to find out. Measured 65px per course; 3.5rem is deliberately
     under it, so a longer list nudges the page down rather than snatching
     content out from under a thumb.

     On a phone this is the one that matters: `.planner-below` is a single
     column there, so an arriving exam list pushes the whole Emner section
     down. */
  .planner-exam-list[data-reserve] {
    min-height: calc(var(--plan-courses) * 3.5rem);
  }

  /* A narrow column wraps the row, so the same five exams measure 400px here
     against 325px wide. Measured, not scaled: this is the width where the list
     is the thing pushing Emner down. */
  @media (max-width: 46rem) {
    .planner-exam-list[data-reserve] {
      min-height: calc(var(--plan-courses) * 4.85rem);
    }
  }

  /* Rendered synchronously from the store at mount, so this bridges paint to
     mount and nothing further; `renderCourseRows` drops it on its first pass.
     One row per stored course, dropped ones included, a little under 52px. */
  .planner-course-rows[data-reserve] {
    min-height: calc(var(--plan-courses) * 3rem);
  }

  /* --- The month band ------------------------------- */

  /* One row per month, one cell per day. It answers "how clustered is this"
     before a date is read, for about 40 px. */
  :global(.exam-band) {
    display: grid;
    gap: var(--gap-1);
    margin-bottom: var(--space-4);
  }

  :global(.exam-band-row) {
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr);
    align-items: center;
    gap: 0 var(--gap-3);
  }

  :global(.exam-band-name) {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking);
    text-transform: uppercase;
    color: var(--faint);
    text-align: right;
  }

  :global(.exam-band-days) {
    display: grid;
    grid-template-columns: repeat(31, minmax(0, 1fr));
    gap: 2px;
  }

  :global(.exam-band-day) {
    height: 13px;
    background: var(--card);
    border-radius: 1px;
  }

  /* The weekend ground is what makes a cluster look like a cluster rather than
     four evenly-spaced marks — one tonal step was invisible at 9 px. */
  :global(.exam-band-day.is-weekend) {
    background: color-mix(in srgb, var(--fg) 15%, var(--card));
  }

  /* Days past the end of a short month: nothing there, not an empty day. */
  :global(.exam-band-day.is-void) {
    background: transparent;
  }

  /* A colliding day keeps BOTH courses' hues (examList.ts sets the split fill
     inline) and takes a ring instead of a red fill: a flat red square says
     "something collides" and throws away the fact you would act on. A ring is a
     different KIND of mark from a fill (Red-Is-Collision). */
  :global(.exam-band-day.is-clash) {
    box-shadow: 0 0 0 1px var(--clash);
  }

  /* --- The list: one rule, and it runs along the list -------------------- */

  /* A rule across a list divides it; a gap is not a division between two exams,
     it is the distance between them, and distance runs along the list. So the
     only rule left is vertical, the exams are knots on it, and the gaps hang
     between them. */
  :global(.exam-list) {
    --exam-date-col: 5.5rem;
    --exam-knot: 20px;
    position: relative;
    list-style: none;
    max-width: none;
    margin: 0;
    padding: 0;
  }

  :global(.exam-list)::before {
    content: "";
    position: absolute;
    left: calc(var(--exam-date-col) + var(--gap-4) + 3px);
    top: 1.1em;
    bottom: 1.1em;
    width: 1px;
    background: var(--border-strong);
  }

  /* Two columns: the date, then the exam. The countdown that used to need a
     third is a segment on the rule now. Keeping the column "just in case" was
     not free: an `auto` track collapses to zero but its gap does not, and those
     16 px pushed "Skriftlig skoleeksamen" onto a second line at 390 px. */
  :global(.exam-row) {
    display: grid;
    grid-template-columns: var(--exam-date-col) minmax(0, 1fr);
    align-items: baseline;
    gap: 0 var(--gap-4);
    padding: var(--space-1) 0;
  }

  /* The one row that still has a third thing to say. */
  :global(.exam-row.exam-dateless) {
    grid-template-columns: var(--exam-date-col) minmax(0, 1fr) auto;
  }

  :global(.exam-date) {
    text-align: right;
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
    letter-spacing: -0.02em;
  }

  :global(.exam-weekday) {
    font-size: var(--text-xs);
    font-weight: var(--weight-normal);
    color: var(--faint);
    margin-inline-end: var(--gap-1);
  }

  :global(.exam-what) {
    position: relative;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0 var(--gap-2);
    min-width: 0;
    padding-inline-start: var(--exam-knot);
  }

  /* The knot: the same mark as the course list's own dot, so a colour means
     one thing wherever it appears. */
  :global(.exam-what)::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    top: 0.35em;
    width: 7px;
    height: 7px;
    background: var(--dot);
  }

  :global(.exam-code) {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  /* Vurderingsform (D6): whether a date is something to revise for or
     something to hand in. */
  :global(.exam-form) {
    min-width: 0;
    font-size: var(--text-sm);
    color: var(--muted);
  }

  /* "dato ikke satt", and nothing else — see `.exam-row.exam-dateless`. */
  :global(.exam-away) {
    font-size: var(--text-xs);
    color: var(--faint);
    white-space: nowrap;
  }

  /* The distance, hung on the rule between two knots. */
  :global(.exam-gap) {
    padding: var(--space-1) 0 var(--space-1)
      calc(var(--exam-date-col) + var(--gap-4) + var(--exam-knot));
    font-size: var(--text-xs);
    color: var(--faint);
  }

  /* The first segment — today to the next exam. Same rule and indent as the
     lesedager connectors, so the list reads as one chain of distances; never
     `is-tight`'s red, because how far off an exam is says nothing about how
     much room there is to revise. */
  :global(.exam-gap.is-away) {
    color: var(--muted);
  }

  :global(.exam-gap.is-tight) {
    color: var(--clash);
    font-weight: var(--weight-medium);
  }

  :global(.exam-dateless) :global(.exam-date) {
    color: var(--faint);
  }

  /* Named in words, because the split cell and the ring are the fast read but
     neither survives a screen reader, a printout or colour blindness. */
  :global(.exam-clash) {
    margin: var(--space-3) 0 0;
    padding-inline-start: calc(var(--exam-date-col) + var(--gap-4) + var(--exam-knot));
  }

  /* --- The load strip ------------------------------ */

  /* Same shape as the exam band over the exam list: a drawing that answers the
     section's question, then the rows that answer it precisely. */
  .planner-load {
    display: block;
    margin-bottom: var(--space-2);
  }

  /* The track's own height, held while the strip is still empty — otherwise the
     first segment shoves every course row down 23px. Keyed on the probe so a
     page with no plan reserves nothing. */
  .planner-load:empty {
    min-height: calc(var(--plan-any) * 15px);
    margin-bottom: calc(var(--plan-any) * var(--space-2));
  }

  :global(.planner-load-track) {
    display: flex;
    gap: 2px;
    height: 15px;
    background: var(--card);
    border-radius: var(--radius-xs);
    overflow: hidden;
  }

  /* Printed ink, exactly like a week bar and an exam-band cell, so one course
     is one colour in all three places. `flex-grow` is the credits. */
  :global(.planner-load-seg) {
    flex-basis: 0;
    background: color-mix(in srgb, var(--dot) var(--block-mix), var(--block-base));
  }

  /* The gap to a full load is empty track, never a segment — it is the absence
     of a course and must not read as one. */
  :global(.planner-load-rest) {
    flex-basis: 0;
  }

  .planner-load-foot {
    margin-bottom: var(--space-4);
  }

  /* --- Course rows ------------------------------------------------------- */

  .planner-course-rows {
    display: flex;
    flex-direction: column;
    margin-bottom: var(--space-3);
  }

  /* Four columns — chip, name, credits, settings — and NO horizontal rule. Five
     borders divide up what is one thing: your semester. A vertical rule was
     tried and rejected for saying something untrue: a rule with knots on it
     encodes *sequence*, and a course list is a set, not a timeline.

     The row itself is inert. As a full-width `<button>` it had a pointer cursor
     and a hover wash while showing nothing pressable. The one target is the
     settings button at its end. */
  :global(.planner-course-row) {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 0 var(--gap-3);
    padding: var(--space-2) 0;
  }

  /* The one interactive thing in the row, and it looks it: a real target at the
     touch size the tokens define, revealed to full ink on hover. Quiet at rest
     because five of them down a rail would out-shout the courses. */
  :global(.planner-course-open) {
    color: var(--faint);
    flex: none;
    transition:
      color var(--dur-fast) var(--ease),
      background var(--dur-fast) var(--ease);
  }

  :global(.planner-course-open:hover) {
    color: var(--fg);
    background: var(--wash);
  }

  :global(.planner-course-open svg) {
    width: 16px;
    height: 16px;
  }

  /* The chip is the week's own bar at label size: printed hue, code knocked
     out of it. */
  :global(.planner-course-chip) {
    display: inline-flex;
    align-items: center;
    height: 20px;
    padding: 0 var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: -0.01em;
    white-space: nowrap;
    border-radius: var(--radius-xs);
    background: color-mix(in srgb, var(--dot) var(--block-mix), var(--block-base));
    color: var(--on-block);
  }

  /* A dropped course is still a course: the chip keeps its shape and loses its
     fill, so the row reads as switched off rather than as missing (§0.3). No
     ring either — the fill going and the text going faint is what "grayed out"
     means here. */
  :global(.planner-course-row.is-dropped .planner-course-chip) {
    background: transparent;
    color: var(--faint);
  }

  /* `anywhere` is the floor, not the plan: almost every name wraps at a space,
     but a single 21-character word is wider than the rail at its narrowest. */
  :global(.planner-course-name) {
    display: grid;
    gap: 1px;
    min-width: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    overflow-wrap: anywhere;
  }

  :global(.planner-course-row.is-dropped .planner-course-title) {
    color: var(--faint);
    text-decoration: line-through;
    text-decoration-color: var(--border-strong);
  }

  /* Right-aligned in its own column so the figures stack into something a
     student can add up by eye. */
  :global(.planner-course-sp) {
    font-size: var(--text-xs);
    color: var(--faint);
    text-align: right;
    white-space: nowrap;
  }

  /* The attention mark sits under the name, so the credit column stays a column
     of figures. Ink, not red — it is an invitation to open the row. Not green
     either: "se detaljer" is a thing to do, not a verdict. */
  :global(.planner-course-flag) {
    font-size: var(--text-xs);
    color: var(--ui);
  }

  /* --- Credit gap door --------------------------------------------------- */

  .planner-gap-line:not([hidden]) {
    display: flex;
    align-items: baseline;
    gap: var(--gap-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-4);
  }

  /* --- Add-course button --------------------------------------------------
     One button opens the dialog addCourse.ts builds itself (its CSS lives in
     site.css, alongside the studieinfo modal it is modeled on). */

  .planner-add-course-btn {
    align-self: flex-start;
  }

  /* --- "Fra studieplanen" panel -----------------------------------------
     The study plan's choice groups with their VERBATIM prose (DR-5 — never
     assert "group satisfied"), collapsed by default so it never buries the plan
     itself. Shown only when a programme is set and the period has choice
     groups. */
  .planner-plan-panel {
    margin-top: var(--space-4);
  }

  :global(.planner-plan-group) {
    margin-top: var(--space-3);
  }

  :global(.planner-plan-group-name) {
    margin-bottom: var(--space-1);
  }

  :global(.planner-plan-group-desc) {
    max-width: none;
    margin-bottom: var(--space-2);
  }

  :global(.planner-plan-row) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    column-gap: var(--gap-3);
    row-gap: var(--space-1);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--border);
  }

  :global(.planner-plan-row-head) {
    grid-column: 1;
    display: inline-flex;
    align-items: baseline;
    gap: var(--gap-2);
    flex-wrap: wrap;
  }

  :global(.planner-plan-row-name) {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  :global(.planner-plan-row-meta) {
    grid-column: 1 / -1;
    color: var(--muted);
    font-size: var(--text-xs);
  }

  :global(.planner-plan-add) {
    grid-column: 2;
    grid-row: 1;
    justify-self: end;
  }

  /* Only present when the join has a gap to admit, so it
     is spaced as a note that arrived rather than as a permanent footer. */
  .planner-provenance:not([hidden]) {
    max-width: none;
    margin-top: var(--space-6);
  }
</style>

<script
  is:inline
  type="application/json"
  id="planner-program-options"
  set:html={programOptionsJson}
/>
<script>
  import { mountPlannerApp } from "../../components/planner/plannerApp.js";
  import { onPage } from "../../lib/pageLifecycle.ts";
  import semestersData from "../../../data/semesters.json";

  // Must run per page-load, not once per module: under ClientRouter this module
  // is evaluated only the first time it is fetched, so mounting at top level
  // left the planner an empty shell after any in-site navigation back to it.
  // `mountPlannerApp` owns the single store and mounts its modals itself.
  onPage((signal) => {
    const optionsEl = document.getElementById("planner-program-options");
    if (!optionsEl) return;
    const programOptions = optionsEl.textContent ? JSON.parse(optionsEl.textContent) : [];
    mountPlannerApp(semestersData, programOptions, signal);
  });
</script>
