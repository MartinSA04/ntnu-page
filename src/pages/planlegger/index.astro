---
import WeekControls from "../../components/WeekControls.astro";
import Layout from "../../layouts/Layout.astro";
// The week's geometry and ink live in one stylesheet because every surface that
// draws a week mounts the same `weekView`. Only this page's exam list stays
// scoped below.
import "../../styles/planner-week.css";
// The plan's own sections — see the file's header.
import "../../styles/plan-surface.css";

const description =
  "Velg studieprogram og kull, se ukeplanen med en gang: forelesninger, kollisjoner, eksamensdatoer og studiepoeng.";

// The programme catalogue used to be inlined here as a 27 KB
// `<script type="application/json">` for the studieinfo modal this page owned.
// The picker lives in the profile panel now, which opens from the topbar on
// every page — including the 5 470 `/emne/[code]/` documents — so it is a
// build-time static file (`src/pages/data/programs.json.ts`) that
// `studieinfo.ts` fetches the first time a student opens the panel.
---

<Layout title="Planlegger" description={description} wide surface="planner">
  {/* FIRST RUN. The predicate is `html:not([data-plan])`, and it is not a new
      mechanism: Layout's pre-paint probe sets `data-plan` when a programme is
      stored or ANY semester holds a course, and removes it otherwise — so its
      absence is exactly "no plan anywhere". Written before the first frame and
      kept true for the rest of the visit by `planProbe.ts`, which is what lets
      a CSS-gated static panel paint WITH the document: no mount flash, no
      reserved void, no reservation to lease and release.

      ANYWHERE is load-bearing. `--plan-courses` is this term's count, because
      reservations are measured in rows being drawn; the ATTRIBUTE is global,
      because a student sitting in a term they have not filled has not become a
      first-time visitor, and greeting them as one hides the semester control
      that is their way back. The gate is live in both directions: emptying the
      plan brings this screen back, which it must, since everything the planner
      draws over an empty plan presupposes the courses that are gone.

      The predicate is COMPLETE because the `#v2;…` hash is gone (PRODUCT §6):
      localStorage is now the only way a plan can reach this page, so what the
      probe reads is the whole truth about whether this load has one.

      It replaces the week card that used to stand in the middle of a fully
      drawn planner whose every control acted on nothing — a layer box, a view
      switch, a semester select and a countdown to registering courses the
      student had not chosen yet. */}
  <section class="planner-firstrun" id="planner-firstrun" aria-labelledby="planner-firstrun-title">
    {/* The invitation, not "Semesterplan": the wordmark says that 100px above,
        and a page title repeating the wordmark spends the largest type on the
        screen saying nothing. */}
    <h1 class="planner-firstrun-title" id="planner-firstrun-title">
      Lag timeplanen for semesteret
    </h1>
    <p class="np-hint planner-firstrun-lead">
      Velg studieprogrammet og kullet ditt, så lages timeplanen din med forelesninger,
      kollisjoner og eksamensdatoer.
    </p>
    {/* The picker itself, mounted by `plannerApp.ts` under `commit: "on-kull"`.
        No autofocus: it is the only control on the screen, and an autofocus
        opens a phone keyboard over the sentence explaining why it is there. */}
    <div class="planner-firstrun-picker" id="planner-firstrun-picker"></div>
    <p class="np-hint planner-firstrun-alt">
      Har du emnekodene? <button
        type="button"
        class="np-navlink planner-firstrun-link"
        id="planner-firstrun-add">Legg dem til direkte.</button
      >
    </p>
  </section>

  <div class="planner-banner">
    {/* ONE ROW, AND IT NEVER WRAPS: the plan's name at the leading edge, the
        term pinned to the trailing one. It used to carry the week's two
        controls as well and fold into a `⋯` menu below 46rem, and it used to
        end in a share mark — none of that is true any more. The layer box and
        the view switch went down to the week's own section (they are questions
        about the WEEK), the share mark went with sharing, and what is left fits
        390px on its own: a name that may ellipsise and a select that sizes to
        "Høst 2026".

        Nothing here folds, and `menuPanel.ts` is deleted outright — the shell
        topbar was its last caller, and that bar is down to one link and one
        icon square. */}
    <div class="planner-head">
      {/* THE NAME IS THE DOOR. The title states the plan's programme and kull;
          pressing it is how you change them. That is what makes the picker's
          entrance free: a control in the action run would have cost a slot,
          and this costs no width at all.

          Underlined on HOVER only, the grammar `.planner-chip.is-jump` already
          sets for the collision verdict: at rest this is the plan's name and
          has to read as one. The chevron carries the affordance while nothing
          is hovering it. */}
      <button type="button" class="planner-name" id="planner-name-btn">
        <span class="planner-name-text">
          <h1 class="planner-title" id="planner-title">Semesterplan</h1>
          {/* Always filled by `renderBanner` — the programme's long name, or
              the semester the empty week is for — so the one line it will
              occupy is held from first paint rather than appearing at mount and
              pushing the whole page down 21px.

              WHICH WEEK is no longer on it. That fact moved into the week's own
              picker, which is where it belongs now that it is something you
              choose rather than something you are told. */}
          <p class="np-hint planner-context-line" id="planner-context-line"></p>
        </span>
        {/* It does not turn. This opens a modal, not a disclosure under itself,
            so there is no open state for the mark to reflect. */}
        <svg
          class="planner-name-mark"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"><path d="m6 9 6 6 6-6"></path></svg>
      </button>

      {/* WHICH TERM THIS PLAN IS FOR — the one thing in this row that is not a
          verb. It came out of the studieinfo modal because it describes the
          PLAN and belongs beside the plan's own name, and it commits on change,
          which is what the modal did anyway.

          No visible label: every option names itself ("Høst 2026"), and a
          "Semester" caption beside it would spend a phone row restating the
          option. `renderSemesterOptions` fills it. */}
      <div class="np-select-shell planner-semester">
        <select class="np-select" id="planner-semester-select" aria-label="Semester"></select>
        <svg
          class="np-select-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <path d="m6 9 6 6 6-6" />
        </svg>
      </div>

    </div>

    {/* WHAT THE WEEK COULD NOT DRAW, and nothing else. The verdict that used
        to live here — a collision count, a load chip, three flavours of «the
        check could not run» — is deleted (PRODUCT D17). What is left is the one
        thing whose absence would be a lie: a course whose timetable never
        arrived is missing from the drawn week, and a missing course looks
        exactly like a course with no teaching.

        No reservation under it, deliberately. Holding 22px for a line that is
        usually silent costs the week that space on every load; the shift when
        a gap does arrive is one row, on the minority of plans that have one. */}
    <p class="planner-verdict" id="planner-grid-status" aria-live="polite"></p>

    {/* WHICH STUDY PLAN THE PREFILL CAME FROM, when it is not the one asked
        for. See `renderPlanNote` — the 404 step-back walks back up to two
        cohorts, and a week built from another cohort's curriculum under this
        page's own «Kull 2026» title is a wrong answer delivered as a right
        one. */}
    <p class="np-hint planner-plan-note" id="planner-plan-note" hidden></p>
  </div>

  <div id="planner-main">
    {/* The week runs the page's full width and the other two share the row
        under it. Transposing the grid is what made that possible: the week is
        ~290 px tall now instead of 768, so everything fits without a side rail
        stealing a third of the axis — the rail was starving the grid to 864 px
        of 1440 while its own column sat empty below the fold. It also retires
        the Uke/Emner tabs, which existed so a phone did not have to scroll
        past a very tall week. */}
    <section class="planner-week" id="planner-region-week" aria-labelledby="planner-week-heading">
      <div class="planner-direction" id="planner-direction" hidden>
        <h2 class="planner-direction-title" id="planner-direction-title"></h2>
        <p class="np-hint planner-direction-note" id="planner-direction-note"></p>
        <div class="planner-direction-actions" id="planner-direction-actions" hidden>
          <button type="button" class="np-btn" id="planner-direction-btn">Velg emner</button>
        </div>
      </div>

      {/* Kept for the region's accessible name and hidden from the page: a
          grid of weekdays with an hour ruler over it does not need to be told
          it is a week, and the picker under this says which one it is. */}
      <h2 class="planner-section-name sr-only" id="planner-week-heading">Uke</h2>
      {/* WHICH WEEKS, THEN WHICH LAYERS AND WHICH SHAPE. One component, three
          surfaces, and `mountWeekView` owns everything inside it. */}
      <WeekControls />
      {/* `data-reserve`: the week's height, held from first paint until a real
          week is drawn into it — a LEASE, like the exam list's and the course
          page's, not a permanent floor. See planner-week.css. */}
      <div class="planner-grid-frame" id="planner-grid-frame" data-reserve></div>
      <div class="planner-grid-notes" id="planner-grid-notes"></div>
    </section>

    <div class="planner-below">
      <section class="planner-exams" id="planner-region-exams" aria-labelledby="planner-exam-heading">
        <div class="planner-section-head">
          <h2 class="planner-section-name" id="planner-exam-heading">Eksamener</h2>
        </div>
        <div class="planner-exam-list" id="planner-exam-list-host" data-reserve></div>
      </section>

      <section class="planner-courses" id="planner-region-courses" aria-labelledby="planner-courses-heading">
        <div class="planner-section-head">
          <h2 class="planner-section-name" id="planner-courses-heading">Emner</h2>
        </div>


        <div class="planner-course-rows" id="planner-course-rows" data-reserve></div>


        {/* THE PRIMARY ACTION, AT THE FOOT OF THE LIST IT ADDS TO. It spent a
            while up in the page's bar, on two arguments that have both expired.

            "Indistinguishable from 'Velg fra studieplanen' beside it" — there
            is no such button any more. It was a second, conditional door to the
            same dialog this one opens, and the study plan it named is a filter
            inside that dialog now.

            "Below the fold on a phone" — the layout it was measured in is
            gone (the Uke/Emner tabs it mentions no longer exist), and the
            Emner column is one scroll under the week either way. Re-measured
            at 390 px: it lands well down the page on a full plan, which is
            where the thing it adds to also is. A student who wants a sixth
            course is looking at the five they have.

            It keeps the accent, which is the token's one job (DESIGN §2's
            One-Job-Accent) — `renderBanner` takes it off while there is no
            plan, because then the empty week's own "Velg studieprogram" is the
            primary action and two accents is none. */}
        <button
          type="button"
          class="np-btn np-btn--primary planner-add-course-btn"
          id="planner-add-course-btn"
        >
          Legg til emne
        </button>

        <details class="planner-plan-panel" id="planner-plan-panel" hidden>
          <summary class="np-summary planner-plan-summary">Fra studieplanen</summary>
          <div class="planner-plan-body" id="planner-plan-body"></div>
        </details>

      </section>
    </div>
  </div>
</Layout>

<style>
  /* --- First run ---------------------------------------------------------- */

  /* THE GATE. Two rules, one predicate, and the probe already writes it.
     First run owns the page outright: no bar, no tools, no deadline, no
     verdict, no week frame, no Eksamener, no Emner. Everything on those
     surfaces presupposes the content that is missing, which is why the empty
     planner read worse than an empty page — four controls acting on nothing
     around a card floating in 900px of white. */
  .planner-firstrun {
    display: none;
  }

  /* ONE predicate, and the probe already writes it. `data-plan` is present
     whenever the student has a plan ANYWHERE — a programme, or a course in any
     semester — so switching to an empty term keeps the planner while emptying
     the plan outright brings this screen back. `syncFirstRun` mounts the picker
     on exactly the same test. */
  html:not([data-plan]) .planner-firstrun {
    display: block;
  }

  html:not([data-plan]) .planner-banner,
  html:not([data-plan]) #planner-main {
    display: none;
  }

  /* Narrower than the page: this is one question, and a 90rem measure would
     set a single input adrift in it. */
  .planner-firstrun {
    max-width: 34rem;
    margin: var(--space-7) auto 0;
  }

  .planner-firstrun-title {
    margin-bottom: var(--space-2);
    font-size: var(--text-2xl);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.01em;
  }

  .planner-firstrun-lead {
    margin-bottom: var(--space-5);
    max-width: 30rem;
  }

  /* The picker mounts a frame after paint and everything under it moves when it
     does, so its height is held from the first frame. 4rem against a measured
     69.8px settle: deliberately a few px UNDER, so the residual nudges the line
     below it down rather than snatching it upward (the house rule for every
     reservation here). Re-measure before changing this. */
  .planner-firstrun-picker {
    min-height: 4rem;
    margin-bottom: var(--space-4);
  }

  /* The secondary route is one quiet line, not a paper button competing with
     the field above it. */
  .planner-firstrun-link {
    display: inline;
    padding: 0;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

</style>

<script>
  import { mountPlannerApp } from "../../components/planner/plannerApp.js";
  import { onPage } from "../../lib/pageLifecycle.ts";
  import semestersData from "../../../data/semesters.json";

  // Must run per page-load, not once per module: under ClientRouter this module
  // is evaluated only the first time it is fetched, so mounting at top level
  // left the planner an empty shell after any in-site navigation back to it.
  onPage((signal) => {
    mountPlannerApp(semestersData, signal);
  });
</script>
