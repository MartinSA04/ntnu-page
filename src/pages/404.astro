---
import semestersData from "../../data/semesters.json";
import Layout from "../layouts/Layout.astro";

/**
 * 404 recovery. Both search forms are gone (Task 13) — the course-search one
 * quoted the attempted path segment straight into a `value` attribute, which
 * is exactly the bug study S9 found (`value="404"` funneling every 404 into
 * `/?q=404` → "Ingen treff."). Deleting the forms kills that bug class
 * outright rather than patching the one stray value: the two honest ways
 * back are the homepage and the planner itself.
 */
const MONTH_ABBR = [
  "jan",
  "feb",
  "mar",
  "apr",
  "mai",
  "jun",
  "jul",
  "aug",
  "sep",
  "okt",
  "nov",
  "des",
];

/** `"2026-07-24T…"` → `"24. jul 2026"` (DR-8 provenance line). */
function formatCrawlDate(iso: string): string {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return iso;
  const month = MONTH_ABBR[d.getUTCMonth()] ?? "";
  return `${d.getUTCDate()}. ${month} ${d.getUTCFullYear()}`;
}

const crawlDate = formatCrawlDate(semestersData.crawledAt);
---

<Layout title="Fant ikke siden — Semesterplan" description="Siden finnes ikke.">
  <p class="np-kicker notfound-kicker">404</p>
  <h1 class="notfound-title">Vi fant ikke siden du lette etter</h1>
  <p class="np-hint notfound-lede">
    Siden kan være borte, eller adressen kan være stavet feil. Planleggeren er den raskeste veien
    videre.
  </p>
  <div class="notfound-actions">
    <a class="np-btn" href="/planlegger/">Åpne planleggeren</a>
    <a class="np-navlink" href="/">Til forsiden</a>
  </div>
  <p class="np-note notfound-crawldate">{`Data hentet ${crawlDate} fra NTNU`}</p>
</Layout>

<style>
  .notfound-kicker {
    margin-bottom: var(--space-3);
  }
  .notfound-title {
    margin-bottom: var(--space-3);
    max-width: var(--measure);
  }
  .notfound-lede {
    margin-bottom: var(--space-5);
  }
  .notfound-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--gap-4);
    margin-bottom: var(--space-5);
  }
  .notfound-crawldate {
    margin-bottom: var(--space-4);
  }
</style>
