---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Fant ikke siden — Semesterplan" description="Siden finnes ikke.">
  <p class="np-kicker notfound-kicker">404</p>
  <p class="notfound-lede">Vi fant ikke siden du lette etter.</p>
  <a class="np-btn np-press notfound-home" href="/">Til forsiden</a>
</Layout>

<style>
  .notfound-kicker {
    margin-bottom: var(--space-3);
  }
  .notfound-lede {
    font-size: var(--text-md);
    margin-bottom: var(--space-5);
  }
</style>
