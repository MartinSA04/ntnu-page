---
import Layout from "../../layouts/Layout.astro";

const description = "Søk i NTNUs emnekatalog etter emnekode, emnenavn eller studiested.";
---

<Layout title="Emner — Semesterplan" description={description} wide>
  <p class="np-kicker emner-kicker">Emner</p>
  <h1 class="emner-title">Emnekatalog</h1>

  <div class="np-field emner-search">
    <input
      type="search"
      id="emner-search"
      name="q"
      placeholder="Søk etter emnekode eller emnenavn …"
      aria-label="Søk i emnekatalogen"
    />
  </div>

  <div class="emner-facets" id="emner-facets" role="group" aria-label="Filtrer på studiested"></div>

  <p class="emner-status np-hint" id="emner-status" aria-live="polite">Henter emner …</p>

  <ul class="emner-results" id="emner-results"></ul>
</Layout>

<style>
  .emner-kicker {
    margin-bottom: var(--space-2);
  }
  .emner-title {
    margin-bottom: var(--space-5);
  }
  .emner-search {
    margin-bottom: var(--space-4);
    max-width: var(--measure);
  }
  .emner-facets {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }
  .emner-status {
    margin-bottom: var(--space-4);
  }
  .emner-results {
    list-style: none;
    /* D6: a result list is a data surface, not prose — no 38rem cap. */
    max-width: none;
    display: flex;
    flex-direction: column;
  }
  .emner-retry {
    margin-left: var(--space-3);
  }

  :global(.emner-row) {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-2);
    border-bottom: 1px solid var(--border);
  }
  :global(.emner-row-link) {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    flex: 1;
    min-width: 0;
    text-decoration: none;
    color: var(--fg);
    padding: var(--space-1) 0;
    transition: color var(--dur-fast) var(--ease);
  }
  :global(.emner-row-link:hover) {
    color: var(--accent-ink);
  }
  :global(.emner-row-code) {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--muted);
    flex-shrink: 0;
    min-width: 7em;
  }
  :global(.emner-row-name) {
    font-size: var(--text-base);
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  :global(.emner-row-exam),
  :global(.emner-row-location) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--faint);
    flex-shrink: 0;
  }
  :global(.emner-row-stale) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--faint);
    flex-shrink: 0;
  }
  :global(.emner-row-actions) {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0;
  }
  /* A3: at 390px the exam note used to overflow into the location, and the
     name collapsed to zero width. Wrap the link instead: code + notes on the
     first line, the full name on its own. */
  @media (max-width: 40rem) {
    :global(.emner-row) {
      align-items: flex-start;
      gap: var(--space-2);
    }
    :global(.emner-row-link) {
      flex-wrap: wrap;
      gap: var(--space-2);
    }
    :global(.emner-row-code) {
      order: 1;
      min-width: 0;
    }
    :global(.emner-row-exam) {
      order: 2;
      flex-shrink: 1;
    }
    :global(.emner-row-location),
    :global(.emner-row-stale) {
      order: 3;
      flex-shrink: 1;
    }
    :global(.emner-row-name) {
      order: 4;
      flex-basis: 100%;
      white-space: normal;
      overflow: visible;
    }
    :global(.emner-row-actions) {
      flex-direction: column;
      align-items: flex-end;
      gap: var(--space-1);
    }
    /* Stacked, the two halves are no longer one line, so the separator that
       joined them would read as a stray mark. */
    :global(.emner-row-planlink::before) {
      content: none;
    }
  }
</style>

<script>
  import { clashSentence, planClash, semesterLabel } from "../../components/site/planClash";
  import { onPage } from "../../lib/pageLifecycle.ts";
  import { createPlanStore } from "../../lib/planner/store.ts";
  import semestersData from "../../../data/semesters.json";

  /**
   * `public/data/search-index.json`, positional. Elements 4 and 5 were
   * appended by the two-year crawl (C1/C2): the catalog course version that
   * has to ride along on every timetable call, and the catalog years the
   * course is actually offered in.
   */
  interface SearchIndex {
    year: number;
    courses: [
      code: string,
      name: string,
      location: string | null,
      exams: [season: string, date: string | null][],
      version: string | null,
      offeredYears: number[],
    ][];
  }

  const RESULT_CAP = 200;
  const SEASON_LABELS: Record<string, string> = {
    SPRING: "vår",
    AUTUMN: "høst",
    WINTER: "vinter",
    SUMMER: "sommer",
  };

  // Case/diacritic-insensitive substring matching. NFD decomposes Å but not
  // Æ/Ø, so those two are pre-mapped — "okonomi" has to find "Økonomi" on a
  // Norwegian site, and 238 course codes contain Ø or Æ.
  function fold(value: string): string {
    return value
      .toLowerCase()
      .replace(/æ/g, "a")
      .replace(/ø/g, "o")
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "");
  }

  /** The comma-joined catalog location string as city facets: "Gjøvik, Trondheim" → 2. */
  function cities(location: string | null): string[] {
    if (!location) return [];
    return location
      .split(",")
      .map((c) => c.trim())
      .filter((c) => c !== "");
  }

  function examNote(exams: [string, string | null][]): string {
    if (exams.length === 0) return "";
    const seasons = [...new Set(exams.map(([season]) => SEASON_LABELS[season] ?? season))];
    return seasons.length > 0 ? `eksamen ${seasons.join(", ")}` : "";
  }

  // Per page-load, not per module: ClientRouter evaluates this module once,
  // so wiring at top level left the search dead after any in-site navigation.
  onPage((signal) => {
    const statusEl = document.getElementById("emner-status") as HTMLParagraphElement | null;
    const resultsEl = document.getElementById("emner-results") as HTMLUListElement | null;
    const facetsEl = document.getElementById("emner-facets") as HTMLDivElement | null;
    const searchInput = document.getElementById("emner-search") as HTMLInputElement | null;
    if (!statusEl || !resultsEl || !facetsEl || !searchInput) return;

    const semester = semestersData.current;
    const term = semesterLabel(semester.name);
    const store = createPlanStore(semester.id);
    const clashSemester = {
      id: semester.id,
      name: semester.name,
      teachingWeeks: semester.teachingWeeks,
    };

    let index: SearchIndex | null = null;
    let loading = false;
    const activeCities = new Set<string>();
    /**
     * The add controls of the rows currently on screen. A plan change updates
     * them in place instead of re-running `render()`: rebuilding the list
     * removed the very button the student had just pressed, which threw
     * keyboard focus back to `<body>` on every add (A5).
     */
    const rows: { sync: () => void; invalidate: () => void }[] = [];

    function setStatus(text: string, voice: "hint" | "note"): void {
      if (!statusEl) return;
      statusEl.className = `emner-status ${voice === "note" ? "np-note" : "np-hint"}`;
      statusEl.textContent = text;
    }

    function setAddState(button: HTMLButtonElement, inPlan: boolean, code: string): void {
      button.setAttribute("aria-pressed", String(inPlan));
      button.textContent = inPlan ? "Lagt til" : "Legg til";
      if (!inPlan) button.setAttribute("aria-label", `Legg til ${code} i planen`);
      else button.setAttribute("aria-label", `Fjern ${code} fra planen`);
    }

    /**
     * U11: the clash verdict has to be available *before* the student
     * commits, but a verdict per visible row is 200 timetable fetches. So it
     * is computed lazily on first hover/focus of the row's add button and
     * cached on the element — by the time a pointer or keyboard focus is on
     * the button, the answer is on its tooltip and accessible name.
     */
    function attachClashPreview(
      button: HTMLButtonElement,
      code: string,
      version: string,
    ): () => void {
      let checked = false;
      const check = async (): Promise<void> => {
        if (checked) return;
        checked = true;
        const currentPlan = store.loadPlan();
        const verdict = await planClash(
          { code, version },
          currentPlan,
          clashSemester,
          undefined,
          currentPlan.program?.code ?? null,
        );
        const sentence = clashSentence(verdict, clashSemester);
        button.title = sentence;
        const inPlan = store.hasCourse(code);
        button.setAttribute(
          "aria-label",
          `${inPlan ? `Fjern ${code} fra planen` : `Legg til ${code} i planen`} — ${sentence}`,
        );
      };
      button.addEventListener("pointerenter", check);
      button.addEventListener("focus", check);
      // The verdict is a diff against the plan, so it expires the moment the
      // plan does. Dropping the cached answer is honest; recomputing 200 of
      // them eagerly is 200 timetable fetches.
      return () => {
        checked = false;
        button.title = "";
      };
    }

    function render(): void {
      if (!statusEl || !resultsEl || !searchInput) return;
      if (!index) return;
      const query = fold(searchInput.value.trim());

      // §3: no 200-row dump on an empty query — the page is a search mode,
      // not a browsable catalog.
      if (query === "") {
        resultsEl.replaceChildren();
        setStatus(`Skriv for å søke i ${index.courses.length} emner.`, "hint");
        return;
      }

      const filtered = index.courses.filter(([code, name, location]) => {
        if (activeCities.size > 0 && !cities(location).some((c) => activeCities.has(c)))
          return false;
        return fold(code).includes(query) || fold(name).includes(query);
      });

      resultsEl.replaceChildren();
      rows.length = 0;
      const shown = filtered.slice(0, RESULT_CAP);
      for (const [code, name, location, exams, version, offeredYears] of shown) {
        const row = document.createElement("li");
        row.className = "emner-row";

        const link = document.createElement("a");
        link.className = "emner-row-link";
        link.href = `/emne/${encodeURIComponent(code)}/`;

        const codeEl = document.createElement("span");
        codeEl.className = "emner-row-code";
        codeEl.textContent = code;

        const nameEl = document.createElement("span");
        nameEl.className = "emner-row-name";
        nameEl.textContent = name;

        link.append(codeEl, nameEl);

        const note = examNote(exams);
        if (note) {
          const noteEl = document.createElement("span");
          noteEl.className = "emner-row-exam";
          noteEl.textContent = note;
          link.append(noteEl);
        }

        if (location) {
          const locEl = document.createElement("span");
          locEl.className = "emner-row-location";
          locEl.textContent = location;
          link.append(locEl);
        }

        // C1: 703 of these rows come from last year's catalog only. Adding
        // one contributes zero blocks to this semester's week, so the row
        // says so rather than letting the "+" imply otherwise.
        const stale = !offeredYears.includes(index.year);
        if (stale) {
          const staleEl = document.createElement("span");
          staleEl.className = "emner-row-stale";
          staleEl.textContent = `ikke undervist i ${index.year}`;
          link.append(staleEl);
        }

        const actions = document.createElement("span");
        actions.className = "emner-row-actions";

        const addBtn = document.createElement("button");
        addBtn.type = "button";
        addBtn.className = "np-btn emner-row-add";

        // I2: the row was write-only — the "+" mutated localStorage and said
        // nothing. The button reports the state now. It used to be followed by
        // a "se ukeplanen →" link; the topbar chip already goes there.

        const sync = (): void => {
          const inPlan = store.hasCourse(code);
          setAddState(addBtn, inPlan, code);
        };
        sync();

        addBtn.addEventListener("click", () => {
          if (store.hasCourse(code)) {
            store.removeCourse(code);
          } else {
            store.addCourse({ code, name, version: version || "1" });
          }
          // `savePlan` dispatches synchronously, so `syncRows` has normally
          // already run by here; this keeps the button honest if it has not.
          sync();
        });

        let invalidate = (): void => {};
        if (!stale) invalidate = attachClashPreview(addBtn, code, version || "1");
        else addBtn.title = `Undervises ikke i ${term} — ingen kollisjon å sjekke.`;
        rows.push({ sync, invalidate });

        actions.append(addBtn);
        row.append(link, actions);
        resultsEl.append(row);
      }

      setStatus(
        filtered.length > RESULT_CAP
          ? `viser ${RESULT_CAP} av ${filtered.length} treff`
          : `${filtered.length} treff`,
        "note",
      );
    }

    /**
     * U15: the raw catalog strings are combinations ("Gjøvik, Trondheim"),
     * so one chip per string filtered with `includes` *excluded* courses
     * taught in more cities than the chip named. Facets are cities, and
     * selecting several means OR.
     */
    function renderFacets(): void {
      if (!facetsEl || !index) return;
      const all = new Set<string>();
      for (const [, , location] of index.courses) for (const city of cities(location)) all.add(city);
      const sorted = [...all].sort((a, b) => a.localeCompare(b, "nb"));

      facetsEl.replaceChildren();
      for (const city of sorted) {
        const chip = document.createElement("button");
        chip.type = "button";
        chip.className = "np-toggle np-toggle--text";
        chip.textContent = city;
        chip.setAttribute("aria-pressed", String(activeCities.has(city)));
        chip.addEventListener("click", () => {
          if (activeCities.has(city)) activeCities.delete(city);
          else activeCities.add(city);
          chip.setAttribute("aria-pressed", String(activeCities.has(city)));
          render();
        });
        facetsEl.append(chip);
      }
    }

    /**
     * Fetches the index. On failure the page keeps a way back: an explicit
     * "prøv igjen" action, plus a retry on the next keystroke — the previous
     * version left `index` undefined for the rest of the session.
     */
    async function loadIndex(): Promise<void> {
      if (index || loading || !statusEl) return;
      loading = true;
      setStatus("Henter emner …", "hint");
      try {
        const res = await fetch("/data/search-index.json");
        if (!res.ok) throw new Error(`${res.status}`);
        index = (await res.json()) as SearchIndex;
      } catch {
        setStatus("Klarte ikke å hente emnene.", "hint");
        const retry = document.createElement("button");
        retry.type = "button";
        retry.className = "np-btn emner-retry";
        retry.textContent = "prøv igjen";
        retry.addEventListener("click", () => {
          loadIndex();
        });
        statusEl.append(retry);
        return;
      } finally {
        loading = false;
      }
      renderFacets();
      render();
    }

    searchInput.addEventListener(
      "input",
      () => {
        if (!index) {
          loadIndex();
          return;
        }
        render();
      },
      { signal },
    );
    /** In-place refresh of the rows on screen — see `rows`. */
    function syncRows(): void {
      for (const row of rows) {
        row.invalidate();
        row.sync();
      }
    }

    signal.addEventListener("abort", store.onPlanChange(syncRows));

    const params = new URLSearchParams(location.search);
    const initialQuery = params.get("q");
    if (initialQuery) searchInput.value = initialQuery;

    loadIndex();
  });
</script>
