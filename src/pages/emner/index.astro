---
import Layout from "../../layouts/Layout.astro";

const description = "Søk i NTNUs emnekatalog etter emnekode, emnenavn eller studiested.";
---

<Layout title="Emner — Semesterplan" description={description} wide>
  <p class="np-kicker emner-kicker">Emner</p>
  <h1 class="emner-title">Emnekatalog</h1>

  <div class="np-field emner-search">
    <input
      type="search"
      id="emner-search"
      name="q"
      placeholder="Søk etter emnekode eller emnenavn …"
      aria-label="Søk i emnekatalogen"
    />
  </div>

  <div class="emner-chips" id="emner-chips" role="group" aria-label="Filtrer på studiested"></div>

  <p class="emner-status np-note" id="emner-status" aria-live="polite">henter emner …</p>

  <ul class="emner-results" id="emner-results"></ul>
</Layout>

<style>
  .emner-kicker {
    margin-bottom: var(--space-2);
  }
  .emner-title {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-5);
  }
  .emner-search {
    margin-bottom: var(--space-4);
    max-width: var(--measure);
  }
  .emner-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }
  .emner-status {
    margin-bottom: var(--space-4);
  }
  .emner-results {
    list-style: none;
    display: flex;
    flex-direction: column;
  }
  :global(.emner-row) {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-2) var(--space-2);
    border-bottom: 1px solid var(--border);
  }
  :global(.emner-row-link) {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    flex: 1;
    min-width: 0;
    text-decoration: none;
    color: var(--fg);
    padding: var(--space-1) 0;
    transition: color var(--dur-fast) var(--ease);
  }
  :global(.emner-row-link:hover) {
    color: var(--accent-ink);
  }
  :global(.emner-row-code) {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--muted);
    flex-shrink: 0;
    width: 7em;
  }
  :global(.emner-row-name) {
    font-size: var(--text-base);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  :global(.emner-row-exam) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--faint);
    flex-shrink: 0;
  }
  :global(.emner-row-location) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--faint);
    margin-left: auto;
    flex-shrink: 0;
  }
</style>

<script>
  import { onPage } from "../../lib/pageLifecycle.ts";
  import { createPlanStore } from "../../lib/planner/store.ts";
  import semestersData from "../../../data/semesters.json";

  interface SearchIndex {
    year: number;
    courses: [
      code: string,
      name: string,
      location: string,
      exams: [season: string | null, date: string | null][],
    ][];
  }

  const RESULT_CAP = 200;
  const SEASON_LABELS: Record<string, string> = {
    SPRING: "vår",
    AUTUMN: "høst",
    WINTER: "vinter",
    SUMMER: "sommer",
  };

  // Case/diacritic-insensitive substring matching (Æ/Ø/Å fold to A/O/A).
  function fold(value: string): string {
    return value
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLowerCase();
  }

  function examNote(exams: [string | null, string | null][]): string {
    if (exams.length === 0) return "";
    const seasons = [
      ...new Set(exams.map(([season]) => (season ? (SEASON_LABELS[season] ?? season) : null))),
    ].filter((s): s is string => s !== null);
    return seasons.length > 0 ? `eksamen ${seasons.join(", ")}` : "";
  }

  function setAddState(button: HTMLButtonElement, inPlan: boolean, code: string): void {
    button.setAttribute("aria-pressed", String(inPlan));
    button.setAttribute("aria-label", inPlan ? `Fjern ${code} fra planen` : `Legg til ${code} i planen`);
    button.textContent = inPlan ? "✓" : "+";
  }

  // Per page-load, not per module: ClientRouter evaluates this module once,
  // so wiring at top level left the search dead after any in-site navigation.
  onPage((signal) => {
  const statusEl = document.getElementById("emner-status") as HTMLParagraphElement | null;
  const resultsEl = document.getElementById("emner-results") as HTMLUListElement | null;
  const chipsEl = document.getElementById("emner-chips") as HTMLDivElement | null;
  const searchInput = document.getElementById("emner-search") as HTMLInputElement | null;
  if (!statusEl || !resultsEl || !chipsEl || !searchInput) return;

  const store = createPlanStore(semestersData.current?.id ?? "");

  let index: SearchIndex | null = null;
  let activeLocation: string | null = null;

  function render(): void {
    if (!statusEl || !resultsEl || !searchInput) return;
    if (!index) return;
    const query = fold(searchInput.value.trim());
    const filtered = index.courses.filter(([code, name, location]) => {
      if (activeLocation && !location.includes(activeLocation)) return false;
      if (!query) return true;
      return fold(code).includes(query) || fold(name).includes(query);
    });

    resultsEl.replaceChildren();
    const shown = filtered.slice(0, RESULT_CAP);
    for (const [code, name, location, exams] of shown) {
      const row = document.createElement("li");
      row.className = "emner-row";

      const link = document.createElement("a");
      link.className = "emner-row-link";
      link.href = `/emne/${code}/`;

      const codeEl = document.createElement("span");
      codeEl.className = "emner-row-code";
      codeEl.textContent = code;

      const nameEl = document.createElement("span");
      nameEl.className = "emner-row-name";
      nameEl.textContent = name;

      link.append(codeEl, nameEl);

      const note = examNote(exams);
      if (note) {
        const noteEl = document.createElement("span");
        noteEl.className = "emner-row-exam";
        noteEl.textContent = note;
        link.append(noteEl);
      }

      const locEl = document.createElement("span");
      locEl.className = "emner-row-location";
      locEl.textContent = location;

      const addBtn = document.createElement("button");
      addBtn.type = "button";
      addBtn.className = "np-icon-btn np-press";
      setAddState(addBtn, store.hasCourse(code), code);
      addBtn.addEventListener("click", () => {
        if (store.hasCourse(code)) {
          store.removeCourse(code);
        } else {
          store.addCourse({ code, name });
        }
        setAddState(addBtn, store.hasCourse(code), code);
      });

      row.append(link, locEl, addBtn);
      resultsEl.append(row);
    }

    statusEl.textContent =
      filtered.length > RESULT_CAP
        ? `viser ${RESULT_CAP} av ${filtered.length} treff`
        : `${filtered.length} treff`;
  }

  function renderChips(locations: string[]): void {
    if (!chipsEl) return;
    chipsEl.replaceChildren();
    for (const location of locations) {
      const chip = document.createElement("button");
      chip.type = "button";
      chip.className = "np-toggle";
      chip.textContent = location;
      chip.setAttribute("aria-pressed", "false");
      chip.addEventListener("click", () => {
        const next = activeLocation === location ? null : location;
        activeLocation = next;
        for (const other of chipsEl.querySelectorAll(".np-toggle")) {
          other.setAttribute("aria-pressed", String(other === chip && next !== null));
        }
        render();
      });
      chipsEl.append(chip);
    }
  }

  async function init(): Promise<void> {
    if (!statusEl || !searchInput) return;
    const params = new URLSearchParams(location.search);
    const initialQuery = params.get("q");
    if (initialQuery) searchInput.value = initialQuery;

    try {
      const res = await fetch("/data/search-index.json");
      if (!res.ok) throw new Error(`${res.status}`);
      index = (await res.json()) as SearchIndex;
    } catch {
      statusEl.textContent = "klarte ikke å hente emner";
      return;
    }

    const locations = [...new Set(index.courses.map(([, , loc]) => loc))].sort((a, b) =>
      a.localeCompare(b, "nb"),
    );
    renderChips(locations);
    render();
  }

  searchInput.addEventListener("input", render, { signal });
  signal.addEventListener("abort", store.onPlanChange(render));

  init();
  });
</script>
