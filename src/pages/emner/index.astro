---
import Layout from "../../layouts/Layout.astro";

const description = "Søk i NTNUs emnekatalog etter emnekode, emnenavn eller studiested.";
---

<Layout title="Emner — Semesterplan" description={description} wide>
  <p class="np-kicker emner-kicker">Emner</p>
  <h1 class="emner-title">Emnekatalog</h1>

  <div class="np-field emner-search">
    <input
      type="search"
      id="emner-search"
      name="q"
      placeholder="Søk etter emnekode eller emnenavn …"
      aria-label="Søk i emnekatalogen"
    />
  </div>

  <div class="emner-facets" id="emner-facets" role="group" aria-label="Filtrer på studiested"></div>

  <p class="emner-status np-hint" id="emner-status" aria-live="polite">Henter emner …</p>

  <ul class="emner-results" id="emner-results"></ul>
</Layout>

<style>
  .emner-kicker {
    margin-bottom: var(--space-2);
  }
  .emner-title {
    margin-bottom: var(--space-5);
  }
  .emner-search {
    margin-bottom: var(--space-4);
    max-width: var(--measure);
  }
  .emner-facets {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }
  .emner-status {
    margin-bottom: var(--space-4);
  }
  .emner-results {
    list-style: none;
    /* D6: a result list is a data surface, not prose — no 38rem cap. */
    max-width: none;
    /* The UA's 40px list indent stepped every row right of the search field
       that produced them, and cost 12% of a 360px viewport (mob-8). */
    padding-inline-start: 0;
    display: flex;
    flex-direction: column;
  }
  .emner-retry {
    margin-left: var(--space-3);
  }

  :global(.emner-row) {
    display: flex;
    align-items: center;
    /* The clash line is a full-width third child, so the row has to wrap. */
    flex-wrap: wrap;
    gap: var(--space-4);
    padding: var(--space-2);
    border-bottom: 1px solid var(--border);
  }
  :global(.emner-row-link) {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    flex: 1;
    min-width: 0;
    text-decoration: none;
    color: var(--fg);
    padding: var(--space-1) 0;
    transition: color var(--dur-fast) var(--ease);
  }
  /* The row already rests at full ink, so hover cannot answer with colour —
     it answers with the underline, the same mark every other link uses. */
  :global(.emner-row-link:hover) {
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--ui) 45%, transparent);
  }
  :global(.emner-row-code) {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--muted);
    flex-shrink: 0;
    min-width: 7em;
  }
  :global(.emner-row-name) {
    font-size: var(--text-base);
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  :global(.emner-row-exam),
  :global(.emner-row-location) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--faint);
    flex-shrink: 0;
  }
  :global(.emner-row-stale) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--faint);
    flex-shrink: 0;
  }
  :global(.emner-row-actions) {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0;
  }
  /* The pre-add verdict, on its own line under the row it belongs to. It used
     to live only in `title`/`aria-label`, so a phone — where the tap that
     triggers the check is the same tap that commits the add — never showed
     it at all (search-2). Empty until a hover/focus/tap resolves, and an
     empty <p> takes no line box, so a cold list is unchanged. */
  :global(.emner-row-clash) {
    flex-basis: 100%;
    margin: 0;
  }
  :global(.emner-row-clash.is-clash) {
    color: var(--clash);
  }
  /* Truth at the end of the list too, not only in the status line 200 rows
     above it (search-1). */
  :global(.emner-more) {
    padding: var(--space-3) var(--space-2);
  }
  /* A3: at 390px the exam note used to overflow into the location, and the
     name collapsed to zero width. Wrap the link instead: code + notes on the
     first line, the full name on its own. */
  @media (max-width: 40rem) {
    :global(.emner-row) {
      align-items: flex-start;
      gap: var(--space-2);
    }
    :global(.emner-row-link) {
      flex-wrap: wrap;
      gap: var(--space-2);
    }
    :global(.emner-row-code) {
      order: 1;
      min-width: 0;
    }
    :global(.emner-row-exam) {
      order: 2;
      flex-shrink: 1;
    }
    :global(.emner-row-location),
    :global(.emner-row-stale) {
      order: 3;
      flex-shrink: 1;
    }
    :global(.emner-row-name) {
      order: 4;
      flex-basis: 100%;
      white-space: normal;
      overflow: visible;
    }
    :global(.emner-row-actions) {
      flex-direction: column;
      align-items: flex-end;
      gap: var(--space-1);
    }
    /* Stacked, the two halves are no longer one line, so the separator that
       joined them would read as a stray mark. */
    :global(.emner-row-planlink::before) {
      content: none;
    }
  }
</style>

<script>
  import { type CatalogRow, searchCatalog } from "../../components/site/catalogSearch";
  import { clashSentence, planClash } from "../../components/site/planClash";
  import { onPage } from "../../lib/pageLifecycle.ts";
  import { createPlanStore } from "../../lib/planner/store.ts";
  import semestersData from "../../../data/semesters.json";

  /** `public/data/search-index.json`; the row shape is `CatalogRow`. */
  interface SearchIndex {
    year: number;
    courses: CatalogRow[];
  }

  const RESULT_CAP = 200;
  /**
   * How long the pointer has to rest on a row's button before its clash check
   * fires, and how long typing has to stop before the live region and the URL
   * are written. Both exist because `render()` rebuilds every row on every
   * keystroke (search-7, search-8, astro-6).
   */
  const HOVER_DWELL_MS = 200;
  const SETTLE_MS = 350;
  const SEASON_LABELS: Record<string, string> = {
    SPRING: "vår",
    AUTUMN: "høst",
    WINTER: "vinter",
    SUMMER: "sommer",
  };

  /** The comma-joined catalog location string as city facets: "Gjøvik, Trondheim" → 2. */
  function cities(location: string | null): string[] {
    if (!location) return [];
    return location
      .split(",")
      .map((c) => c.trim())
      .filter((c) => c !== "");
  }

  function examNote(exams: [string, string | null][]): string {
    if (exams.length === 0) return "";
    const seasons = [...new Set(exams.map(([season]) => SEASON_LABELS[season] ?? season))];
    return seasons.length > 0 ? `eksamen ${seasons.join(", ")}` : "";
  }

  // Per page-load, not per module: ClientRouter evaluates this module once,
  // so wiring at top level left the search dead after any in-site navigation.
  onPage((signal) => {
    const statusEl = document.getElementById("emner-status") as HTMLParagraphElement | null;
    const resultsEl = document.getElementById("emner-results") as HTMLUListElement | null;
    const facetsEl = document.getElementById("emner-facets") as HTMLDivElement | null;
    const searchInput = document.getElementById("emner-search") as HTMLInputElement | null;
    if (!statusEl || !resultsEl || !facetsEl || !searchInput) return;

    const semester = semestersData.current;
    const store = createPlanStore(semester.id);
    const clashSemester = {
      id: semester.id,
      name: semester.name,
      teachingWeeks: semester.teachingWeeks,
    };

    let index: SearchIndex | null = null;
    let loading = false;
    const activeCities = new Set<string>();
    /**
     * The add controls of the rows currently on screen. A plan change updates
     * them in place instead of re-running `render()`: rebuilding the list
     * removed the very button the student had just pressed, which threw
     * keyboard focus back to `<body>` on every add (A5).
     */
    const rows: { sync: () => void; invalidate: () => void; cancel: () => void }[] = [];

    let settleTimer: ReturnType<typeof setTimeout> | null = null;
    function cancelSettle(): void {
      if (settleTimer === null) return;
      clearTimeout(settleTimer);
      settleTimer = null;
    }
    /**
     * Defers work until typing stops. Two things wait on it: the `aria-live`
     * count — typing "matematikk" wrote ten counts into `#emner-status`, nine
     * of them for prefixes nobody searched (search-8) — and the `?q=`
     * writeback, which would otherwise rewrite the history entry per
     * keystroke. The result list itself stays synchronous.
     */
    function afterTyping(fn: () => void): void {
      cancelSettle();
      settleTimer = setTimeout(() => {
        settleTimer = null;
        fn();
      }, SETTLE_MS);
    }

    /** Immediate status write; supersedes anything `afterTyping` has queued. */
    function setStatus(text: string, voice: "hint" | "note"): void {
      if (!statusEl) return;
      cancelSettle();
      statusEl.className = `emner-status ${voice === "note" ? "np-note" : "np-hint"}`;
      statusEl.textContent = text;
    }

    /**
     * Keeps `?q=` in step with the field. Back from a course page used to
     * restore an empty catalog, and a page that arrived with `?q=` kept
     * advertising the old query in the address bar (search-4, astro-6); the
     * read side at the bottom of this setup already handled the rest.
     *
     * `history.state` is carried through, never replaced with `null`: Astro's
     * ClientRouter seeds every entry with `{index, scrollX, scrollY}` and its
     * popstate handler returns early on a null state, so nulling it here would
     * kill Back onto this page (app-1, CLAUDE.md's ClientRouter rule).
     */
    function syncQuery(raw: string): void {
      const target = raw === "" ? location.pathname : `?q=${encodeURIComponent(raw)}`;
      history.replaceState(history.state, "", target);
    }

    /**
     * DESIGN §7's pair, both halves. The accessible name starts with the
     * visible label so voice control matches what the student can read — the
     * old button said "Lagt til" and answered to "Fjern TDT4100 fra planen",
     * which is a WCAG 2.5.3 failure as well as a fourth spelling of one state
     * (copy-6).
     */
    function setAddState(button: HTMLButtonElement, code: string, sentence: string): void {
      const inPlan = store.hasCourse(code);
      const label = inPlan ? "I planen" : "Legg til i planen";
      button.setAttribute("aria-pressed", String(inPlan));
      button.textContent = label;
      button.setAttribute(
        "aria-label",
        sentence === "" ? `${label} — ${code}` : `${label} — ${code} · ${sentence}`,
      );
    }

    /**
     * U11: the clash verdict has to be available *before* the student
     * commits, but a verdict per visible row is 200 timetable fetches. So it
     * is computed lazily on first deliberate hover/focus of the row's add
     * button, and rendered into the row itself — writing it only into
     * `title`/`aria-label` meant a touch user, whose tap both triggers the
     * check and commits the add, never saw it at all (search-2).
     */
    function attachClashPreview(
      button: HTMLButtonElement,
      clashEl: HTMLElement,
      code: string,
      version: string,
      sync: () => void,
    ): { invalidate: () => void; cancel: () => void } {
      let checked = false;
      let generation = 0;
      let dwell: ReturnType<typeof setTimeout> | null = null;

      const cancel = (): void => {
        if (dwell === null) return;
        clearTimeout(dwell);
        dwell = null;
      };

      const check = async (): Promise<void> => {
        if (checked) return;
        checked = true;
        const gen = ++generation;
        const currentPlan = store.loadPlan();
        const verdict = await planClash(
          { code, version },
          currentPlan,
          clashSemester,
          undefined,
          currentPlan.program?.code ?? null,
        );
        // Superseded: the plan changed while this was in flight, so the
        // verdict is a diff against a plan that no longer exists. Writing it
        // anyway advertised "Ingen kollisjon i planen din" over a plan that
        // does collide, in the tooltip *and* the accessible name, until the
        // next completed check (search-3). Same guard as addCourse.ts.
        if (gen !== generation) return;
        const sentence = clashSentence(verdict, clashSemester);
        button.title = sentence;
        clashEl.textContent = sentence;
        clashEl.classList.toggle("is-clash", verdict.kind === "clash");
        sync();
      };

      // A dwell, not a bare `pointerenter`: `render()` rebuilds every row on
      // every keystroke, so a cursor left parked over the button column got a
      // boundary event from whichever new button landed under it — two
      // upstream NTNU calls per re-render for courses nobody chose to
      // inspect (search-7). Focus stays immediate: it is the keyboard
      // equivalent of a deliberate hover.
      button.addEventListener("pointerenter", () => {
        cancel();
        dwell = setTimeout(check, HOVER_DWELL_MS);
      });
      button.addEventListener("pointerleave", cancel);
      button.addEventListener("pointercancel", cancel);
      button.addEventListener("focus", check);

      // The verdict is a diff against the plan, so it expires the moment the
      // plan does. Dropping the cached answer is honest; recomputing 200 of
      // them eagerly is 200 timetable fetches.
      return {
        cancel,
        invalidate: () => {
          cancel();
          checked = false;
          generation++;
          button.title = "";
          clashEl.textContent = "";
          clashEl.classList.remove("is-clash");
        },
      };
    }

    /** The catalog narrowed to the selected city chips (all of them = no filter). */
    function scopedCourses(): CatalogRow[] {
      if (!index) return [];
      if (activeCities.size === 0) return index.courses;
      return index.courses.filter(([, , location]) =>
        cities(location).some((c) => activeCities.has(c)),
      );
    }

    function render(): void {
      if (!statusEl || !resultsEl || !searchInput) return;
      if (!index) return;
      const raw = searchInput.value.trim();
      const scoped = scopedCourses();

      // §3: no 200-row dump on an empty query — the page is a search mode,
      // not a browsable catalog. The chips still have to answer something,
      // though: the city filter used to live *below* this return, so a chip
      // latched `aria-pressed` and changed nothing on the page (astro-4).
      if (raw === "") {
        for (const row of rows) row.cancel();
        rows.length = 0;
        resultsEl.replaceChildren();
        const where = activeCities.size > 0 ? ` i ${[...activeCities].join(", ")}` : "";
        const noun = scoped.length === 1 ? "emne" : "emner";
        setStatus(`Skriv for å søke i ${scoped.length} ${noun}${where}.`, "hint");
        syncQuery(raw);
        return;
      }

      // Ranked, then capped — the other way round the cap was a blind cut
      // through catalog order, and "teknologi" dropped 42 rows of which 39
      // were Trondheim (search-1/astro-5).
      const ranked = searchCatalog(scoped, raw);

      for (const row of rows) row.cancel();
      resultsEl.replaceChildren();
      rows.length = 0;
      const shown = ranked.slice(0, RESULT_CAP);
      for (const [code, name, location, exams, version, offeredYears] of shown) {
        const row = document.createElement("li");
        row.className = "emner-row";

        const link = document.createElement("a");
        link.className = "emner-row-link";
        link.href = `/emne/${encodeURIComponent(code)}/`;

        const codeEl = document.createElement("span");
        codeEl.className = "emner-row-code";
        codeEl.textContent = code;

        const nameEl = document.createElement("span");
        nameEl.className = "emner-row-name";
        nameEl.textContent = name;

        link.append(codeEl, nameEl);

        const note = examNote(exams);
        if (note) {
          const noteEl = document.createElement("span");
          noteEl.className = "emner-row-exam";
          noteEl.textContent = note;
          link.append(noteEl);
        }

        if (location) {
          const locEl = document.createElement("span");
          locEl.className = "emner-row-location";
          locEl.textContent = location;
          link.append(locEl);
        }

        // C1: 703 of these rows come from last year's catalog only. Adding
        // one contributes zero blocks to this semester's week, so the row
        // says so — in the same words /emne/[code]/ uses.
        const stale = !offeredYears.includes(index.year);
        if (stale) {
          const lastYear = offeredYears[0];
          const staleEl = document.createElement("span");
          staleEl.className = "emner-row-stale";
          staleEl.textContent =
            lastYear === undefined
              ? `ikke undervist i ${index.year}`
              : `ikke undervist i ${index.year} · sist undervist ${lastYear}`;
          link.append(staleEl);
        }

        row.append(link);

        // No add control on a stale row. It used to be live, and pressing it
        // produced a planner claiming the whole plan had no teaching plus a
        // raw English API error in the course row (crawler-3). The dialog's
        // guard (addCourse.ts) already worked this way; the three add
        // affordances now agree.
        if (!stale) {
          const actions = document.createElement("span");
          actions.className = "emner-row-actions";

          const clashEl = document.createElement("p");
          clashEl.className = "np-hint emner-row-clash";

          const addBtn = document.createElement("button");
          addBtn.type = "button";
          addBtn.className = "np-btn emner-row-add";

          // I2: the row was write-only — the "+" mutated localStorage and
          // said nothing. The button reports the state now. It used to be
          // followed by a "se ukeplanen →" link; the topbar chip goes there.
          const sync = (): void => setAddState(addBtn, code, clashEl.textContent ?? "");
          sync();

          addBtn.addEventListener("click", () => {
            if (store.hasCourse(code)) {
              store.removeCourse(code);
            } else {
              store.addCourse({ code, name, version: version || "1" });
            }
            // `savePlan` dispatches synchronously, so `syncRows` has normally
            // already run by here; this keeps the button honest if it has not.
            sync();
          });

          const preview = attachClashPreview(addBtn, clashEl, code, version || "1", sync);
          rows.push({ sync, ...preview });

          actions.append(addBtn);
          row.append(actions, clashEl);
        }

        resultsEl.append(row);
      }

      if (ranked.length > RESULT_CAP) {
        const more = document.createElement("li");
        more.className = "np-hint emner-more";
        more.textContent = `${ranked.length - RESULT_CAP} flere treff — presiser søket.`;
        resultsEl.append(more);
      }

      afterTyping(() => {
        setStatus(
          ranked.length > RESULT_CAP
            ? `viser ${RESULT_CAP} av ${ranked.length} treff`
            : `${ranked.length} treff`,
          "note",
        );
        syncQuery(raw);
      });
    }

    /**
     * U15: the raw catalog strings are combinations ("Gjøvik, Trondheim"),
     * so one chip per string filtered with `includes` *excluded* courses
     * taught in more cities than the chip named. Facets are cities, and
     * selecting several means OR.
     */
    function renderFacets(): void {
      if (!facetsEl || !index) return;
      const all = new Set<string>();
      for (const [, , location] of index.courses) for (const city of cities(location)) all.add(city);
      const sorted = [...all].sort((a, b) => a.localeCompare(b, "nb"));

      facetsEl.replaceChildren();
      for (const city of sorted) {
        const chip = document.createElement("button");
        chip.type = "button";
        chip.className = "np-toggle np-toggle--text";
        chip.textContent = city;
        chip.setAttribute("aria-pressed", String(activeCities.has(city)));
        chip.addEventListener("click", () => {
          if (activeCities.has(city)) activeCities.delete(city);
          else activeCities.add(city);
          chip.setAttribute("aria-pressed", String(activeCities.has(city)));
          render();
        });
        facetsEl.append(chip);
      }
    }

    /**
     * Fetches the index. On failure the page keeps a way back: an explicit
     * "prøv igjen" action, plus a retry on the next keystroke — the previous
     * version left `index` undefined for the rest of the session.
     */
    async function loadIndex(): Promise<void> {
      if (index || loading || !statusEl) return;
      loading = true;
      setStatus("Henter emner …", "hint");
      try {
        const res = await fetch("/data/search-index.json");
        if (!res.ok) throw new Error(`${res.status}`);
        index = (await res.json()) as SearchIndex;
      } catch {
        setStatus("Klarte ikke å hente emnene.", "hint");
        const retry = document.createElement("button");
        retry.type = "button";
        retry.className = "np-btn emner-retry";
        retry.textContent = "prøv igjen";
        retry.addEventListener("click", () => {
          loadIndex();
        });
        statusEl.append(retry);
        return;
      } finally {
        loading = false;
      }
      renderFacets();
      render();
    }

    searchInput.addEventListener(
      "input",
      () => {
        if (!index) {
          loadIndex();
          return;
        }
        render();
      },
      { signal },
    );
    /** In-place refresh of the rows on screen — see `rows`. */
    function syncRows(): void {
      for (const row of rows) {
        row.invalidate();
        row.sync();
      }
    }

    signal.addEventListener("abort", store.onPlanChange(syncRows));
    signal.addEventListener("abort", () => {
      cancelSettle();
      for (const row of rows) row.cancel();
    });

    const params = new URLSearchParams(location.search);
    const initialQuery = params.get("q");
    if (initialQuery) searchInput.value = initialQuery;

    loadIndex();
  });
</script>
