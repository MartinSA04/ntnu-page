---
import programsData from "../../../data/programs.json";
import semestersData from "../../../data/semesters.json";
import Layout from "../../layouts/Layout.astro";
// Shared with the /studier/ listing links and the planner's back-link. The
// planner is a plain .ts island and cannot import from a .astro file, so the
// escaping rule lives in src/lib/ — see that file for why "/" is the only
// character that needs it.
import { codeToSegment } from "../../lib/programUrl.js";

export function getStaticPaths() {
  return programsData.programs.map((program) => ({
    params: { code: codeToSegment(program.code) },
    props: { program },
  }));
}

interface Props {
  program: (typeof programsData.programs)[number];
}

const { program } = Astro.props;
// Best-effort guess for the study-plan island's first fetch — it steps back
// on 404 and re-renders its chips from the response's publishedYears anyway.
const currentYear = semestersData.current?.year ?? new Date().getFullYear();
const defaultSemesterId = semestersData.current?.id ?? "";

const description = `${program.name} — studieplan, opptak og studiested ved NTNU.`;
---

<Layout title={`${program.name} — Semesterplan`} description={description} wide>
  <p class="np-kicker studie-kicker">{program.code}</p>
  <h1 class="studie-title">{program.name}</h1>
  <p class="studie-meta np-note">
    {program.studyLevel}
    {program.campuses.length > 0 && <span>· {program.campuses.join(", ")}</span>}
  </p>

  {program.departmentName && <p class="studie-department">{program.departmentName}</p>}
  {
    /* program.description is a crawler-supplied marketing string, duplicated
       on ~88% of programmes ("Datateknologi - master (5-årig) Datateknologi")
       — PRODUCT.md §12 already kills "program marketing prose as primary
       content", so it is deliberately not rendered here (U17c). */
  }

  <section
    class="studie-section"
    id="plan-section"
    data-program-code={program.code}
    data-program-name={program.name}
    data-guess-year={currentYear}
    data-default-semester={defaultSemesterId}
  >
    <h2 class="np-kicker">Studieplan</h2>
    <p class="np-kicker studie-kull-kicker" id="plan-years-kicker" hidden>Kull</p>
    <div class="studie-plan-years" id="plan-years"></div>
    <p class="studie-loading np-hint" data-role="status" aria-live="polite">henter studieplan …</p>
    <p class="np-hint studie-provenance" id="plan-provenance" hidden></p>
    <div data-role="body" hidden></div>
  </section>
</Layout>

<style>
  .studie-kicker {
    margin-bottom: var(--space-2);
  }
  .studie-title {
    margin-bottom: var(--space-2);
  }
  .studie-meta {
    margin-bottom: var(--space-4);
    display: flex;
    gap: var(--space-2);
  }
  .studie-department {
    font-size: var(--text-sm);
    color: var(--muted);
    margin-bottom: var(--space-3);
  }
  .studie-section {
    margin-bottom: var(--space-7);
  }
  .studie-section > .np-kicker {
    margin-bottom: var(--space-3);
  }
  .studie-kull-kicker {
    margin-bottom: var(--space-2);
  }
  .studie-plan-years {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }
  .studie-provenance {
    margin-bottom: var(--space-4);
  }

  /* Island content is built client-side; scoped styles need :global() to
     reach it (see the equivalent note in emne/[code].astro). */
  :global(.plan-years-row) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  :global(.plan-years-more) {
    margin-top: var(--space-2);
  }
  :global(.plan-years-more .plan-years-row) {
    margin-top: var(--space-2);
  }
  :global(.plan-period) {
    margin-bottom: var(--space-6);
  }
  :global(.plan-period-header) {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }
  :global(.plan-period-current) {
    color: var(--accent-ink);
  }
  /* "ditt semester" is a membership state — the Green-Means-Fits case, not
     a muted mono fragment (D9). */
  :global(.plan-period-badge) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--accent-ink);
    background: var(--accent-weak);
    padding: 0.15em 0.5em;
    border-radius: var(--radius-xs);
  }
  :global(.plan-period-subtotal) {
    color: var(--muted);
  }
  :global(.plan-use-as-mine) {
    margin-left: auto;
  }
  :global(.plan-gate-hint) {
    margin-bottom: var(--space-3);
  }
  :global(.plan-fallback-hint) {
    margin-bottom: var(--space-4);
  }
  :global(.plan-group) {
    margin-bottom: var(--space-4);
  }
  :global(.plan-group-name) {
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
  }
  :global(.plan-group-description) {
    margin: var(--space-1) 0 var(--space-2);
  }
  :global(.plan-course-row) {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--border);
  }
  :global(.plan-course-code) {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--accent-ink);
    text-decoration: none;
    flex-shrink: 0;
    width: 6em;
  }
  :global(.plan-course-code:hover) {
    text-decoration: underline;
  }
  :global(.plan-course-name) {
    font-size: var(--text-sm);
    flex: 1;
  }
  :global(.plan-course-credits) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted);
    flex-shrink: 0;
  }
  :global(.plan-waypoint) {
    margin-bottom: var(--space-2);
    background: var(--card-nested);
    border-radius: var(--radius-sm);
    padding: 0 var(--space-3);
  }
  :global(.plan-waypoint > summary) {
    padding: var(--space-2) 0;
  }
  :global(.plan-waypoint-body) {
    padding-bottom: var(--space-3);
  }
  :global(.plan-waypoint-description) {
    margin-bottom: var(--space-2);
  }
  :global(.plan-direction-name) {
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    margin-bottom: var(--space-2);
  }
  :global(.plan-empty) {
    margin-top: var(--space-2);
  }
</style>

<script>
  import { mountStudyPlan } from "../../components/site/studyPlan";
  import { onPage } from "../../lib/pageLifecycle.ts";

  // Per page-load, not per module: ClientRouter evaluates this module once,
  // so mounting at top level left the study plan empty after any in-site
  // navigation — including between two different programme pages, where the
  // stale module would also have kept the first programme's data.
  onPage(() => {
    const root = document.getElementById("plan-section");
    if (!root) return;
    mountStudyPlan(
      root.dataset.programCode ?? "",
      root.dataset.programName ?? "",
      Number(root.dataset.guessYear ?? "0"),
      root.dataset.defaultSemester ?? "",
    );
  });
</script>
