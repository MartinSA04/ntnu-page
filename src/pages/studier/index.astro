---
// /studier/ is scheduled for deletion (PRODUCT.md D11/§12 — its job is
// absorbed into /emner/), but it is the only route to /studier/[code]/
// anywhere in the codebase (REVIEW.md I3), so it stays alive until those
// pages have other entrances. Because it is going away, it is deliberately
// NOT redesigned here (REVIEW.md §10 rules out pagination/virtualisation/
// facet work on a page slated for deletion) — the only change is dropping
// the always-rendered 403-row wall in favour of a search-first list, which
// is a subtraction, not a redesign.
import programsData from "../../../data/programs.json";
import Layout from "../../layouts/Layout.astro";
import { codeToSegment } from "../../lib/programUrl.js";

const description = "Bla i NTNUs studieprogram etter navn, kode eller studienivå.";

const programs = programsData.programs
  .map((p) => ({ code: p.code, name: p.name, studyLevel: p.studyLevel ?? "" }))
  .sort((a, b) => a.name.localeCompare(b.name, "nb"));

const levels = [...new Set(programs.map((p) => p.studyLevel).filter(Boolean))].sort((a, b) =>
  a.localeCompare(b, "nb"),
);
---

<Layout title="Studier — Semesterplan" description={description} wide>
  <p class="np-kicker studier-kicker">Studier</p>
  <h1 class="studier-title">Studieprogram</h1>

  <div class="np-field studier-search">
    <input
      type="search"
      id="studier-search"
      name="q"
      placeholder="Søk etter studieprogram eller kode …"
      aria-label="Søk i studieprogram"
    />
  </div>

  <div class="studier-chips" role="group" aria-label="Filtrer på studienivå">
    {
      levels.map((level) => (
        <button type="button" class="np-toggle studier-chip" data-level={level} aria-pressed="false">
          {level}
        </button>
      ))
    }
  </div>

  <p class="np-hint studier-hint" id="studier-hint">
    Skriv for å søke i studieprogram, eller velg studienivå.
  </p>
  <p class="studier-status np-note" id="studier-status" aria-live="polite" hidden></p>

  <ul class="studier-results" id="studier-results" hidden>
    {
      programs.map((p) => (
        <li>
          <a
            class="studier-row"
            href={`/studier/${codeToSegment(p.code)}/`}
            data-name={p.name}
            data-code={p.code}
            data-level={p.studyLevel}
          >
            <span class="studier-row-name">{p.name}</span>
            <span class="studier-row-level np-note">{p.studyLevel}</span>
            <span class="studier-row-code np-data">{p.code}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>

<style>
  .studier-kicker {
    margin-bottom: var(--space-2);
  }
  .studier-title {
    margin-bottom: var(--space-5);
  }
  .studier-search {
    margin-bottom: var(--space-4);
    max-width: var(--measure);
  }
  .studier-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }
  .studier-hint,
  .studier-status {
    margin-bottom: var(--space-4);
  }
  .studier-results {
    list-style: none;
  }
  /* `display` only while shown. A bare `display: flex` outranks the UA's
     `[hidden] { display: none }`, which left I3's search-first subtraction
     inert: the attribute was set, the script believed the list was hidden,
     and all 403 rows rendered anyway (21 000 px of page on first paint). The
     rows already carry their own `[hidden]` rule for the same reason. */
  .studier-results:not([hidden]) {
    display: flex;
    flex-direction: column;
  }
  .studier-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-2);
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: var(--fg);
    transition: color var(--dur-fast) var(--ease);
  }
  .studier-row:hover {
    color: var(--accent-ink);
  }
  .studier-row-name {
    font-size: var(--text-base);
  }
  .studier-row-level {
    margin-left: auto;
    flex-shrink: 0;
  }
  .studier-row-code {
    flex-shrink: 0;
    width: 5em;
    text-align: right;
  }
  .studier-row[hidden] {
    display: none;
  }
</style>

<script>
  import { onPage } from "../../lib/pageLifecycle.ts";

  function fold(value: string): string {
    return value
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLowerCase();
  }

  // Per page-load, not per module: ClientRouter evaluates this module once,
  // so wiring at top level left the filter dead after any in-site navigation.
  onPage((signal) => {
  const searchInput = document.getElementById("studier-search") as HTMLInputElement | null;
  const statusEl = document.getElementById("studier-status") as HTMLParagraphElement | null;
  const hintEl = document.getElementById("studier-hint") as HTMLParagraphElement | null;
  const resultsEl = document.getElementById("studier-results") as HTMLUListElement | null;
  if (!searchInput || !statusEl || !hintEl || !resultsEl) return;
  const rows = [...document.querySelectorAll<HTMLAnchorElement>(".studier-row")];
  const chips = [...document.querySelectorAll<HTMLButtonElement>(".studier-chip")];

  let activeLevel: string | null = null;

  // I3: results render only once the visitor has started a search — a
  // level chip alone counts (it is a search too), an empty field does not.
  // This is the whole fix; the 403-row wall behind it is unchanged.
  function render(): void {
    if (!searchInput || !statusEl || !hintEl || !resultsEl) return;
    const query = fold(searchInput.value.trim());
    const hasQuery = query.length > 0 || activeLevel !== null;

    hintEl.hidden = hasQuery;
    statusEl.hidden = !hasQuery;
    resultsEl.hidden = !hasQuery;
    if (!hasQuery) return;

    let shown = 0;
    for (const row of rows) {
      const matchesLevel = !activeLevel || row.dataset.level === activeLevel;
      const matchesQuery =
        !query ||
        fold(row.dataset.name ?? "").includes(query) ||
        fold(row.dataset.code ?? "").includes(query);
      const visible = matchesLevel && matchesQuery;
      row.hidden = !visible;
      if (visible) shown++;
    }
    statusEl.textContent = `${shown} studieprogram`;
  }

  for (const chip of chips) {
    chip.addEventListener("click", () => {
      const level = chip.dataset.level ?? null;
      const next = activeLevel === level ? null : level;
      activeLevel = next;
      for (const other of chips) {
        other.setAttribute("aria-pressed", String(other === chip && next !== null));
      }
      render();
    });
  }

  searchInput.addEventListener("input", render, { signal });
  });
</script>
