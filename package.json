{
  "name": "ntnu-page",
  "private": true,
  "version": "0.2.0",
  "description": "Uoffisiell timeplan for NTNU: studieprogram og kull til ukeplan, uten innlogging",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node crawler/ensure-data.mjs",
    "build": "astro build",
    "preview": "wrangler dev",
    "crawl": "node crawler/crawl.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "astro check && tsc -p worker/tsconfig.json && tsc -p tsconfig.test.json",
    "lint": "biome check .",
    "fmt": "biome check --write .",
    "e2e:record": "E2E_RECORD=1 playwright test",
    "e2e:live": "E2E_LIVE=1 playwright test"
  },
  "dependencies": {
    "astro": "^6.3.7",
    "ntnu-api": "^0.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@biomejs/biome": "^2.5.5",
    "@cloudflare/workers-types": "^5.20260721.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.0.0"
  }
}
