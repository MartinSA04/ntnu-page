{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ntnu-page",
  "main": "worker/src/server.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Static Astro build.
  //
  // `run_worker_first` is load-bearing, not an optimisation. By default the
  // asset server answers FIRST and the worker never runs for any path that
  // matches a built file — and `not_found_handling` answers misses with
  // 404.html the same way. That silently disabled `withSecurityHeaders` on
  // every HTML response (sec-3), which is the one worker behaviour left on the
  // document path now that the lowercase-course-code redirect is deleted with
  // its pages. Routing document requests through the worker restores it; the
  // negations keep the heavy, immutable, content-hashed files on the
  // direct-serve path where they belong.
  //
  // Cache-Control comes from `public/_headers` (copied verbatim into dist/ by
  // the build, read from the assets directory by the asset server) and
  // survives the worker path untouched, since ASSETS.fetch returns the asset
  // server's own response and the worker only adds security headers. Without
  // it everything — including content-hashed /_astro/* — is served
  // `max-age=0, must-revalidate`, i.e. a 304 round-trip per asset per
  // navigation (perf-2).
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/*", "!/_astro/*", "!/data/*"]
  },
  // ONE KV namespace, and it caches NTNU's answers rather than anything about a
  // student — the worker still stores nothing about one (PRODUCT mandate 11).
  // The SYNC namespace and its `local-sync-dev` placeholder went with the
  // account on 2026-08-18, along with `release.yml`'s precheck for that
  // placeholder, so there is no fake id that could reach production. Losing
  // this binding is not a correctness bug: `TieredCache` degrades to
  // memory-only, which is right and merely colder.
  //
  // TWO THINGS ABOUT THIS ENTRY ARE EASY TO GET WRONG.
  //
  // The BINDING is `CACHE` because that is what `server.ts` reads off `env`.
  // `wrangler kv namespace create` prints a snippet naming the binding after
  // the TITLE — `ntnu_page_CACHE` here — and pasting that verbatim leaves the
  // worker permanently memory-only with nothing in any log to say so.
  //
  // The TITLE is `ntnu-page-CACHE` rather than `CACHE` because titles are
  // account-wide and ntnu-mcp already holds `CACHE`. That is not merely a name
  // clash: both workers prefix their keys `v1:` and both spell them
  // `JSON.stringify(["details", CODE, year, …])`, so a shared namespace is two
  // services reading each other's payloads the moment one of them adds an
  // argument and the arities stop differing by accident. Keep them apart.
  "kv_namespaces": [{ "binding": "CACHE", "id": "890cc00c1e1a4b94a7d18b64c04aee3f" }],
  // The custom domain. Wrangler creates the DNS record and the certificate on
  // deploy, provided martinsundal.no is a zone in the same Cloudflare account.
  // This host is also `site` in astro.config.mjs and the `Sitemap:` line in
  // public/robots.txt — all three name it, and they move together.
  "routes": [{ "pattern": "ntnu.martinsundal.no", "custom_domain": true }]
}
