{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ntnu-page",
  "main": "worker/src/server.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Static Astro build. Requests matching a built asset are served directly;
  // everything else (i.e. /api/*) invokes the worker, which falls back to
  // ASSETS.fetch for unknown paths so 404.html applies.
  //
  // Cache-Control for those direct hits comes from `public/_headers` (copied
  // verbatim into dist/ by the build, read from the assets directory by the
  // asset server). Without it everything — including content-hashed
  // /_astro/* — is served `max-age=0, must-revalidate`, i.e. a 304 round-trip
  // per asset per navigation (perf-2).
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  }
  // Not connected to Cloudflare yet. When wiring it up:
  // 1. KV cache (worker degrades to memory-only cache without it):
  //      npx wrangler kv namespace create CACHE
  //    then add:
  //      "kv_namespaces": [{ "binding": "CACHE", "id": "<id>" }],
  // 2. Custom domain:
  //      "routes": [{ "pattern": "ntnu.martinsundal.no", "custom_domain": true }],
}
